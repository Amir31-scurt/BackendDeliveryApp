<% if (typeof errors !== 'undefined' && errors.length > 0) { %>
  <div class="fixed top-4 right-4 z-50 animate-bounce">
    <% errors.forEach(function(error) { %>
      <div class="bg-red-100 border-l-4 border-red-500 text-red-700 p-4 mb-2 shadow-lg rounded" role="alert">
        <div class="flex items-center">
          <div class="py-1"><svg class="fill-current h-6 w-6 text-red-500 mr-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"><path d="M2.93 17.07A10 10 0 1 1 17.07 2.93 10 10 0 0 1 2.93 17.07zm12.73-1.41A8 8 0 1 0 4.34 4.34a8 8 0 0 0 11.32 11.32zM9 11V9h2v6H9v-4zm0-6h2v2H9V5z"/></svg></div>
          <div>
            <p class="font-bold">Erreur</p>
            <p class="text-sm"><%= error.msg || error.message || error %></p>
          </div>
        </div>
      </div>
    <% }); %>
  </div>
<% } %>

<% if (success_msg && success_msg.length > 0) { %>
  <div class="fixed top-4 right-4 z-50 animate-fade-in-down">
    <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-4 mb-2 shadow-lg rounded" role="alert">
      <div class="flex items-center">
        <div class="py-1"><svg class="fill-current h-6 w-6 text-green-500 mr-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"><path d="M2.93 17.07A10 10 0 1 1 17.07 2.93 10 10 0 0 1 2.93 17.07zm12.73-1.41A8 8 0 1 0 4.34 4.34a8 8 0 0 0 11.32 11.32zM9 11V9h2v6H9v-4zm0-6h2v2H9V5z"/></svg></div>
        <div>
          <p class="font-bold">Succès</p>
          <p class="text-sm"><%= success_msg %></p>
        </div>
      </div>
    </div>
  </div>
<% } %>

<% if (error_msg && error_msg.length > 0) { %>
  <div class="fixed top-4 right-4 z-50 animate-bounce">
    <div class="bg-red-100 border-l-4 border-red-500 text-red-700 p-4 mb-2 shadow-lg rounded" role="alert">
      <div class="flex items-center">
        <div class="py-1"><svg class="fill-current h-6 w-6 text-red-500 mr-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"><path d="M2.93 17.07A10 10 0 1 1 17.07 2.93 10 10 0 0 1 2.93 17.07zm12.73-1.41A8 8 0 1 0 4.34 4.34a8 8 0 0 0 11.32 11.32zM9 11V9h2v6H9v-4zm0-6h2v2H9V5z"/></svg></div>
        <div>
          <p class="font-bold">Erreur</p>
          <p class="text-sm"><%= error_msg %></p>
        </div>
      </div>
    </div>
  </div>
<% } %>

<% if (error && error.length > 0) { %>
  <div class="fixed top-4 right-4 z-50 animate-bounce">
    <div class="bg-red-100 border-l-4 border-red-500 text-red-700 p-4 mb-2 shadow-lg rounded" role="alert">
      <div class="flex items-center">
        <div class="py-1"><svg class="fill-current h-6 w-6 text-red-500 mr-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"><path d="M2.93 17.07A10 10 0 1 1 17.07 2.93 10 10 0 0 1 2.93 17.07zm12.73-1.41A8 8 0 1 0 4.34 4.34a8 8 0 0 0 11.32 11.32zM9 11V9h2v6H9v-4zm0-6h2v2H9V5z"/></svg></div>
        <div>
          <p class="font-bold">Erreur</p>
          <p class="text-sm"><%= error %></p>
        </div>
      </div>
    </div>
  </div>
<% } %>
