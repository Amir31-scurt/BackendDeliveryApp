<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>État du service | Gourmet d'amour</title>
    <link rel="icon" href="/images/logo.png" type="image/png">
    <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Poppins:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <style>
        :root {
            --primary:    #DB607E;
            --secondary:  #ABD27E;
            --dark:       #2c2c2c;
            --bg:         #f9f5f0;
            --card:       #ffffff;
            --green:      #22c55e;
            --amber:      #f59e0b;
            --red:        #ef4444;
            --muted:      #888;
            --border:     rgba(219,96,126,0.13);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Poppins', sans-serif;
            background: var(--bg);
            color: var(--dark);
            min-height: 100vh;
            position: relative;
        }

        /* Subtle grid */
        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background-image:
                linear-gradient(rgba(219,96,126,0.035) 1px, transparent 1px),
                linear-gradient(90deg, rgba(219,96,126,0.035) 1px, transparent 1px);
            background-size: 44px 44px;
            pointer-events: none;
            z-index: 0;
        }

        /* Top gradient accent bar */
        .accent-bar {
            height: 4px;
            background: linear-gradient(to right, var(--primary), var(--secondary), var(--primary));
            background-size: 200% auto;
            animation: barShimmer 4s linear infinite;
        }
        @keyframes barShimmer {
            from { background-position: 0% center; }
            to   { background-position: 200% center; }
        }

        /* ── Nav ── */
        nav {
            position: relative;
            z-index: 10;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 18px 48px;
            background: rgba(255,255,255,0.85);
            backdrop-filter: blur(14px);
            border-bottom: 1px solid var(--border);
            box-shadow: 0 2px 20px rgba(0,0,0,0.05);
        }

        .nav-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            font-family: 'Playfair Display', serif;
            font-size: 20px;
            font-weight: 700;
            color: var(--primary);
        }
        .nav-logo img { height: 40px; }

        .nav-right {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .refresh-btn {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 9px 20px;
            border-radius: 50px;
            background: linear-gradient(135deg, var(--primary), #e85a7f);
            color: white;
            font-family: 'Poppins', sans-serif;
            font-size: 0.85rem;
            font-weight: 600;
            border: none;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.25s ease;
            box-shadow: 0 4px 14px rgba(219,96,126,0.3);
        }
        .refresh-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 22px rgba(219,96,126,0.45);
        }
        .refresh-btn i { transition: transform 0.4s ease; }
        .refresh-btn:hover i { transform: rotate(180deg); }

        .back-btn {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 9px 18px;
            border-radius: 50px;
            background: transparent;
            color: var(--dark);
            font-family: 'Poppins', sans-serif;
            font-size: 0.85rem;
            font-weight: 500;
            border: 1.5px solid rgba(44,44,44,0.12);
            text-decoration: none;
            transition: all 0.25s ease;
        }
        .back-btn:hover {
            border-color: var(--primary);
            color: var(--primary);
        }

        /* ── Page content ── */
        .page {
            position: relative;
            z-index: 1;
            max-width: 900px;
            margin: 0 auto;
            padding: 48px 24px 80px;
        }

        /* Header row */
        .page-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 36px;
            flex-wrap: wrap;
            gap: 16px;
        }

        .page-title {
            font-family: 'Playfair Display', serif;
            font-size: 2.2rem;
            font-weight: 700;
            color: var(--dark);
            line-height: 1.2;
        }

        .page-subtitle {
            font-size: 0.9rem;
            color: var(--muted);
            margin-top: 4px;
        }

        /* Timestamp */
        .timestamp {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.78rem;
            color: var(--muted);
            background: rgba(44,44,44,0.05);
            padding: 6px 14px;
            border-radius: 20px;
            border: 1px solid rgba(0,0,0,0.07);
        }

        /* ── Overall status banner ── */
        .status-banner {
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 20px 28px;
            border-radius: 20px;
            margin-bottom: 32px;
            animation: bannerIn 0.6s cubic-bezier(0.34,1.56,0.64,1) forwards;
            opacity: 0;
            transform: translateY(20px);
        }
        @keyframes bannerIn {
            to { opacity: 1; transform: translateY(0); }
        }

        .status-banner.ok {
            background: linear-gradient(135deg, rgba(34,197,94,0.1), rgba(171,210,126,0.12));
            border: 1.5px solid rgba(34,197,94,0.25);
        }
        .status-banner.degraded {
            background: linear-gradient(135deg, rgba(245,158,11,0.1), rgba(245,158,11,0.05));
            border: 1.5px solid rgba(245,158,11,0.3);
        }
        .status-banner.down {
            background: linear-gradient(135deg, rgba(239,68,68,0.1), rgba(219,96,126,0.08));
            border: 1.5px solid rgba(239,68,68,0.3);
        }

        .banner-icon {
            width: 52px;
            height: 52px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            flex-shrink: 0;
        }
        .ok .banner-icon    { background: rgba(34,197,94,0.15);  color: var(--green); }
        .degraded .banner-icon { background: rgba(245,158,11,0.15); color: var(--amber); }
        .down .banner-icon  { background: rgba(239,68,68,0.15);  color: var(--red); }

        .banner-text h2 {
            font-family: 'Playfair Display', serif;
            font-size: 1.25rem;
            font-weight: 700;
            margin-bottom: 3px;
        }
        .ok .banner-text h2    { color: #166534; }
        .degraded .banner-text h2 { color: #92400e; }
        .down .banner-text h2  { color: #991b1b; }

        .banner-text p {
            font-size: 0.88rem;
            color: var(--muted);
        }

        .banner-pulse {
            margin-left: auto;
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.82rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .pulse-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            animation: pulseDot 1.4s ease-in-out infinite;
        }
        .ok .pulse-dot    { background: var(--green); box-shadow: 0 0 0 0 rgba(34,197,94,0.4); }
        .degraded .pulse-dot { background: var(--amber); box-shadow: 0 0 0 0 rgba(245,158,11,0.4); }
        .down .pulse-dot  { background: var(--red);   box-shadow: 0 0 0 0 rgba(239,68,68,0.4); }

        @keyframes pulseDot {
            0%   { transform: scale(1); box-shadow: 0 0 0 0 rgba(34,197,94,0.4); }
            70%  { transform: scale(1.05); box-shadow: 0 0 0 8px rgba(34,197,94,0); }
            100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(34,197,94,0); }
        }

        /* ── Metrics grid ── */
        .metrics-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
            gap: 18px;
            margin-bottom: 28px;
        }

        .metric-card {
            background: var(--card);
            border-radius: 20px;
            padding: 24px 22px;
            border: 1px solid var(--border);
            box-shadow: 0 4px 20px rgba(0,0,0,0.05);
            transition: all 0.3s ease;
            animation: cardIn 0.6s cubic-bezier(0.34,1.56,0.64,1) both;
            position: relative;
            overflow: hidden;
        }
        .metric-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 3px;
            background: linear-gradient(to right, var(--primary), var(--secondary));
            opacity: 0;
            transition: opacity 0.3s ease;
        }
        .metric-card:hover { transform: translateY(-4px); box-shadow: 0 12px 36px rgba(219,96,126,0.12); }
        .metric-card:hover::before { opacity: 1; }

        @keyframes cardIn {
            from { opacity: 0; transform: translateY(20px) scale(0.97); }
            to   { opacity: 1; transform: translateY(0) scale(1); }
        }
        .metric-card:nth-child(1) { animation-delay: 0.05s; }
        .metric-card:nth-child(2) { animation-delay: 0.10s; }
        .metric-card:nth-child(3) { animation-delay: 0.15s; }
        .metric-card:nth-child(4) { animation-delay: 0.20s; }

        .metric-icon {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            background: linear-gradient(135deg, rgba(219,96,126,0.12), rgba(171,210,126,0.12));
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            color: var(--primary);
            margin-bottom: 14px;
        }

        .metric-label {
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 0.8px;
            margin-bottom: 6px;
        }

        .metric-value {
            font-family: 'JetBrains Mono', monospace;
            font-size: 1.5rem;
            font-weight: 500;
            color: var(--dark);
            line-height: 1.2;
        }

        .metric-sub {
            font-size: 0.78rem;
            color: var(--muted);
            margin-top: 4px;
        }

        /* ── Services checklist ── */
        .section-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.35rem;
            font-weight: 700;
            color: var(--dark);
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .section-title i {
            font-size: 1rem;
            color: var(--primary);
        }

        .services-list {
            background: var(--card);
            border-radius: 20px;
            border: 1px solid var(--border);
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0,0,0,0.05);
            margin-bottom: 28px;
        }

        .service-row {
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 18px 24px;
            border-bottom: 1px solid rgba(0,0,0,0.05);
            transition: background 0.2s ease;
            animation: cardIn 0.5s ease both;
        }
        .service-row:last-child { border-bottom: none; }
        .service-row:hover { background: rgba(219,96,126,0.03); }

        .service-icon {
            width: 38px;
            height: 38px;
            border-radius: 11px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            flex-shrink: 0;
        }

        .service-name {
            flex: 1;
            font-weight: 500;
            font-size: 0.95rem;
        }

        .service-desc {
            font-size: 0.8rem;
            color: var(--muted);
            margin-top: 2px;
        }

        .service-latency {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.8rem;
            color: var(--muted);
        }

        .badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.78rem;
            font-weight: 600;
            flex-shrink: 0;
        }
        .badge-ok       { background: rgba(34,197,94,0.1);  color: #166534; border: 1px solid rgba(34,197,94,0.2); }
        .badge-warn     { background: rgba(245,158,11,0.1); color: #92400e; border: 1px solid rgba(245,158,11,0.25); }
        .badge-error    { background: rgba(239,68,68,0.1);  color: #991b1b; border: 1px solid rgba(239,68,68,0.2); }

        /* ── Footer strip ── */
        .footer-strip {
            text-align: center;
            font-size: 0.8rem;
            color: var(--muted);
            margin-top: 40px;
            padding-top: 20px;
            border-top: 1px solid rgba(0,0,0,0.07);
        }
        .footer-strip a { color: var(--primary); text-decoration: none; }

        @media (max-width: 600px) {
            nav { padding: 14px 20px; }
            .page { padding: 28px 16px 60px; }
            .page-title { font-size: 1.7rem; }
            .metrics-grid { grid-template-columns: 1fr 1fr; }
            .status-banner { flex-wrap: wrap; }
            .banner-pulse { margin-left: 0; }
        }
    </style>
</head>

<body>
    <div class="accent-bar"></div>

    <nav>
        <a href="/" class="nav-logo">
            <img src="/images/logo.png" alt="Gourmet d'amour">
            Gourmet d'amour
        </a>
        <div class="nav-right">
            <a href="/" class="back-btn"><i class="fas fa-arrow-left"></i> Accueil</a>
            <button class="refresh-btn" onclick="location.reload()">
                <i class="fas fa-sync-alt"></i> Actualiser
            </button>
        </div>
    </nav>

    <div class="page">

        <!-- Header -->
        <div class="page-header">
            <div>
                <h1 class="page-title">État du service</h1>
                <div class="page-subtitle">Surveillance en temps réel de l'infrastructure</div>
            </div>
            <div class="timestamp" id="checkedAt">Vérification…</div>
        </div>

        <!-- Overall status banner -->
        <div class="status-banner ok" id="statusBanner">
            <div class="banner-icon"><i class="fas fa-check-circle"></i></div>
            <div class="banner-text">
                <h2>Tous les systèmes opérationnels</h2>
                <p>L'ensemble des services Gourmet d'amour fonctionnent normalement.</p>
            </div>
            <div class="banner-pulse">
                <div class="pulse-dot"></div>
                En ligne
            </div>
        </div>

        <!-- Metric cards -->
        <div class="metrics-grid">
            <div class="metric-card">
                <div class="metric-icon"><i class="fas fa-heartbeat"></i></div>
                <div class="metric-label">Statut</div>
                <div class="metric-value" style="color:var(--green)" id="metricStatus">OK</div>
                <div class="metric-sub">Réponse du serveur</div>
            </div>
            <div class="metric-card">
                <div class="metric-icon"><i class="fas fa-clock"></i></div>
                <div class="metric-label">Uptime</div>
                <div class="metric-value" id="metricUptime">—</div>
                <div class="metric-sub" id="metricUptimeSub">Depuis le dernier redémarrage</div>
            </div>
            <div class="metric-card">
                <div class="metric-icon"><i class="fas fa-tachometer-alt"></i></div>
                <div class="metric-label">Latence</div>
                <div class="metric-value" id="metricLatency">—</div>
                <div class="metric-sub">Temps de réponse /health</div>
            </div>
            <div class="metric-card">
                <div class="metric-icon"><i class="fas fa-calendar-check"></i></div>
                <div class="metric-label">Heure serveur</div>
                <div class="metric-value" id="metricTime" style="font-size:1.05rem">—</div>
                <div class="metric-sub" id="metricDate">—</div>
            </div>
        </div>

        <!-- Services -->
        <div class="section-title"><i class="fas fa-layer-group"></i> Services</div>
        <div class="services-list" id="servicesList">

            <div class="service-row" style="animation-delay:0.05s">
                <div class="service-icon" style="background:rgba(219,96,126,0.1);color:var(--primary)">
                    <i class="fas fa-server"></i>
                </div>
                <div>
                    <div class="service-name">Serveur Express</div>
                    <div class="service-desc">API REST + GraphQL + panneau admin</div>
                </div>
                <span class="badge badge-ok"><i class="fas fa-circle" style="font-size:6px"></i> Opérationnel</span>
            </div>

            <div class="service-row" style="animation-delay:0.1s" id="svcGraphQL">
                <div class="service-icon" style="background:rgba(171,210,126,0.15);color:#5a9a3e">
                    <i class="fas fa-project-diagram"></i>
                </div>
                <div>
                    <div class="service-name">GraphQL API</div>
                    <div class="service-desc">Apollo Server — /api/graphql</div>
                </div>
                <span class="badge badge-ok"><i class="fas fa-circle" style="font-size:6px"></i> Opérationnel</span>
            </div>

            <div class="service-row" style="animation-delay:0.15s" id="svcDB">
                <div class="service-icon" style="background:rgba(99,102,241,0.1);color:#6366f1">
                    <i class="fas fa-database"></i>
                </div>
                <div>
                    <div class="service-name">Base de données</div>
                    <div class="service-desc">PostgreSQL via Supabase</div>
                </div>
                <span class="badge" id="svcDBBadge"><i class="fas fa-circle" style="font-size:6px"></i> Vérification…</span>
            </div>

            <div class="service-row" style="animation-delay:0.2s">
                <div class="service-icon" style="background:rgba(245,158,11,0.1);color:var(--amber)">
                    <i class="fas fa-file-upload"></i>
                </div>
                <div>
                    <div class="service-name">Stockage fichiers</div>
                    <div class="service-desc">Upload images restaurants & profils</div>
                </div>
                <span class="badge badge-ok"><i class="fas fa-circle" style="font-size:6px"></i> Opérationnel</span>
            </div>

            <div class="service-row" style="animation-delay:0.25s">
                <div class="service-icon" style="background:rgba(34,197,94,0.1);color:var(--green)">
                    <i class="fas fa-mobile-alt"></i>
                </div>
                <div>
                    <div class="service-name">Notifications Push</div>
                    <div class="service-desc">Expo Push Token — /api/push-token</div>
                </div>
                <span class="badge badge-ok"><i class="fas fa-circle" style="font-size:6px"></i> Opérationnel</span>
            </div>

            <div class="service-row" style="animation-delay:0.3s">
                <div class="service-icon" style="background:rgba(219,96,126,0.1);color:var(--primary)">
                    <i class="fas fa-credit-card"></i>
                </div>
                <div>
                    <div class="service-name">Paiements Wave</div>
                    <div class="service-desc">Wave Money / Orange Money</div>
                </div>
                <span class="badge badge-ok"><i class="fas fa-circle" style="font-size:6px"></i> Opérationnel</span>
            </div>

        </div>

        <!-- Footer -->
        <div class="footer-strip">
            <p>© 2025 Gourmet d'amour · Liberté 6, Dakar, Sénégal · <a href="/">Accueil</a> · <a href="/privacy">Confidentialité</a></p>
        </div>
    </div>

    <script>
        // ── Format seconds → human readable uptime ──────────────────────────────
        function formatUptime(seconds) {
            const d = Math.floor(seconds / 86400);
            const h = Math.floor((seconds % 86400) / 3600);
            const m = Math.floor((seconds % 3600) / 60);
            const s = Math.floor(seconds % 60);
            const parts = [];
            if (d) parts.push(d + 'j');
            if (h) parts.push(h + 'h');
            if (m) parts.push(m + 'min');
            if (!d) parts.push(s + 's');
            return parts.join(' ');
        }

        // ── Fetch /api/health and populate page ──────────────────────────────────
        async function fetchHealth() {
            const t0 = performance.now();
            try {
                const res  = await fetch('/api/health', { headers: { 'Accept': 'application/json' } });
                const latency = Math.round(performance.now() - t0);
                const data = await res.json();

                // Timestamp
                const now = new Date(data.timestamp || Date.now());
                document.getElementById('checkedAt').textContent =
                    'Vérifié à ' + now.toLocaleTimeString('fr-FR');
                document.getElementById('metricTime').textContent =
                    now.toLocaleTimeString('fr-FR');
                document.getElementById('metricDate').textContent =
                    now.toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long' });

                // Uptime
                if (data.uptime != null) {
                    document.getElementById('metricUptime').textContent = formatUptime(data.uptime);
                }

                // Latency
                const latEl = document.getElementById('metricLatency');
                latEl.textContent = latency + ' ms';
                latEl.style.color = latency < 100 ? 'var(--green)' : latency < 400 ? 'var(--amber)' : 'var(--red)';

            } catch (e) {
                // Server unreachable
                document.getElementById('metricStatus').textContent = 'ERREUR';
                document.getElementById('metricStatus').style.color = 'var(--red)';
                document.getElementById('metricLatency').textContent = '—';

                const banner = document.getElementById('statusBanner');
                banner.className = 'status-banner down';
                banner.innerHTML = `
                    <div class="banner-icon"><i class="fas fa-times-circle"></i></div>
                    <div class="banner-text">
                        <h2>Service indisponible</h2>
                        <p>Impossible de joindre l'API. Vérifiez votre connexion ou contactez le support.</p>
                    </div>
                    <div class="banner-pulse">
                        <div class="pulse-dot"></div>
                        Hors ligne
                    </div>`;

                document.getElementById('checkedAt').textContent = 'Échec à ' + new Date().toLocaleTimeString('fr-FR');
            }
        }

        // ── Probe DB via a lightweight HEAD to /health ───────────────────────────
        async function probeDB() {
            const badge = document.getElementById('svcDBBadge');
            try {
                const t0  = performance.now();
                const res = await fetch('/api/health', { headers: { 'Accept': 'application/json' } });
                const ms  = Math.round(performance.now() - t0);
                const ok  = res.ok;
                badge.className = 'badge ' + (ok ? 'badge-ok' : 'badge-error');
                badge.innerHTML = `<i class="fas fa-circle" style="font-size:6px"></i> ${ok ? 'Opérationnel' : 'Dégradé'}`;
                // Append latency next to DB row
                const latEl = document.createElement('span');
                latEl.className = 'service-latency';
                latEl.textContent = ms + ' ms';
                badge.parentElement.insertBefore(latEl, badge);
            } catch {
                badge.className = 'badge badge-error';
                badge.innerHTML = '<i class="fas fa-circle" style="font-size:6px"></i> Inaccessible';
            }
        }

        // Run on load
        fetchHealth();
        probeDB();

        // Auto-refresh every 30 s
        setInterval(() => { fetchHealth(); probeDB(); }, 30000);

        // Show countdown to next refresh
        let secs = 30;
        const timeEl = document.getElementById('checkedAt');
        setInterval(() => {
            secs--;
            if (secs <= 0) secs = 30;
        }, 1000);
    </script>
</body>
