<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Paiement non abouti | Gourmet d'amour</title>
  <link rel="icon" href="/images/logo.png" type="image/png">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      font-family: 'Poppins', sans-serif;
      background: #0f1015;
      color: #f3f4f6;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }
    .card {
      background: #171922;
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 20px;
      padding: 36px 28px;
      max-width: 420px;
      width: 100%;
      text-align: center;
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.45);
    }
    .icon-container {
      width: 72px;
      height: 72px;
      border-radius: 50%;
      background: rgba(239, 68, 68, 0.12);
      border: 2px solid rgba(239, 68, 68, 0.35);
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 20px;
      color: #ef4444;
    }
    .icon-container svg {
      width: 34px;
      height: 34px;
    }
    h1 {
      font-size: 22px;
      font-weight: 700;
      color: #ffffff;
      margin-bottom: 10px;
    }
    p {
      font-size: 14px;
      color: #9ca3af;
      line-height: 1.6;
      margin-bottom: 24px;
    }
    .order-tag {
      display: inline-block;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 8px;
      padding: 5px 12px;
      font-size: 12px;
      color: #d1d5db;
      margin-bottom: 20px;
    }
    .btn {
      display: inline-block;
      width: 100%;
      padding: 14px 20px;
      background: #db607e;
      color: #ffffff;
      border-radius: 12px;
      text-decoration: none;
      font-weight: 600;
      font-size: 15px;
      border: none;
      cursor: pointer;
      transition: opacity 0.2s ease;
    }
    .btn:hover {
      opacity: 0.92;
    }
    .btn:active {
      transform: scale(0.99);
    }
    .redirect-note {
      font-size: 12px;
      color: #6b7280;
      margin-top: 16px;
    }
  </style>
</head>
<body>

  <div class="card">
    <div class="icon-container">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </div>

    <h1>Paiement non abouti</h1>
    <p>
      Le paiement Wave a été annulé ou n'a pas pu être validé. Aucun montant n'a été débité.
    </p>

    <% if (orderId) { %>
      <div class="order-tag">Commande #<%= orderId %></div>
    <% } %>

    <a id="btnApp" href="gourmetdamour://payment/error<%= orderId ? '?orderId=' + encodeURIComponent(orderId) : '' %>" class="btn">
      Retourner à l'application
    </a>

    <div class="redirect-note" id="redirectMsg">
      Redirection vers l'application en cours...
    </div>
  </div>

  <script>
    (function () {
      var orderId = "<%= orderId || '' %>";
      var query = orderId ? "?orderId=" + encodeURIComponent(orderId) : "";
      var isAndroid = /android/i.test(navigator.userAgent);
      
      // Standard scheme used by iOS and default linking
      var customSchemeUrl = "gourmetdamour://payment/error" + query;
      // Android Chrome intent URI to directly wake up com.gourmet.damour
      var androidIntentUrl = "intent://payment/error" + query + "#Intent;scheme=gourmetdamour;package=com.gourmet.damour;end";

      var targetUrl = isAndroid ? androidIntentUrl : customSchemeUrl;

      // Update button target
      var btn = document.getElementById("btnApp");
      if (btn) {
        btn.href = targetUrl;
      }

      // Automatic redirection attempt
      function tryRedirect() {
        window.location.href = targetUrl;
      }

      // Execute redirect immediately, with slight delay to ensure browser paints
      setTimeout(tryRedirect, 300);

      // Fallback update if user is still on page after 2 seconds
      setTimeout(function () {
        var msg = document.getElementById("redirectMsg");
        if (msg) {
          msg.textContent = "Si l'application ne s'est pas ouverte, appuyez sur le bouton ci-dessus.";
        }
      }, 2500);
    })();
  </script>

</body>
</html>
