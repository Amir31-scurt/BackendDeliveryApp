<!DOCTYPE html>
<html lang="fr">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Paiement échoué | Gourmet d'amour</title>
  <link rel="icon" href="/images/logo.png" type="image/png">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --primary: #DB607E;
      --red: #EF5350;
      --red-light: #EF9A9A;
      --red-glow: rgba(239, 83, 80, 0.25);
      --bg: #0d0d0d;
      --card-bg: #161616;
      --border: rgba(255,255,255,0.07);
      --text: #f0ece6;
      --muted: #888;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Poppins', sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      position: relative;
    }

    body::before {
      content: '';
      position: fixed;
      top: -20%; left: -20%;
      width: 60%; height: 60%;
      background: radial-gradient(circle, rgba(239,83,80,0.10) 0%, transparent 70%);
      animation: blobFloat 8s ease-in-out infinite;
      pointer-events: none;
    }
    body::after {
      content: '';
      position: fixed;
      bottom: -20%; right: -20%;
      width: 55%; height: 55%;
      background: radial-gradient(circle, rgba(219,96,126,0.10) 0%, transparent 70%);
      animation: blobFloat 10s ease-in-out infinite reverse;
      pointer-events: none;
    }
    @keyframes blobFloat {
      0%, 100% { transform: translate(0,0) scale(1); }
      50%       { transform: translate(3%,3%) scale(1.05); }
    }

    .particles { position: fixed; inset: 0; pointer-events: none; overflow: hidden; }
    .particle { position: absolute; border-radius: 50%; opacity: 0; animation: particleRise linear infinite; }
    @keyframes particleRise {
      0%   { opacity: 0; transform: translateY(0) scale(0); }
      10%  { opacity: 0.4; }
      90%  { opacity: 0.2; }
      100% { opacity: 0; transform: translateY(-100vh) scale(1); }
    }

    .card {
      position: relative;
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 28px;
      padding: 56px 48px;
      max-width: 460px;
      width: 90%;
      text-align: center;
      box-shadow: 0 0 0 1px rgba(239,83,80,0.12), 0 40px 80px rgba(0,0,0,0.5), 0 0 80px rgba(239,83,80,0.06);
      animation: cardIn 0.8s cubic-bezier(0.16,1,0.3,1) both;
      z-index: 10;
    }
    @keyframes cardIn {
      from { opacity: 0; transform: translateY(40px) scale(0.95); }
      to   { opacity: 1; transform: translateY(0) scale(1); }
    }

    .icon-wrapper {
      width: 100px;
      height: 100px;
      margin: 0 auto 32px;
      position: relative;
    }
    .ring {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      border: 3px solid var(--red-light);
      animation: ringPulse 2.5s ease-out infinite;
    }
    .ring:nth-child(2) { animation-delay: 0.8s; }
    .ring:nth-child(3) { animation-delay: 1.6s; }
    @keyframes ringPulse {
      0%   { transform: scale(0.8); opacity: 0.7; }
      100% { transform: scale(1.8); opacity: 0; }
    }
    .icon-circle {
      position: relative;
      width: 100px;
      height: 100px;
      background: linear-gradient(135deg, var(--red), #E53935);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 0 40px var(--red-glow), 0 0 0 6px rgba(239,83,80,0.12);
      animation: iconPop 0.6s cubic-bezier(0.34,1.56,0.64,1) 0.4s both;
      z-index: 1;
    }
    @keyframes iconPop {
      from { transform: scale(0); opacity: 0; }
      to   { transform: scale(1); opacity: 1; }
    }

    /* X mark drawn via SVG paths */
    .x-icon { width: 40px; height: 40px; stroke: #fff; stroke-width: 3; stroke-linecap: round; fill: none; }
    .x-path1 { stroke-dasharray: 50; stroke-dashoffset: 50; animation: drawX 0.35s ease 0.9s forwards; }
    .x-path2 { stroke-dasharray: 50; stroke-dashoffset: 50; animation: drawX 0.35s ease 1.1s forwards; }
    @keyframes drawX { to { stroke-dashoffset: 0; } }

    /* Shake animation for the icon */
    .icon-circle { animation: iconPop 0.6s cubic-bezier(0.34,1.56,0.64,1) 0.4s both, iconShake 0.5s ease 1.3s; }
    @keyframes iconShake {
      0%,100% { transform: rotate(0deg); }
      20%      { transform: rotate(-6deg); }
      40%      { transform: rotate(6deg); }
      60%      { transform: rotate(-4deg); }
      80%      { transform: rotate(4deg); }
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(239,83,80,0.12);
      border: 1px solid rgba(239,83,80,0.3);
      color: var(--red-light);
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      padding: 5px 14px;
      border-radius: 100px;
      margin-bottom: 20px;
      animation: fadeUp 0.5s ease 0.5s both;
    }
    .badge-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--red-light); animation: blinkDot 1.4s ease infinite; }
    @keyframes blinkDot { 0%,100% { opacity: 1; } 50% { opacity: 0.2; } }

    h1 { font-family: 'Playfair Display', serif; font-size: 30px; font-weight: 700; color: #fff; margin-bottom: 12px; animation: fadeUp 0.5s ease 0.6s both; }
    .subtitle { color: var(--muted); font-size: 14px; line-height: 1.7; margin-bottom: 36px; animation: fadeUp 0.5s ease 0.7s both; }
    .divider { height: 1px; background: var(--border); margin-bottom: 28px; animation: fadeUp 0.5s ease 0.75s both; }

    /* Info box */
    .info-box {
      display: flex;
      align-items: flex-start;
      gap: 14px;
      background: rgba(239,83,80,0.05);
      border: 1px solid rgba(239,83,80,0.18);
      border-radius: 14px;
      padding: 16px 18px;
      margin-bottom: 24px;
      text-align: left;
      animation: fadeUp 0.5s ease 0.8s both;
    }
    .info-icon { flex-shrink: 0; width: 36px; height: 36px; background: rgba(239,83,80,0.15); border-radius: 10px; display: flex; align-items: center; justify-content: center; }
    .info-icon svg { width: 18px; height: 18px; stroke: var(--red-light); fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
    .info-text strong { display: block; font-size: 13px; color: #e0e0e0; margin-bottom: 3px; }
    .info-text span { font-size: 12px; color: var(--muted); line-height: 1.5; }

    /* Redirect countdown */
    .redirect-info {
      display: flex;
      align-items: center;
      gap: 14px;
      background: rgba(255,255,255,0.03);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 16px 20px;
      margin-bottom: 20px;
      animation: fadeUp 0.5s ease 0.85s both;
    }
    .countdown-circle { flex-shrink: 0; position: relative; width: 44px; height: 44px; }
    .countdown-circle svg { transform: rotate(-90deg); }
    .countdown-bg { fill: none; stroke: rgba(255,255,255,0.08); stroke-width: 3; }
    .countdown-fg {
      fill: none; stroke: var(--red-light); stroke-width: 3; stroke-linecap: round;
      stroke-dasharray: 113; stroke-dashoffset: 0;
      animation: countdownStroke 5s linear 1.4s forwards;
    }
    @keyframes countdownStroke { to { stroke-dashoffset: 113; } }
    .countdown-num { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 600; color: var(--red-light); }
    .redirect-text { text-align: left; }
    .redirect-text strong { display: block; font-size: 13px; color: #e0e0e0; margin-bottom: 2px; }
    .redirect-text span { font-size: 12px; color: var(--muted); }

    /* Buttons */
    .btn-primary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      width: 100%;
      padding: 16px 28px;
      background: linear-gradient(135deg, var(--primary) 0%, #c94a6a 100%);
      color: #fff;
      font-family: 'Poppins', sans-serif;
      font-size: 15px;
      font-weight: 600;
      border: none;
      border-radius: 14px;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.25s ease;
      box-shadow: 0 8px 30px rgba(219,96,126,0.3);
      animation: fadeUp 0.5s ease 0.9s both;
      margin-bottom: 12px;
    }
    .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 12px 40px rgba(219,96,126,0.45); filter: brightness(1.08); }
    .btn-primary:active { transform: translateY(0); }

    .btn-secondary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      width: 100%;
      padding: 14px 28px;
      background: transparent;
      color: var(--muted);
      font-family: 'Poppins', sans-serif;
      font-size: 14px;
      font-weight: 500;
      border: 1px solid var(--border);
      border-radius: 14px;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.25s ease;
      animation: fadeUp 0.5s ease 0.95s both;
    }
    .btn-secondary:hover { border-color: rgba(255,255,255,0.2); color: #ccc; background: rgba(255,255,255,0.04); }
    .btn-secondary svg { width: 16px; height: 16px; stroke: currentColor; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
    .btn-primary svg { width: 18px; height: 18px; stroke: currentColor; fill: none; stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }

    .logo-footer { margin-top: 28px; font-family: 'Playfair Display', serif; font-size: 13px; color: rgba(255,255,255,0.2); animation: fadeUp 0.5s ease 1s both; }
    .logo-footer span { color: var(--primary); }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(16px); }
      to   { opacity: 1; transform: translateY(0); }
    }
  </style>
</head>

<body>

  <div class="particles" id="particles"></div>

  <div class="card">
    <div class="icon-wrapper">
      <div class="ring"></div>
      <div class="ring"></div>
      <div class="ring"></div>
      <div class="icon-circle">
        <svg class="x-icon" viewBox="0 0 40 40">
          <path class="x-path1" d="M10 10 L30 30"/>
          <path class="x-path2" d="M30 10 L10 30"/>
        </svg>
      </div>
    </div>

    <div class="badge">
      <div class="badge-dot"></div>
      Paiement échoué
    </div>

    <h1>Oups, problème de paiement</h1>
    <p class="subtitle">
      Votre paiement Wave n'a pas pu être traité.<br>
      Votre commande n'a pas été confirmée.
    </p>

    <div class="divider"></div>

    <div class="info-box">
      <div class="info-icon">
        <svg viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="8" x2="12" y2="12"/>
          <line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
      </div>
      <div class="info-text">
        <strong>Que s'est-il passé ?</strong>
        <span>Le paiement a été annulé ou refusé. Aucun montant n'a été débité de votre compte Wave.</span>
      </div>
    </div>

    <div class="redirect-info">
      <div class="countdown-circle">
        <svg width="44" height="44" viewBox="0 0 44 44">
          <circle class="countdown-bg" cx="22" cy="22" r="18"/>
          <circle class="countdown-fg" cx="22" cy="22" r="18"/>
        </svg>
        <div class="countdown-num" id="countNum">5</div>
      </div>
      <div class="redirect-text">
        <strong>Redirection automatique</strong>
        <span>Retour à l'app dans <span id="secText">5</span> sec…</span>
      </div>
    </div>

    <!-- Retry button -->
    <a href="gourmetdamour://customer/UserOrdersScreen" class="btn-primary" id="openApp">
      <svg viewBox="0 0 24 24">
        <polyline points="1 4 1 10 7 10"/>
        <path d="M3.51 15a9 9 0 1 0 .49-3.51"/>
      </svg>
      Réessayer dans l'application
    </a>

    <!-- Close / go back -->
    <a href="gourmetdamour://customer/UserOrdersScreen" class="btn-secondary">
      <svg viewBox="0 0 24 24">
        <path d="M19 12H5M12 5l-7 7 7 7"/>
      </svg>
      Retour à mes commandes
    </a>

    <div class="logo-footer">Gourmet <span>d'amour</span> &nbsp;·&nbsp; Livraison premium</div>
  </div>

  <script>
    let sec = 5;
    const numEl = document.getElementById('countNum');
    const secEl = document.getElementById('secText');
    const tick = setInterval(() => {
      sec--;
      if (numEl) numEl.textContent = sec;
      if (secEl) secEl.textContent = sec;
      if (sec <= 0) {
        clearInterval(tick);
        window.location.href = 'gourmetdamour://customer/UserOrdersScreen';
      }
    }, 1000);

    // Particles (subdued)
    const particlesEl = document.getElementById('particles');
    const colors = ['#EF5350','#EF9A9A','#DB607E','#888','#aaa'];
    for (let i = 0; i < 12; i++) {
      const p = document.createElement('div');
      p.className = 'particle';
      const size = Math.random() * 4 + 2;
      p.style.cssText = `left:${Math.random()*100}%;top:${100+Math.random()*20}%;width:${size}px;height:${size}px;background:${colors[Math.floor(Math.random()*colors.length)]};animation-duration:${Math.random()*10+8}s;animation-delay:${Math.random()*5}s;`;
      particlesEl.appendChild(p);
    }
  </script>

</body>
</html>
