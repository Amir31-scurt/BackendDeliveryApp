<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tableau de Bord Restaurant - Gourmet d'amour</title>
    <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Poppins:wght@300;400;600&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <style>
        :root {
            --primary-color: #DB607E;
            --secondary-color: #ABD27E;
            --accent-color: #b22222;
            --background-color: #f9f5f0;
            --dark-color: #2c2c2c;
            --card-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            --hover-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: var(--background-color);
            min-height: 100vh;
            color: var(--dark-color);
        }

        .dashboard-container {
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: 250px;
            background: white;
            padding: 2rem;
            box-shadow: var(--card-shadow);
            position: fixed;
            height: 100vh;
            z-index: 100;
        }

        .sidebar-header {
            margin-bottom: 2rem;
            text-align: center;
        }

        .sidebar-header h1 {
            font-family: 'Playfair Display', serif;
            color: var(--primary-color);
            font-size: 1.8rem;
            margin-bottom: 0.5rem;
        }

        .nav-menu {
            list-style: none;
        }

        .nav-item {
            margin-bottom: 0.5rem;
        }

        .nav-link {
            display: flex;
            align-items: center;
            padding: 0.75rem 1rem;
            color: var(--dark-color);
            text-decoration: none;
            border-radius: 8px;
            transition: all 0.3s ease;
        }

        .nav-link:hover,
        .nav-link.active {
            background-color: var(--primary-color);
            color: white;
        }

        .nav-link i {
            margin-right: 0.75rem;
            width: 20px;
            text-align: center;
        }

        .main-content {
            flex: 1;
            margin-left: 250px;
            padding: 2rem;
        }

        .page-header {
            margin-bottom: 2rem;
        }

        .page-title {
            font-family: 'Playfair Display', serif;
            font-size: 2rem;
            color: var(--dark-color);
            margin-bottom: 0.5rem;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .stat-card {
            background: white;
            padding: 1.5rem;
            border-radius: 15px;
            box-shadow: var(--card-shadow);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: var(--primary-color);
        }

        .stat-card h3 {
            font-size: 1.1rem;
            color: var(--dark-color);
            margin-bottom: 0.5rem;
            display: flex;
            align-items: center;
        }

        .stat-card h3 i {
            margin-right: 0.5rem;
            color: var(--primary-color);
        }

        .stat-card p {
            font-size: 2.5rem;
            font-weight: 600;
            color: var(--primary-color);
        }

        .chart-container {
            background: white;
            padding: 2rem;
            border-radius: 15px;
            box-shadow: var(--card-shadow);
            margin-bottom: 2rem;
            height: 400px;
            position: relative;
        }

        .chart-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.5rem;
            color: var(--dark-color);
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
        }

        .chart-title i {
            margin-right: 0.75rem;
            color: var(--primary-color);
        }

        .orders-section {
            background: white;
            padding: 2rem;
            border-radius: 15px;
            box-shadow: var(--card-shadow);
        }

        .orders-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
        }

        .orders-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.5rem;
            color: var(--dark-color);
            display: flex;
            align-items: center;
        }

        .orders-title i {
            margin-right: 0.75rem;
            color: var(--primary-color);
        }

        .orders-table {
            width: 100%;
            border-collapse: collapse;
        }

        .orders-table th {
            text-align: left;
            padding: 1rem;
            border-bottom: 2px solid var(--primary-color);
            color: var(--dark-color);
            font-weight: 600;
        }

        .orders-table td {
            padding: 1rem;
            border-bottom: 1px solid #eee;
        }

        .orders-table tr:hover {
            background-color: var(--background-color);
        }

        .status-badge {
            padding: 0.5rem 1rem;
            border-radius: 20px;
            font-size: 0.875rem;
            font-weight: 500;
            display: inline-block;
        }

        .status-pending {
            background-color: #f3f4f6;
            color: #4b5563;
        }

        .status-preparing {
            background-color: #dbeafe;
            color: #1e40af;
        }

        .status-delivering {
            background-color: #fef3c7;
            color: #92400e;
        }

        .status-completed {
            background-color: #dcfce7;
            color: #166534;
        }

        .status-cancelled {
            background-color: #fee2e2;
            color: #991b1b;
        }

        .action-dropdown {
            position: relative;
            display: inline-block;
        }

        .action-button {
            background-color: #f3f4f6;
            color: var(--dark-color);
            padding: 0.5rem 1rem;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            transition: all 0.3s ease;
        }

        .action-button:hover {
            background-color: #e5e7eb;
        }

        .dropdown-menu {
            position: absolute;
            right: 0;
            top: 100%;
            background: white;
            border-radius: 8px;
            box-shadow: var(--card-shadow);
            min-width: 200px;
            z-index: 1000;
            display: none;
        }

        .dropdown-menu.show {
            display: block;
        }

        .dropdown-item {
            padding: 0.75rem 1rem;
            color: var(--dark-color);
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            transition: all 0.3s ease;
        }

        .dropdown-item:hover {
            background-color: var(--background-color);
        }

        .dropdown-item i {
            width: 20px;
            text-align: center;
        }

        .note-container {
            position: relative;
            cursor: pointer;
        }

        .note-text {
            display: block;
            padding: 0.5rem;
            border-radius: 4px;
            transition: background-color 0.3s ease;
        }

        .note-text:hover {
            background-color: var(--background-color);
        }

        .note-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5);
            z-index: 1000;
        }

        .note-modal-content {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background-color: white;
            padding: 2rem;
            border-radius: 8px;
            width: 90%;
            max-width: 500px;
        }

        .note-modal textarea {
            width: 100%;
            min-height: 100px;
            padding: 0.75rem;
            border: 1px solid #ddd;
            border-radius: 4px;
            margin-bottom: 1rem;
            font-family: inherit;
        }

        .note-modal-buttons {
            display: flex;
            justify-content: flex-end;
            gap: 1rem;
        }

        @media (max-width: 768px) {
            .sidebar {
                width: 70px;
                padding: 1rem;
            }

            .sidebar-header h1 {
                display: none;
            }

            .nav-link span {
                display: none;
            }

            .nav-link i {
                margin-right: 0;
                font-size: 1.2rem;
            }

            .main-content {
                margin-left: 70px;
                padding: 1rem;
            }

            .stats-grid {
                grid-template-columns: 1fr;
            }

            .orders-table {
                display: block;
                overflow-x: auto;
            }
        }
    </style>
</head>

<body>
    <div class="dashboard-container">
        <aside class="sidebar">
            <div class="sidebar-header">
                <h1>Gourmet d'amour</h1>
                <p>Restaurant</p>
            </div>
            <nav>
                <ul class="nav-menu">
                    <li class="nav-item">
                        <a href="/admin/dashboard" class="nav-link active">
                            <i class="fas fa-chart-line"></i>
                            <span>Tableau de Bord</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="/admin/menu" class="nav-link">
                            <i class="fas fa-utensils"></i>
                            <span>Menu</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="/" class="nav-link">
                            <i class="fas fa-home"></i>
                            <span>Accueil</span>
                        </a>
                    </li>
                </ul>
            </nav>
        </aside>

        <main class="main-content">
            <div class="page-header">
                <h2 class="page-title">Tableau de Bord</h2>
                <p>Bienvenue, <%= restaurant.name %>
                </p>
            </div>

            <div class="stats-grid">
                <div class="stat-card">
                    <h3><i class="fas fa-shopping-cart"></i> Commandes Totales</h3>
                    <p>
                        <%= orders.length %>
                    </p>
                </div>

                <div class="stat-card">
                    <h3><i class="fas fa-calendar-day"></i> Commandes Aujourd'hui</h3>
                    <p>
                        <%= orders.filter(order=> new Date(order.createdAt).toLocaleDateString() === new
                            Date().toLocaleDateString()).length %>
                    </p>
                </div>

                <div class="stat-card">
                    <h3><i class="fas fa-users"></i> Clients Aujourd'hui</h3>
                    <p>
                        <%= orders.filter(order=> new Date(order.createdAt).toLocaleDateString() === new
                            Date().toLocaleDateString()).length %>
                    </p>
                </div>

                <div class="stat-card">
                    <h3><i class="fas fa-money-bill-wave"></i> Revenus Aujourd'hui</h3>
                    <p>
                        <%= orders.filter(order=> new Date(order.createdAt).toLocaleDateString() === new
                            Date().toLocaleDateString()).reduce((total, order) => total + order.totalAmount, 0) %> Fcfa
                    </p>
                </div>
            </div>

            <div class="chart-container">
                <h3 class="chart-title">
                    <i class="fas fa-chart-bar"></i>
                    Revenus Mensuels
                </h3>
                <canvas id="revenueChart"></canvas>
            </div>

            <div class="orders-section">
                <div class="orders-header">
                    <h3 class="orders-title">
                        <i class="fas fa-list"></i>
                        Liste des Commandes
                    </h3>
                </div>

                <table class="orders-table">
                    <thead>
                        <tr>
                            <th>N°</th>
                            <th>Date</th>
                            <th>Client</th>
                            <th>Téléphone</th>
                            <th>Adresse</th>
                            <th>Montant</th>
                            <th>Note</th>
                            <th>Statut</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (orders && orders.length> 0) { %>
                            <% orders.forEach((order, index)=> { %>
                                <tr>
                                    <td>
                                        <%= index + 1 %>
                                    </td>
                                    <td>
                                        <%= new Date(order.createdAt).toLocaleString() %>
                                    </td>
                                    <td>
                                        <%= order.user.name %>
                                    </td>
                                    <td>
                                        <%= order.user.phoneNumber %>
                                    </td>
                                    <td>
                                        <%= order.deliveryAddress.address %>
                                    </td>
                                    <td>
                                        <%= order.totalAmount %> Fcfa
                                    </td>
                                    <td>
                                        <div class="note-container">
                                            <span class="note-text" data-order-id="<%= order.id %>"
                                                data-note="<%= order.note || '' %>"
                                                onclick="editNote(this.dataset.orderId, this.dataset.note)">
                                                <%= order.note || 'Ajouter une note...' %>
                                            </span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="status-badge status-<%= order.status.toLowerCase() %>">
                                            <%= order.status==='PENDING' ? 'En attente' : order.status==='PREPARING'
                                                ? 'En préparation' : order.status==='DELIVERING' ? 'En livraison' :
                                                order.status==='COMPLETED' ? 'Livrée' : 'Annulée' %>
                                        </span>
                                    </td>
                                    <td>
                                        <div class="action-dropdown">
                                            <button class="action-button" onclick="toggleDropdown(this)">
                                                <span>Actions</span>
                                                <i class="fas fa-chevron-down"></i>
                                            </button>
                                            <div class="dropdown-menu">
                                                <a href="#" class="dropdown-item"
                                                    onclick="updateOrderStatus('<%= order.id %>', 'PREPARING')">
                                                    <i class="fas fa-sync"></i>
                                                    En préparation
                                                </a>
                                                <a href="#" class="dropdown-item"
                                                    onclick="updateOrderStatus('<%= order.id %>', 'DELIVERING')">
                                                    <i class="fas fa-truck"></i>
                                                    En livraison
                                                </a>
                                                <a href="#" class="dropdown-item"
                                                    onclick="updateOrderStatus('<%= order.id %>', 'COMPLETED')">
                                                    <i class="fas fa-check"></i>
                                                    Livrée
                                                </a>
                                                <a href="#" class="dropdown-item"
                                                    onclick="updateOrderStatus('<%= order.id %>', 'CANCELLED')">
                                                    <i class="fas fa-times"></i>
                                                    Annuler
                                                </a>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                                <% }); %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="9" style="text-align: center; padding: 2rem;">
                                                Aucune commande trouvée
                                            </td>
                                        </tr>
                                        <% } %>
                    </tbody>
                </table>
            </div>
        </main>
    </div>

    <!-- Add Note Modal -->
    <div id="noteModal" class="note-modal">
        <div class="note-modal-content">
            <h3>Modifier la note</h3>
            <textarea id="noteText" placeholder="Entrez votre note ici..."></textarea>
            <div class="note-modal-buttons">
                <button onclick="closeNoteModal()" class="modal-btn cancel-btn">Annuler</button>
                <button onclick="saveNote()" class="modal-btn submit-btn">Enregistrer</button>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Revenue Chart
        const revenueCtx = document.getElementById('revenueChart').getContext('2d');
        new Chart(revenueCtx, {
            type: 'line',
            data: {
                labels: ['Jan', 'Fév', 'Mar', 'Avr', 'Mai', 'Jun', 'Jul', 'Aoû', 'Sep', 'Oct', 'Nov', 'Déc'],
                datasets: [{
                    label: 'Revenus',
                    data: [1000, 2000, 3000, 4000, 5000, 6000, 7000, 8000, 9000, 10000, 11000, 12000],
                    backgroundColor: 'rgba(219, 96, 126, 0.1)',
                    borderColor: 'rgba(219, 96, 126, 1)',
                    borderWidth: 2,
                    tension: 0.4,
                    fill: true
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false
                    },
                    tooltip: {
                        backgroundColor: 'rgba(44, 44, 44, 0.9)',
                        titleFont: {
                            family: "'Poppins', sans-serif",
                            size: 14
                        },
                        bodyFont: {
                            family: "'Poppins', sans-serif",
                            size: 13
                        },
                        padding: 12,
                        cornerRadius: 8,
                        displayColors: false,
                        callbacks: {
                            label: function (context) {
                                return `${context.parsed.y} Fcfa`;
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        grid: {
                            display: false
                        },
                        title: {
                            display: true,
                            text: "Mois",
                            color: "#2c2c2c",
                            font: {
                                size: 14,
                                family: "'Poppins', sans-serif",
                                weight: '600'
                            },
                            padding: { top: 10 }
                        }
                    },
                    y: {
                        beginAtZero: true,
                        grid: {
                            color: 'rgba(0, 0, 0, 0.05)'
                        },
                        title: {
                            display: true,
                            text: "Revenus (Fcfa)",
                            color: "#2c2c2c",
                            font: {
                                size: 14,
                                family: "'Poppins', sans-serif",
                                weight: '600'
                            },
                            padding: { bottom: 10 }
                        }
                    }
                }
            }
        });

        // Orders Chart
        const ordersCtx = document.getElementById('ordersChart').getContext('2d');
        new Chart(ordersCtx, {
            type: 'bar',
            data: {
                labels: ['Jan', 'Fév', 'Mar', 'Avr', 'Mai', 'Jun', 'Jul', 'Aoû', 'Sep', 'Oct', 'Nov', 'Déc'],
                datasets: [{
                    label: 'Commandes',
                    data: [100, 200, 300, 400, 500, 600, 700, 800, 900, 1000, 1100, 1200],
                    backgroundColor: 'rgba(171, 210, 126, 0.5)',
                    borderColor: 'rgba(171, 210, 126, 1)',
                    borderWidth: 1,
                    borderRadius: 5,
                    barThickness: 40,
                    maxBarThickness: 50
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false
                    },
                    tooltip: {
                        backgroundColor: 'rgba(44, 44, 44, 0.9)',
                        titleFont: {
                            family: "'Poppins', sans-serif",
                            size: 14
                        },
                        bodyFont: {
                            family: "'Poppins', sans-serif",
                            size: 13
                        },
                        padding: 12,
                        cornerRadius: 8,
                        displayColors: false,
                        callbacks: {
                            label: function (context) {
                                return `${context.parsed.y} commandes`;
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        grid: {
                            display: false
                        },
                        title: {
                            display: true,
                            text: "Mois",
                            color: "#2c2c2c",
                            font: {
                                size: 14,
                                family: "'Poppins', sans-serif",
                                weight: '600'
                            },
                            padding: { top: 10 }
                        }
                    },
                    y: {
                        beginAtZero: true,
                        grid: {
                            color: 'rgba(0, 0, 0, 0.05)'
                        },
                        title: {
                            display: true,
                            text: "Nombre de Commandes",
                            color: "#2c2c2c",
                            font: {
                                size: 14,
                                family: "'Poppins', sans-serif",
                                weight: '600'
                            },
                            padding: { bottom: 10 }
                        },
                        ticks: {
                            precision: 0,
                            stepSize: 1
                        }
                    }
                }
            }
        });

        // Dropdown functionality
        function toggleDropdown(button) {
            const dropdown = button.nextElementSibling;
            dropdown.classList.toggle('show');
        }

        // Close dropdowns when clicking outside
        document.addEventListener('click', function (event) {
            const dropdowns = document.querySelectorAll('.dropdown-menu');
            dropdowns.forEach(dropdown => {
                if (!dropdown.contains(event.target) && !event.target.matches('.action-button')) {
                    dropdown.classList.remove('show');
                }
            });
        });

        // Update order status
        async function updateOrderStatus(id, status) {
            try {
                const response = await fetch(`/admin/orders/${id}/status`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ status }),
                });

                if (response.ok) {
                    alert('Statut de la commande mis à jour avec succès!');
                    window.location.reload();
                } else {
                    throw new Error('Échec de la mise à jour du statut');
                }
            } catch (error) {
                console.error('Error updating order status:', error);
                alert('Une erreur est survenue lors de la mise à jour du statut');
            }
        }

        let currentOrderId = null;

        function editNote(orderId, currentNote) {
            currentOrderId = orderId;
            const modal = document.getElementById('noteModal');
            const textarea = document.getElementById('noteText');
            textarea.value = currentNote;
            modal.style.display = 'block';
        }

        function closeNoteModal() {
            const modal = document.getElementById('noteModal');
            modal.style.display = 'none';
            currentOrderId = null;
        }

        async function saveNote() {
            if (!currentOrderId) return;

            const note = document.getElementById('noteText').value;

            try {
                const response = await fetch(`/admin/orders/${currentOrderId}/note`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ note }),
                });

                if (response.ok) {
                    alert('Note mise à jour avec succès!');
                    window.location.reload();
                } else {
                    throw new Error('Échec de la mise à jour de la note');
                }
            } catch (error) {
                console.error('Error updating note:', error);
                alert('Une erreur est survenue lors de la mise à jour de la note');
            }

            closeNoteModal();
        }

        // Close modal when clicking outside
        window.onclick = function (event) {
            const modal = document.getElementById('noteModal');
            if (event.target === modal) {
                closeNoteModal();
            }
        }
    </script>
</body>

</html>