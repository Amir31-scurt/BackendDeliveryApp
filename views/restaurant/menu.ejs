<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="csrf-token" content="<%= csrfToken %>" />
    <title>Gestion du Menu - Gourmet d'amour</title>
    <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Poppins:wght@300;400;600&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <style>
        :root {
            --primary-color: #DB607E;
            --secondary-color: #ABD27E;
            --accent-color: #b22222;
            --background-color: #f9f5f0;
            --dark-color: #2c2c2c;
            --card-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            --hover-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: var(--background-color);
            min-height: 100vh;
            color: var(--dark-color);
        }

        .dashboard-container {
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: 250px;
            background: white;
            padding: 1rem;
            box-shadow: var(--card-shadow);
            position: fixed;
            height: 100vh;
            z-index: 100;
        }

        .sidebar-header {
            margin-bottom: 2rem;
            text-align: center;
        }

        .sidebar-header h1 {
            font-family: 'Playfair Display', serif;
            color: var(--primary-color);
            font-size: 1.1rem;
            margin-bottom: 0.5rem;
        }

        .nav-menu {
            list-style: none;
        }

        .nav-item {
            margin-bottom: 0.5rem;
        }

        .nav-link {
            display: flex;
            align-items: center;
            padding: 0.75rem 1rem;
            color: var(--dark-color);
            text-decoration: none;
            border-radius: 8px;
            transition: all 0.3s ease;
        }

        .nav-link:hover,
        .nav-link.active {
            background-color: var(--primary-color);
            color: white;
        }

        .nav-link i {
            margin-right: 0.75rem;
            width: 20px;
            text-align: center;
        }

        .main-content {
            flex: 1;
            margin-left: 250px;
            padding: 2rem;
        }

        .page-header {
            margin-bottom: 2rem;
        }

        .page-title {
            font-family: 'Playfair Display', serif;
            font-size: 2rem;
            color: var(--dark-color);
            margin-bottom: 0.5rem;
        }

        .menu-section {
            background: white;
            padding: 2rem;
            border-radius: 15px;
            box-shadow: var(--card-shadow);
        }

        .menu-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
        }

        .menu-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.5rem;
            color: var(--dark-color);
            display: flex;
            align-items: center;
        }

        .menu-title i {
            margin-right: 0.75rem;
            color: var(--primary-color);
        }

        .menu-actions {
            display: flex;
            gap: 1rem;
            align-items: center;
        }

        .search-box {
            position: relative;
            width: 300px;
        }

        .search-input {
            width: 100%;
            padding: 0.75rem 1rem;
            padding-right: 2.5rem;
            border: 2px solid #eee;
            border-radius: 8px;
            font-size: 1rem;
            transition: all 0.3s ease;
        }

        .search-input:focus {
            outline: none;
            border-color: var(--primary-color);
        }

        .search-icon {
            position: absolute;
            right: 1rem;
            top: 50%;
            transform: translateY(-50%);
            color: #95a5a6;
        }

        .menu-filters {
            display: flex;
            gap: 1rem;
            margin-bottom: 1.5rem;
        }

        .filter-select {
            padding: 0.5rem 1rem;
            border: 2px solid #eee;
            border-radius: 8px;
            font-size: 0.9rem;
            color: var(--dark-color);
            background-color: white;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .filter-select:focus {
            outline: none;
            border-color: var(--primary-color);
        }

        .menu-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 1.5rem;
            margin-top: 1.5rem;
        }

        .menu-item-card {
            background: white;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: var(--card-shadow);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .menu-item-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--hover-shadow);
        }

        .menu-item-image-container {
            position: relative;
            height: 200px;
            overflow: hidden;
        }

        .menu-item-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s ease;
        }

        .menu-item-card:hover .menu-item-image {
            transform: scale(1.05);
        }

        .menu-item-overlay {
            position: absolute;
            inset: 0;
            background: rgba(0, 0, 0, 0.5);
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 1rem;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .menu-item-card:hover .menu-item-overlay {
            opacity: 1;
        }

        .menu-item-details {
            padding: 1.5rem;
        }

        .menu-item-name {
            font-size: 1.2rem;
            font-weight: 600;
            color: var(--dark-color);
            margin-bottom: 0.5rem;
        }

        .menu-item-description {
            color: #666;
            font-size: 0.9rem;
            margin-bottom: 1rem;
            line-height: 1.4;
        }

        .menu-item-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .menu-item-price {
            font-weight: 600;
            color: var(--primary-color);
            font-size: 1.1rem;
        }

        .menu-item-category {
            background: #f0f0f0;
            padding: 0.25rem 0.75rem;
            border-radius: 20px;
            font-size: 0.8rem;
            color: #666;
        }

        .add-item-btn {
            background-color: var(--primary-color);
            color: white;
            padding: 0.75rem 1.5rem;
            border: none;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .add-item-btn:hover {
            background-color: #c44d68;
            transform: translateY(-2px);
        }

        .menu-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 1rem;
        }

        .menu-table th {
            text-align: left;
            padding: 1rem;
            border-bottom: 2px solid var(--primary-color);
            color: var(--dark-color);
            font-weight: 600;
        }

        .menu-table td {
            padding: 1rem;
            border-bottom: 1px solid #eee;
            color: var(--dark-color);
        }

        .menu-table tr:hover {
            background-color: var(--background-color);
        }

        .action-buttons {
            display: flex;
            gap: 1rem;
        }

        .action-btn {
            background: none;
            border: none;
            cursor: pointer;
            font-size: 1.1rem;
            transition: color 0.3s ease;
        }

        .edit-btn {
            color: var(--primary-color);
        }

        .delete-btn {
            color: var(--accent-color);
        }

        .action-btn:hover {
            opacity: 0.8;
        }

        .no-items {
            text-align: center;
            padding: 3rem;
            background: white;
            border-radius: 12px;
            box-shadow: var(--card-shadow);
        }

        .no-items i {
            font-size: 3rem;
            color: #ddd;
            margin-bottom: 1rem;
        }

        .no-items p {
            color: #666;
            margin-bottom: 1.5rem;
        }

        /* Modal Styles */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5);
            z-index: 1000;
            opacity: 0;
            transition: opacity 0.3s ease;
            align-items: center;
            justify-content: center;
        }

        .modal.show {
            opacity: 1;
        }

        .modal-content {
            background: white;
            padding: 2rem;
            border-radius: 15px;
            width: 90%;
            max-width: 800px;
            position: relative;
            transform: translateY(-20px);
            transition: transform 0.3s ease;
            margin: auto;
        }

        .modal.show .modal-content {
            transform: translateY(0);
        }

        .modal-header {
            margin-bottom: 1.5rem;
            padding-right: 2rem;
        }

        .modal-header h2 {
            font-family: 'Playfair Display', serif;
            font-size: 1.8rem;
            color: var(--dark-color);
            margin: 0;
        }

        .close-modal {
            position: absolute;
            top: 1rem;
            right: 1rem;
            background: none;
            border: none;
            font-size: 1.5rem;
            color: var(--dark-color);
            cursor: pointer;
            padding: 0.5rem;
            line-height: 1;
            transition: color 0.3s ease;
        }

        .close-modal:hover {
            color: var(--primary-color);
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-group label {
            display: block;
            margin-bottom: 0.5rem;
            color: var(--dark-color);
            font-weight: 500;
        }

        .form-control {
            width: 100%;
            padding: 0.75rem;
            border: 2px solid #eee;
            border-radius: 8px;
            font-size: 1rem;
            transition: border-color 0.3s ease;
        }

        .form-control:focus {
            outline: none;
            border-color: var(--primary-color);
        }

        .modal-buttons {
            display: flex;
            gap: 1rem;
            margin-top: 2rem;
        }

        .modal-btn {
            flex: 1;
            padding: 0.75rem;
            border: none;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .submit-btn {
            background-color: var(--primary-color);
            color: white;
        }

        .cancel-btn {
            background-color: #eee;
            color: var(--dark-color);
        }

        .modal-btn:hover {
            transform: translateY(-2px);
        }

        .modal-btn.submit-btn:hover {
            background-color: #c44d68;
        }

        .modal-btn.cancel-btn:hover {
            background-color: #ddd;
        }

        @media (max-width: 768px) {
            .sidebar {
                width: 70px;
                padding: 1rem;
            }

            .sidebar-header h1 {
                display: none;
            }

            .nav-link span {
                display: none;
            }

            .nav-link i {
                margin-right: 0;
                font-size: 1.2rem;
            }

            .main-content {
                margin-left: 70px;
                padding: 1rem;
            }

            .menu-actions {
                flex-direction: column;
                width: 100%;
            }

            .search-box {
                width: 100%;
            }

            .menu-filters {
                flex-direction: column;
            }

            .filter-select {
                width: 100%;
            }

            .menu-grid {
                grid-template-columns: 1fr;
            }
        }

        .menu-modal-grid {
            display: flex;
            flex-direction: column;
        }

        .modal-body-grid {
            display: block;
        }

        .inner-modal-container {
            display: flex;
            flex-direction: row;
            width: 100%;
            gap: 20px;
        }

        .left-side,
        .right-side {
            flex: 1;
            min-width: 0;
        }

        .image-preview-container {
            width: 350px;
            height: 350px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-start;
            border: 1px dashed #eee;
            border-radius: 10px;
            background: #fafafa;
            padding: 0.5rem;
            position: relative;
        }

        .image-preview-container label {
            font-size: 0.95rem;
            color: #888;
            margin-bottom: 0.5rem;
        }

        #imagePreview {
            width: 100%;
            height: 100%;
            object-fit: contain;
            border-radius: 8px;
            display: block;
        }

        .no-image-preview {
            color: #aaa;
            font-size: 1rem;
            text-align: center;
        }

        .logo-icon {
            width: 150px;
            height: 150px
        }

        @media (max-width: 768px) {
            .modal-body-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>
    <div class="dashboard-container">
        <aside class="sidebar">
            <div class="sidebar-header">
                <img src="/images/logo.png" alt="logo" class="logo-icon">
                <h1>Gourmet d'amour</h1>
                <p>Restaurant</p>
            </div>
            <nav>
                <ul class="nav-menu">
                    <li class="nav-item">
                        <a href="/admin/restaurant/<%= restaurant.id %>/dashboard" class="nav-link">
                            <i class="fas fa-chart-line"></i>
                            <span>Tableau de Bord</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="/admin/restaurant/<%= restaurant.id %>/menu" class="nav-link active">
                            <i class="fas fa-utensils"></i>
                            <span>Menu</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="/admin/logout" class="nav-link logout">
                            <i class="fas fa-sign-out-alt"></i>
                            <span>Déconnexion</span>
                        </a>
                    </li>
                </ul>
            </nav>
        </aside>

        <main class="main-content">
            <div class="page-header">
                <h2 class="page-title">Gestion du Menu</h2>
                <p>Bienvenue, <%= restaurant.name %>
                </p>
            </div>

            <div class="menu-section">
                <div class="menu-header">
                    <h3 class="menu-title">
                        <i class="fas fa-utensils"></i>
                        Articles du Menu
                    </h3>
                    <div class="menu-actions">
                        <div class="search-box">
                            <input type="text" id="menuSearch" placeholder="Rechercher un article..."
                                class="search-input">
                            <i class="fas fa-search search-icon"></i>
                        </div>
                        <button id="addItemBtn" class="add-item-btn">
                            <i class="fas fa-plus"></i> Ajouter un Article
                        </button>
                    </div>
                </div>

                <% if (menuItems && menuItems.length> 0) { %>
                    <div class="menu-filters">
                        <select id="categoryFilter" class="filter-select">
                            <option value="">Toutes les catégories</option>
                            <% const categories=[...new Set(menuItems.map(item=> item.category))];
                                categories.forEach(category => {
                                %>
                                <option value="<%= category %>">
                                    <%= category.charAt(0) + category.slice(1).toLowerCase() %>
                                </option>
                                <% }); %>
                        </select>
                        <select id="sortFilter" class="filter-select">
                            <option value="name">Trier par nom</option>
                            <option value="price-asc">Prix croissant</option>
                            <option value="price-desc">Prix décroissant</option>
                            <option value="category">Trier par catégorie</option>
                        </select>
                    </div>

                    <div class="menu-grid">
                        <% menuItems.forEach((item)=> { %>
                            <div class="menu-item-card" data-category="<%= item.category %>" data-id="<%= item.id %>">
                                <div class="menu-item-image-container">
                                    <img src="<%= item.image_url %>" alt="<%= item.name %>" class="menu-item-image" />
                                    <div class="menu-item-overlay">
                                        <button class="action-btn edit-btn" data-id="<%= item.id %>">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button class="action-btn delete-btn" data-id="<%= item.id %>"
                                            data-name="<%= item.name %>">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="menu-item-details">
                                    <h4 class="menu-item-name">
                                        <%= item.name %>
                                    </h4>
                                    <p class="menu-item-description">
                                        <%= item.description %>
                                    </p>
                                    <div class="menu-item-footer">
                                        <span class="menu-item-price">
                                            <%= item.price.toFixed(2) %> Fcfa
                                        </span>
                                        <span class="menu-item-category">
                                            <%= item.category %>
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <% }); %>
                    </div>
                    <% } else { %>
                        <div class="no-items">
                            <i class="fas fa-utensils"></i>
                            <p>Aucun article de menu disponible.</p>
                            <button id="addFirstItemBtn" class="add-item-btn">
                                <i class="fas fa-plus"></i> Ajouter votre premier article
                            </button>
                        </div>
                        <% } %>
            </div>

            <!-- Add/Edit Menu Item Modal -->
            <div id="menuItemModal" class="modal">
                <div class="modal-content menu-modal-grid">
                    <button id="closeModalBtn" class="close-modal">&times;</button>
                    <div class="modal-header">
                        <h2>Ajouter un Article</h2>
                    </div>
                    <div class="modal-body-grid">
                        <form id="menuItemForm" class="space-y-4">
                            <div class="inner-modal-container">
                                <div class="left-side">
                                    <div class="form-group">
                                        <label for="name">Nom</label>
                                        <input type="text" id="name" name="name" class="form-control"
                                            placeholder="Entrer le nom de l'article" required />
                                    </div>
                                    <div class="form-group">
                                        <label for="description">Description</label>
                                        <textarea id="description" name="description" class="form-control"
                                            placeholder="Entrer la description de l'article" rows="3"
                                            required></textarea>
                                    </div>
                                    <div class="form-group">
                                        <label for="price">Prix</label>
                                        <input type="number" id="price" name="price" step="0.01" class="form-control"
                                            placeholder="Entrer le prix de l'article" required />
                                    </div>
                                    <div class="form-group">
                                        <label for="category">Catégorie</label>
                                        <select id="category" name="category" class="form-control" required>
                                            <!-- Categories will be populated based on restaurant type -->
                                        </select>
                                    </div>
                                </div>
                                <div class="right-side">
                                    <div class="form-group">
                                        <label for="image">Image</label>
                                        <input type="file" id="image" value="" name="image" accept="image/*"
                                            class="form-control" required />
                                    </div>
                                    <div class="image-preview-container">
                                        <label for="imagePreview">Apperçue de l'image</label>
                                        <img id="imagePreview" src="" alt="Aperçu de l'image" style="display:none;" />
                                        <div id="noImagePreview" class="no-image-preview">Aucune image sélectionnée
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="modal-buttons">
                                <button type="button" id="submitMenuItemBtn" class="modal-btn submit-btn">
                                    Ajouter
                                </button>
                                <button type="button" id="cancelModalBtn" class="modal-btn cancel-btn">
                                    Annuler
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script>
        const restaurantType = "<%= restaurant.type %>";
        let lastImageUrl = '';

        function openModal() {
            const modal = document.getElementById('menuItemModal');
            modal.style.display = 'flex';
            requestAnimationFrame(() => {
                modal.classList.add('show');
            });
            document.body.style.overflow = 'hidden';
            populateCategoriesByType();
            // Reset image preview for add mode
            if (imagePreview && noImagePreview) {
                imagePreview.src = '';
                imagePreview.style.display = 'none';
                noImagePreview.style.display = 'block';
            }
            lastImageUrl = '';
            // Also reset the file input
            if (imageInput) {
                imageInput.value = '';
            }
        }

        function populateCategoriesByType() {
            const categorySelect = document.getElementById("category");
            categorySelect.innerHTML = ""; // Clear existing options

            const categories = {
                "RESTAURANT": ["PLAT", "FASTFOOD", "GRILLADE"],
                "BOULANGERIE": ["PAINS", "VIENNOISERIES", "PATISSERIE"],
                "EXPRESS": ["EXPRESS", "GOURMET", "DESSERT"]
            };

            // Get the appropriate categories based on restaurant type
            const typeCategories = categories[restaurantType] || ["PLAT", "FASTFOOD", "GRILLADE"];

            // Add options to select dropdown
            typeCategories.forEach(category => {
                const option = document.createElement("option");
                option.value = category;
                option.textContent = category.charAt(0) + category.slice(1).toLowerCase();
                categorySelect.appendChild(option);
            });
        }

        function closeModal() {
            const modal = document.getElementById('menuItemModal');
            const form = document.getElementById('menuItemForm');
            const modalTitle = modal.querySelector('.modal-header h2');
            const submitButton = modal.querySelector('#submitMenuItemBtn');
            const imageInput = document.getElementById('image');

            if (!modal || !form || !modalTitle || !submitButton) {
                console.error('Required modal elements not found');
                return;
            }

            // Hide modal
            modal.classList.remove('show');
            setTimeout(() => {
                modal.style.display = 'none';
            }, 300);

            // Reset form
            form.reset();
            form.removeAttribute('data-mode');
            form.removeAttribute('data-id');

            // Reset modal title and button
            modalTitle.textContent = 'Ajouter un Article';
            submitButton.textContent = 'Ajouter';

            // Reset image requirement
            if (imageInput) {
                imageInput.setAttribute('required', '');
            }

            // Restore scrolling
            document.body.style.overflow = '';

            // Reset image preview
            if (imagePreview && noImagePreview) {
                imagePreview.src = '';
                imagePreview.style.display = 'none';
                noImagePreview.style.display = 'block';
            }
            lastImageUrl = '';
        }

        // Initialize all event listeners when the DOM is loaded
        document.addEventListener('DOMContentLoaded', function () {
            // Modal buttons
            const addItemBtn = document.getElementById('addItemBtn');
            const addFirstItemBtn = document.getElementById('addFirstItemBtn');
            const closeModalBtn = document.getElementById('closeModalBtn');
            const submitMenuItemBtn = document.getElementById('submitMenuItemBtn');
            const cancelModalBtn = document.getElementById('cancelModalBtn');
            const modal = document.getElementById('menuItemModal');
            const menuItemForm = document.getElementById('menuItemForm');

            // Add item buttons
            if (addItemBtn) {
                addItemBtn.addEventListener('click', openModal);
            }
            if (addFirstItemBtn) {
                addFirstItemBtn.addEventListener('click', openModal);
            }

            // Modal buttons
            if (closeModalBtn) {
                closeModalBtn.addEventListener('click', closeModal);
            }
            if (submitMenuItemBtn) {
                submitMenuItemBtn.addEventListener('click', submitMenuItem);
            }
            if (cancelModalBtn) {
                cancelModalBtn.addEventListener('click', closeModal);
            }

            // Modal outside click
            if (modal) {
                modal.addEventListener('click', function (e) {
                    if (e.target === this) {
                        closeModal();
                    }
                });
            }

            // Escape key
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') {
                    closeModal();
                }
            });

            // Prevent form submission on Enter
            if (menuItemForm) {
                menuItemForm.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter' && e.target.tagName !== 'TEXTAREA') {
                        e.preventDefault();
                    }
                });
            }

            // Menu item actions
            document.querySelectorAll('.edit-btn').forEach(btn => {
                btn.addEventListener('click', function () {
                    const itemId = this.dataset.id;
                    if (itemId) {
                        editMenuItem(itemId);
                    }
                });
            });

            document.querySelectorAll('.delete-btn').forEach(btn => {
                btn.addEventListener('click', function () {
                    const itemId = this.dataset.id;
                    const itemName = this.dataset.name;
                    if (itemId && itemName) {
                        confirmDeleteMenuItem(itemId, itemName);
                    }
                });
            });

            // Search and filter functionality
            const searchInput = document.getElementById('menuSearch');
            const categoryFilter = document.getElementById('categoryFilter');
            const sortFilter = document.getElementById('sortFilter');

            if (searchInput) {
                searchInput.addEventListener('input', filterAndSortItems);
            }
            if (categoryFilter) {
                categoryFilter.addEventListener('change', filterAndSortItems);
            }
            if (sortFilter) {
                sortFilter.addEventListener('change', filterAndSortItems);
            }

            // Image preview logic
            const imageInput = document.getElementById('image');
            const imagePreview = document.getElementById('imagePreview');
            const noImagePreview = document.getElementById('noImagePreview');

            if (imageInput) {
                imageInput.addEventListener('input', function (e) {
                    const file = e.target.files && e.target.files[0];
                    if (file) {
                        const url = URL.createObjectURL(file);
                        imagePreview.src = url;
                        imagePreview.style.display = 'block';
                        noImagePreview.style.display = 'none';
                        // Revoke the object URL after the image loads to avoid memory leaks
                        imagePreview.onload = function () {
                            URL.revokeObjectURL(url);
                        };
                    } else {
                        // If no file is selected, revert to the original image
                        if (lastImageUrl) {
                            imagePreview.src = lastImageUrl;
                            imagePreview.style.display = 'block';
                            noImagePreview.style.display = 'none';
                        } else {
                            imagePreview.src = '';
                            imagePreview.style.display = 'none';
                            noImagePreview.style.display = 'block';
                        }
                    }
                });
            }
        });

        function initializeSearchAndFilter() {
            const searchInput = document.getElementById('menuSearch');
            const categoryFilter = document.getElementById('categoryFilter');
            const sortFilter = document.getElementById('sortFilter');
            const menuItems = document.querySelectorAll('.menu-item-card');

            if (searchInput && categoryFilter && sortFilter) {
                searchInput.addEventListener('input', () => filterAndSortItems());
                categoryFilter.addEventListener('change', () => filterAndSortItems());
                sortFilter.addEventListener('change', () => filterAndSortItems());
            }
        }

        function filterAndSortItems() {
            const searchInput = document.getElementById('menuSearch');
            const categoryFilter = document.getElementById('categoryFilter');
            const sortFilter = document.getElementById('sortFilter');
            const menuItemsContainer = document.querySelector('.menu-grid');
            const menuItems = Array.from(document.querySelectorAll('.menu-item-card'));

            if (!searchInput || !categoryFilter || !sortFilter || !menuItemsContainer) return;

            const searchTerm = searchInput.value.toLowerCase();
            const selectedCategory = categoryFilter.value;
            const sortValue = sortFilter.value;

            // Filter items
            const filteredItems = menuItems.filter(item => {
                const name = item.querySelector('.menu-item-name').textContent.toLowerCase();
                const description = item.querySelector('.menu-item-description').textContent.toLowerCase();
                const category = item.dataset.category;

                const matchesSearch = name.includes(searchTerm) || description.includes(searchTerm);
                const matchesCategory = selectedCategory === '' || category === selectedCategory;

                if (matchesSearch && matchesCategory) {
                    item.style.display = 'block'; // Or 'flex' depending on your card design, but 'block' works for div
                    return true;
                } else {
                    item.style.display = 'none';
                    return false;
                }
            });

            // Sort visible items
            const sortedItems = filteredItems.sort((a, b) => {
                const nameA = a.querySelector('.menu-item-name').textContent.trim();
                const nameB = b.querySelector('.menu-item-name').textContent.trim();

                // Extract price numbers safely
                const priceAStr = a.querySelector('.menu-item-price').textContent.replace(/[^\d.,]/g, '').replace(',', '.');
                const priceBStr = b.querySelector('.menu-item-price').textContent.replace(/[^\d.,]/g, '').replace(',', '.');
                const priceA = parseFloat(priceAStr) || 0;
                const priceB = parseFloat(priceBStr) || 0;

                const categoryA = a.dataset.category;
                const categoryB = b.dataset.category;

                switch (sortValue) {
                    case 'name':
                        return nameA.localeCompare(nameB);
                    case 'price-asc':
                        return priceA - priceB;
                    case 'price-desc':
                        return priceB - priceA;
                    case 'category':
                        return categoryA.localeCompare(categoryB);
                    default:
                        return 0;
                }
            });

            // Reorder DOM elements
            // We only append the sorted ones. The hidden ones stay in the DOM but display:none.
            // To ensure correct visual order, we can re-append all items (filtered ones first).
            // Actually, simplest is to re-append sortedItems. The hidden ones are still children but hidden.
            // Wait, if we only append sortedItems, the hidden items might end up at the top or bottom or mixed?
            // `appendChild` moves the node. So if we iterate through sortedItems and append them, they will move to the end in that order.
            // The hidden items that were NOT in sortedItems? They remain where they were, or effectively at the top if we moved everything else to the bottom?
            // To be safe, we can just re-append them all. But `sortedItems` is just the visible ones.

            // Better strategy: Clear container and append sortedItems? No, that kills event listeners if elements were recreated (but we are moving nodes, so listeners persist).
            // But we missed the hidden items. 
            // Let's filter `menuItems` (all items) into two groups: visible (sorted) and hidden.
            // But `filteredItems` only contains visible ones.

            // Actually, we just want to show/hide. Sorting requires reordering.
            // Let's just re-append the sorted visible items. The hidden items can stay where they are (effectively invisible).
            // IF the grid layout is sensitive to hidden elements, this might be an issue. But typically `display: none` elements don't affect layout.
            // However, for the order to be correct visually, the visible items must be in the correct order relative to EACH OTHER.

            sortedItems.forEach(item => menuItemsContainer.appendChild(item));
        }

        async function editMenuItem(id) {
            try {
                const query = `
                    query {
                        menuItem(id: "${id}") {
                            id
                            name
                            description
                            price
                            category
                            imageUrl
                        }
                    }
                `;

                const response = await fetch("/graphql", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                    },
                    body: JSON.stringify({ query }),
                });

                const result = await response.json();

                if (result.errors) {
                    throw new Error(result.errors[0].message);
                }

                if (!result.data || !result.data.menuItem) {
                    throw new Error("No menu item data returned from server");
                }

                openEditMenuItemModal(result.data.menuItem);
            } catch (error) {
                console.error("Error fetching menu item:", error);
                alert("Erreur lors du chargement des données de l'article. Veuillez réessayer.");
            }
        }

        function openEditMenuItemModal(menuItem) {
            try {
                const modal = document.getElementById('menuItemModal');
                const form = document.getElementById('menuItemForm');
                const modalTitle = modal.querySelector('.modal-header h2');
                const submitButton = modal.querySelector('#submitMenuItemBtn');
                const imageInput = document.getElementById('image');
                const imagePreview = document.getElementById('imagePreview');
                const noImagePreview = document.getElementById('noImagePreview');

                if (!modal || !form || !modalTitle || !submitButton) {
                    console.error('Required modal elements not found');
                    return;
                }

                // Set form mode and ID
                form.setAttribute('data-mode', 'edit');
                form.setAttribute('data-id', menuItem.id);

                // Update modal title and button
                modalTitle.textContent = 'Modifier l\'Article';
                submitButton.textContent = 'Mettre à jour';

                // Fill form fields
                document.getElementById('name').value = menuItem.name || '';
                document.getElementById('description').value = menuItem.description || '';
                document.getElementById('price').value = menuItem.price || '';

                // Populate and select category
                populateCategoriesByType();
                const categorySelect = document.getElementById('category');
                if (categorySelect && menuItem.category) {
                    for (let i = 0; i < categorySelect.options.length; i++) {
                        if (categorySelect.options[i].value === menuItem.category) {
                            categorySelect.selectedIndex = i;
                            break;
                        }
                    }
                }

                // Make image optional for edits
                if (imageInput) {
                    imageInput.removeAttribute('required');
                    imageInput.value = '';
                }

                // Show current image in preview and set lastImageUrl
                if (imagePreview && noImagePreview) {
                    if (menuItem.imageUrl) {
                        imagePreview.src = menuItem.imageUrl;
                        imagePreview.style.display = 'block';
                        noImagePreview.style.display = 'none';
                        lastImageUrl = menuItem.imageUrl;
                    } else {
                        imagePreview.src = '';
                        imagePreview.style.display = 'none';
                        noImagePreview.style.display = 'block';
                        lastImageUrl = '';
                    }
                }

                // Show modal
                modal.style.display = 'flex';
                requestAnimationFrame(() => {
                    modal.classList.add('show');
                });
                document.body.style.overflow = 'hidden';
            } catch (error) {
                console.error('Error in openEditMenuItemModal:', error);
                alert('Une erreur est survenue lors de l\'ouverture du formulaire de modification.');
            }
        }

        function confirmDeleteMenuItem(id, name) {
            if (confirm(`Êtes-vous sûr de vouloir supprimer l'article "${name}"?`)) {
                deleteMenuItem(id);
            }
        }

        async function deleteMenuItem(id) {
            const query = `
                mutation {
                    deleteMenuItem(id: "${id}")
                }
            `;

            try {
                const response = await fetch("/graphql", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                    },
                    body: JSON.stringify({ query }),
                });

                const result = await response.json();
                if (result.errors) {
                    alert("Erreur lors de la suppression de l'article: " + result.errors[0].message);
                    return;
                }

                alert("Article supprimé avec succès!");
                window.location.reload();
            } catch (error) {
                console.error("Error:", error);
                alert("Une erreur s'est produite lors de la suppression de l'article. Veuillez réessayer.");
            }
        }

        async function submitMenuItem() {
            const restaurantId = "<%= restaurant.id %>";
            const form = document.getElementById("menuItemForm");
            const formData = new FormData(form);

            const mode = form.getAttribute("data-mode") || "add";
            const menuItemId = form.getAttribute("data-id") || "";
            const imageFile = formData.get("image");

            let imageUrl = "";
            if (imageFile && imageFile.size > 0) {
                try {
                    const formDataUpload = new FormData();
                    formDataUpload.append("image", imageFile);

                    const uploadResponse = await fetch("/storage/upload", {
                        method: "POST",
                        body: formDataUpload,
                    });
                    const uploadResult = await uploadResponse.json();

                    if (uploadResponse.ok && uploadResult.publicUrl) {
                        imageUrl = uploadResult.publicUrl;
                    } else {
                        throw new Error("Image upload failed");
                    }
                } catch (error) {
                    console.error("Error uploading image:", error);
                    alert("Error uploading image. Please try again.");
                    return;
                }
            }

            const input = {
                name: formData.get("name"),
                description: formData.get("description"),
                price: parseFloat(formData.get("price")),
                category: formData.get("category"),
                ...(imageUrl && { imageUrl })
            };

            let query;
            let variables;

            if (mode === "add") {
                query = `
                    mutation AddMenuItem($input: AddMenuItemInput!) {
                        addMenuItem(input: $input) {
                            id
                            name
                        }
                    }
                `;
                variables = {
                    input: {
                        ...input,
                        restaurantId
                    }
                };
            } else {
                query = `
                    mutation UpdateMenuItem($id: ID!, $input: UpdateMenuItemInput!) {
                        updateMenuItem(id: $id, input: $input) {
                            id
                            name
                        }
                    }
                `;
                variables = {
                    id: menuItemId,
                    input
                };
            }

            try {
                const response = await fetch("/graphql", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                    },
                    body: JSON.stringify({ query, variables }),
                });

                const result = await response.json();
                if (result.errors) {
                    throw new Error(result.errors[0].message);
                }

                if (!result.data || (!result.data.addMenuItem && !result.data.updateMenuItem)) {
                    throw new Error("No menu item data returned from server");
                }

                alert("Article " + (mode === "add" ? "ajouté" : "mis à jour") + " avec succès!");
                window.location.reload();
            } catch (error) {
                console.error("Error submitting menu item:", error);
                alert("Erreur lors de la soumission de l'article. Veuillez réessayer plus tard. Details: " + error.message);
            }
        }
    </script>
</body>

</html>