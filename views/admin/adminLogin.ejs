<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Login - Gourmet d'amour</title>
    <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Poppins:wght@300;400;600&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <style>
        :root {
            --primary-color: #DB607E;
            --secondary-color: #ABD27E;
            --accent-color: #b22222;
            --background-color: #f9f5f0;
            --dark-color: #2c2c2c;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: var(--background-color);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .login-container {
            background: white;
            padding: 40px;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            width: 100%;
            max-width: 450px;
            animation: fadeIn 1s ease-out;
        }

        .login-header {
            text-align: center;
            margin-bottom: 30px;
        }

        .login-header h1 {
            font-family: 'Playfair Display', serif;
            color: var(--primary-color);
            font-size: 2.5rem;
            margin-bottom: 10px;
        }

        .login-header p {
            color: var(--dark-color);
            font-size: 1rem;
        }

        .form-group {
            margin-bottom: 25px;
        }

        .form-group label {
            display: block;
            color: var(--dark-color);
            margin-bottom: 8px;
            font-weight: 500;
        }

        .form-group input {
            width: 100%;
            padding: 12px 15px;
            border: 2px solid #eee;
            border-radius: 8px;
            font-size: 1rem;
            transition: border-color 0.3s ease;
        }

        .form-group input:focus {
            outline: none;
            border-color: var(--primary-color);
        }

        .login-button {
            width: 100%;
            padding: 15px;
            background: linear-gradient(45deg, var(--primary-color), #c44d68);
            color: white;
            border: none;
            border-radius: 30px;
            font-size: 1.1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 5px 15px rgba(219, 96, 126, 0.2);
        }

        .login-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(219, 96, 126, 0.3);
        }

        .back-link {
            display: block;
            text-align: center;
            margin-top: 20px;
            color: var(--dark-color);
            text-decoration: none;
            font-size: 0.9rem;
        }

        .back-link:hover {
            color: var(--primary-color);
        }

        .error-message {
            color: var(--accent-color);
            background-color: #ffebee;
            padding: 10px;
            border-radius: 8px;
            margin-bottom: 20px;
            display: none;
            text-align: center;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .switch-login-btn {
            display: block;
            width: 100%;
            padding: 15px;
            background-color: transparent;
            color: var(--primary-color);
            border: 2px solid var(--primary-color);
            border-radius: 30px;
            font-size: 1.1rem;
            font-weight: 600;
            cursor: pointer;
            text-align: center;
            text-decoration: none;
            margin-top: 15px;
            transition: all 0.3s ease;
        }

        .switch-login-btn:hover {
            background-color: var(--primary-color);
            color: white;
            box-shadow: 0 5px 15px rgba(219, 96, 126, 0.2);
        }
    </style>
</head>

<body>
    <div class="login-container">
        <div class="login-header">
            <h1>Gourmet d'amour</h1>
            <p>Administration</p>
        </div>

        <% if (locals.error_msg && locals.error_msg.length> 0) { %>
            <div class="error-message" style="display: block;">
                <%= error_msg %>
            </div>
            <% } %>

                <% if (locals.error && locals.error.length> 0) { %>
                    <div class="error-message" style="display: block;">
                        <%= error %>
                    </div>
                    <% } %>

                        <% if (typeof errors !=='undefined' && errors.length> 0) { %>
                            <div class="error-message" style="display: block; text-align: left;">
                                <ul style="list-style-type: none; padding-left: 0;">
                                    <% errors.forEach(function(err) { %>
                                        <li style="margin-bottom: 5px;"><i class="fas fa-exclamation-circle"
                                                style="margin-right: 5px;"></i>
                                            <%= err.msg %>
                                        </li>
                                        <% }); %>
                                </ul>
                            </div>
                            <% } %>

                                <form id="loginForm" action="/admin/login" method="POST">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <div class="form-group">
                                        <label for="phoneNumber">Numéro de téléphone</label>
                                        <input type="text" id="phoneNumber" name="phoneNumber"
                                            placeholder="Entrez votre numéro de téléphone"
                                            value="<%= typeof phoneNumber !== 'undefined' ? phoneNumber : '' %>"
                                            required />
                                    </div>
                                    <div class="form-group">
                                        <label for="password">Mot de passe</label>
                                        <input type="password" id="password" name="password"
                                            placeholder="Entrez votre mot de passe" required />
                                    </div>
                                    <button type="submit" class="login-button">Se connecter</button>
                                </form>
                                <a href="/admin/login/restaurant" class="switch-login-btn">Se connecter en tant que
                                    vendeur</a>
                                <a href="/" class="back-link">Retour à l'accueil</a>
    </div>

    <!-- Script removed as we use standard form submission now -->
</body>

</html>