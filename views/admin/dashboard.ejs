<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard</title>
    <link
      href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css"
      rel="stylesheet"
    />
  </head>
  <body class="bg-gray-100 min-h-screen">
    <header class="bg-blue-600 p-4 text-white text-center">
      <h1 class="text-3xl font-bold">Admin Dashboard</h1>
    </header>

    <main class="container mx-auto p-6">
      <!-- Stats Section -->
      <h2 class="text-2xl font-semibold text-gray-700 mb-6">Overview</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-10">
        <!-- Total Orders -->
        <div
          class="bg-blue-50 p-6 rounded-lg shadow-lg flex flex-col items-center"
        >
          <h3 class="text-lg font-semibold text-blue-700 mb-2">Total Orders</h3>
          <p class="text-4xl font-extrabold text-blue-700">
            <%= totalOrders || 0 %>
          </p>
        </div>

        <!-- Active Restaurants -->
        <div
          class="bg-green-50 p-6 rounded-lg shadow-lg flex flex-col items-center"
        >
          <h3 class="text-lg font-semibold text-green-700 mb-2">
            Active Restaurants
          </h3>
          <p class="text-4xl font-extrabold text-green-700">
            <%= totalRestaurants || 0 %>
          </p>
        </div>

        <!-- Active Deliverers -->
        <div
          class="bg-yellow-50 p-6 rounded-lg shadow-lg flex flex-col items-center"
        >
          <h3 class="text-lg font-semibold text-yellow-700 mb-2">
            Active Deliverers
          </h3>
          <p class="text-4xl font-extrabold text-yellow-700">
            <%= totalDeliverers || 0 %>
          </p>
        </div>
      </div>

      <!-- Monthly Orders Chart -->
      <div class="bg-white p-8 rounded-lg shadow-lg">
        <h3 class="text-xl font-semibold text-gray-800 mb-4">Monthly Orders</h3>
        <canvas id="monthlyOrdersChart"></canvas>
      </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
      const fetchDashboardData = async () => {
        try {
          const token = localStorage.getItem("authToken");
          if (!token) {
            alert("Please log in.");
            window.location.href = "/admin/login";
            return;
          }

          const response = await fetch("/admin/dashboard", {
            method: "GET",
            headers: {
              Authorization: `Bearer ${token}`,
              "Content-Type": "application/json",
            },
          });

          const data = await response.json();
          if (!response.ok) {
            console.error("Error fetching dashboard data:", data.error);
            alert(data.error || "Failed to fetch dashboard data.");
            return;
          }

          // Populate the dashboard stats
          document.getElementById("totalOrders").textContent =
            data.totalOrders || 0;
          document.getElementById("activeRestaurants").textContent =
            data.totalRestaurants || 0;
          document.getElementById("activeDeliverers").textContent =
            data.totalDeliverers || 0;
          document.getElementById("totalRevenue").textContent = `$${(
            data.totalRevenue || 0
          ).toFixed(2)}`;

          // Render the chart
          const ctx = document
            .getElementById("monthlyOrdersChart")
            .getContext("2d");
          new Chart(ctx, {
            type: "bar",
            data: {
              labels: data.monthlyOrders.map((item) => item.month),
              datasets: [
                {
                  label: "Orders",
                  data: data.monthlyOrders.map((item) => item.orders),
                  backgroundColor: "rgba(75, 192, 192, 0.5)",
                  borderColor: "rgba(75, 192, 192, 1)",
                  borderWidth: 1,
                },
              ],
            },
            options: {
              plugins: {
                legend: {
                  display: false,
                },
              },
              scales: {
                x: {
                  title: {
                    display: true,
                    text: "Month",
                    color: "#333",
                    font: {
                      size: 14,
                    },
                  },
                },
                y: {
                  beginAtZero: true,
                  title: {
                    display: true,
                    text: "Number of Orders",
                    color: "#333",
                    font: {
                      size: 14,
                    },
                  },
                },
              },
            },
          });
        } catch (error) {
          console.error("Error fetching dashboard data:", error);
          alert("An error occurred. Please try again.");
        }
      };

      // Fetch dashboard data on page load
      window.onload = fetchDashboardData;
    </script>
  </body>
</html>
