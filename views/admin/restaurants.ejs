<!DOCTYPE html>
<html lang="fr">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="csrf-token" content="<%= csrfToken %>" />
  <title>Restaurants - Gourmet d'amour</title>
  <link
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Poppins:wght@300;400;600&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <style>
    :root {
      --primary-color: #DB607E;
      --secondary-color: #ABD27E;
      --accent-color: #b22222;
      --background-color: #f9f5f0;
      --dark-color: #2c2c2c;
      --card-shadow: 0 10px 20px rgba(0, 0, 0, 0.05);
      --transition-speed: 0.3s;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Poppins', sans-serif;
      background-color: var(--background-color);
      min-height: 100vh;
      padding: 2rem;
    }

    .container {
      max-width: 1400px;
      margin: 0 auto;
    }

    header {
      background: linear-gradient(rgba(0, 0, 0, 0.8), rgba(0, 0, 0, 0.8)), url('https://images.unsplash.com/photo-1601628828688-632f38a5a7d0?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1920&q=80');
      background-size: cover;
      background-position: center;
      background-attachment: fixed;
      padding: 3rem 2rem;
      text-align: center;
      color: white;
      margin-bottom: 2rem;
      border-radius: 20px;
      position: relative;
      overflow: hidden;
    }

    header::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: linear-gradient(45deg, rgba(219, 96, 126, 0.2), rgba(171, 210, 126, 0.2));
      z-index: 1;
    }

    header h1 {
      font-family: 'Playfair Display', serif;
      font-size: 3rem;
      margin-bottom: 1rem;
      color: var(--primary-color);
      position: relative;
      z-index: 2;
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
      animation: fadeInDown 1s ease-out;
    }

    header p {
      font-size: 1.2rem;
      margin-bottom: 2rem;
      position: relative;
      z-index: 2;
      animation: fadeInUp 1s ease-out;
    }

    .nav-links {
      display: flex;
      justify-content: center;
      gap: 1.5rem;
      margin-top: 2rem;
      position: relative;
      z-index: 2;
    }

    .nav-link {
      color: white;
      text-decoration: none;
      padding: 0.8rem 1.5rem;
      border-radius: 30px;
      transition: all var(--transition-speed) ease;
      background: rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(5px);
      border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .nav-link:hover {
      background: rgba(255, 255, 255, 0.2);
      transform: translateY(-2px);
    }

    .add-restaurant-btn {
      background: linear-gradient(45deg, var(--primary-color), #c44d68);
      color: white;
      padding: 1rem 2rem;
      border: none;
      border-radius: 30px;
      font-size: 1.1rem;
      font-weight: 600;
      cursor: pointer;
      transition: all var(--transition-speed) ease;
      margin-bottom: 2rem;
      display: inline-flex;
      align-items: center;
      gap: 0.8rem;
      box-shadow: var(--card-shadow);
    }

    .add-restaurant-btn:hover {
      transform: translateY(-3px);
      box-shadow: 0 15px 30px rgba(219, 96, 126, 0.2);
    }

    .restaurants-section {
      background: white;
      padding: 2.5rem;
      border-radius: 20px;
      box-shadow: var(--card-shadow);
      transition: all var(--transition-speed) ease;
    }

    .restaurants-section:hover {
      box-shadow: 0 15px 30px rgba(0, 0, 0, 0.1);
    }

    .search-container {
      margin-bottom: 2rem;
    }

    .search-container input {
      width: 100%;
      max-width: 400px;
      padding: 1rem 1.5rem;
      border: 2px solid #eee;
      border-radius: 30px;
      font-size: 1rem;
      transition: all var(--transition-speed) ease;
      background: var(--background-color);
    }

    .search-container input:focus {
      outline: none;
      border-color: var(--primary-color);
      box-shadow: 0 0 0 3px rgba(219, 96, 126, 0.1);
    }

    .restaurants-table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      margin-top: 1rem;
    }

    .restaurants-table th {
      background-color: var(--background-color);
      padding: 1.2rem;
      text-align: left;
      font-weight: 600;
      color: var(--dark-color);
      border-bottom: 2px solid var(--primary-color);
    }

    .restaurants-table td {
      padding: 1.2rem;
      border-bottom: 1px solid #eee;
      color: var(--dark-color);
      transition: all var(--transition-speed) ease;
    }

    .restaurants-table tr {
      transition: all var(--transition-speed) ease;
    }

    .restaurants-table tr:hover {
      background-color: var(--background-color);
      transform: translateY(-2px);
      box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
      cursor: pointer;
    }

    .restaurant-image {
      width: 70px;
      height: 70px;
      object-fit: cover;
      border-radius: 10px;
      transition: all var(--transition-speed) ease;
    }

    .restaurants-table tr:hover .restaurant-image {
      transform: scale(1.1);
    }

    .status-badge {
      padding: 0.5rem 1rem;
      border-radius: 20px;
      font-size: 0.85rem;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }

    .status-active {
      background: #d1e7dd;
      color: #0f5132;
    }

    .status-inactive {
      background: #f8d7da;
      color: #842029;
    }

    .action-buttons {
      display: flex;
      gap: 1rem;
    }

    .action-btn {
      background: none;
      border: none;
      cursor: pointer;
      font-size: 1.2rem;
      transition: all var(--transition-speed) ease;
      padding: 0.5rem;
      border-radius: 50%;
    }

    .view-btn {
      color: var(--primary-color);
    }

    .edit-btn {
      color: var(--secondary-color);
    }

    .delete-btn {
      color: var(--accent-color);
    }

    .action-btn:hover {
      transform: translateY(-2px);
      background: rgba(0, 0, 0, 0.05);
    }

    .pagination-controls {
      margin-top: 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1rem;
      background: var(--background-color);
      border-radius: 15px;
    }

    .pagination-buttons {
      display: flex;
      gap: 1rem;
      align-items: center;
    }

    .pagination-buttons button {
      padding: 0.8rem 1.5rem;
      border: none;
      border-radius: 30px;
      font-weight: 600;
      cursor: pointer;
      transition: all var(--transition-speed) ease;
    }

    .pagination-buttons button:hover:not(:disabled) {
      transform: translateY(-2px);
    }

    .pagination-buttons button:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    @keyframes fadeInDown {
      from {
        opacity: 0;
        transform: translateY(-20px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @media (max-width: 768px) {
      body {
        padding: 1rem;
      }

      header {
        padding: 2rem 1rem;
      }

      header h1 {
        font-size: 2.5rem;
      }

      .restaurants-table {
        display: block;
        overflow-x: auto;
      }

      .pagination-controls {
        flex-direction: column;
        gap: 1rem;
        text-align: center;
      }
    }

    /* Modal Styles */
    .modal {
      position: fixed;
      inset: 0;
      background-color: rgba(0, 0, 0, 0.7);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 1000;
      backdrop-filter: blur(5px);
      transition: all var(--transition-speed) ease;
    }

    .modal.show {
      display: flex;
      animation: fadeIn 0.3s ease-out;
    }

    .modal-content {
      background: white;
      padding: 2.5rem;
      border-radius: 20px;
      width: 90%;
      max-width: 800px;
      max-height: 90vh;
      overflow-y: auto;
      position: relative;
      box-shadow: var(--card-shadow);
      transform: translateY(0);
      transition: all var(--transition-speed) ease;
    }

    .modal-header {
      margin-bottom: 2rem;
      position: relative;
    }

    .modal-header h2 {
      font-family: 'Playfair Display', serif;
      font-size: 2rem;
      color: var(--dark-color);
      margin-bottom: 0.5rem;
    }

    .form-group {
      margin-bottom: 1.8rem;
    }

    .form-group label {
      display: block;
      margin-bottom: 0.8rem;
      color: var(--dark-color);
      font-weight: 500;
      font-size: 1.1rem;
    }

    .form-control {
      width: 100%;
      padding: 1rem 1.2rem;
      border: 2px solid #eee;
      border-radius: 12px;
      font-size: 1rem;
      transition: all var(--transition-speed) ease;
      background: var(--background-color);
    }

    .form-control:focus {
      outline: none;
      border-color: var(--primary-color);
      box-shadow: 0 0 0 3px rgba(219, 96, 126, 0.1);
    }

    .opening-hours-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 1.5rem;
      margin-top: 1rem;
    }

    .time-inputs {
      display: flex;
      gap: 1rem;
    }

    .time-inputs input {
      flex: 1;
      padding: 0.8rem;
      border: 2px solid #eee;
      border-radius: 12px;
      font-size: 1rem;
      transition: all var(--transition-speed) ease;
    }

    .time-inputs input:focus {
      outline: none;
      border-color: var(--primary-color);
      box-shadow: 0 0 0 3px rgba(219, 96, 126, 0.1);
    }

    .modal-buttons {
      display: flex;
      gap: 1.5rem;
      margin-top: 2.5rem;
    }

    .modal-btn {
      flex: 1;
      padding: 1rem 2rem;
      border: none;
      border-radius: 30px;
      font-size: 1.1rem;
      font-weight: 600;
      cursor: pointer;
      transition: all var(--transition-speed) ease;
    }

    .submit-btn {
      background: linear-gradient(45deg, var(--primary-color), #c44d68);
      color: white;
      box-shadow: var(--card-shadow);
    }

    .cancel-btn {
      background: var(--background-color);
      color: var(--dark-color);
    }

    .modal-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
    }

    .close-modal {
      position: absolute;
      top: 1.5rem;
      right: 1.5rem;
      background: none;
      border: none;
      font-size: 1.8rem;
      color: var(--dark-color);
      cursor: pointer;
      transition: all var(--transition-speed) ease;
      width: 40px;
      height: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
    }

    .close-modal:hover {
      background: var(--background-color);
      color: var(--primary-color);
      transform: rotate(90deg);
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
      }

      to {
        opacity: 1;
      }
    }

    @media (max-width: 768px) {
      .modal-content {
        padding: 2rem 1.5rem;
      }

      .opening-hours-grid {
        grid-template-columns: 1fr;
      }

      .modal-buttons {
        flex-direction: column;
      }

      .modal-btn {
        width: 100%;
      }
    }
  </style>
</head>

<body>
  <div class="container">
    <header>
      <h1>Gourmet d'amour</h1>
      <p>Gestion des Restaurants</p>
      <div class="nav-links">
        <a href="/admin/dashboard" class="nav-link">
          <i class="fa-solid fa-chart-line"></i> Tableau de Bord
        </a>
        <a href="/admin/deliverers" class="nav-link">
          <i class="fa-solid fa-truck"></i> Livreurs
        </a>
        <a href="/" class="nav-link">
          <i class="fa-solid fa-house"></i> Accueil
        </a>
        <a href="/admin/logout" class="nav-link" style="background-color: var(--accent-color);">
          <i class="fas fa-sign-out-alt"></i> Déconnexion
        </a>
      </div>
    </header>

    <button id="addRestaurantBtn" class="add-restaurant-btn">
      <i class="fas fa-plus"></i> Ajouter un Restaurant
    </button>

    <div class="restaurants-section">
      <div class="search-container" style="margin-bottom: 1rem;">
        <input type="text" id="searchInput" class="form-control" placeholder="Rechercher un restaurant..."
          style="max-width: 300px;">
      </div>
      <table class="restaurants-table">
        <thead>
          <tr>
            <th>Image</th>
            <th>Nom</th>
            <th>Adresse</th>
            <th>Type</th>
            <th>Statut</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (restaurants && restaurants.length> 0) { %>
            <% restaurants.forEach((restaurant)=> { %>
              <tr data-restaurant-id="<%= restaurant.id %>">
                <td>
                  <img
                    src="<%= restaurant.hero_image || restaurant.image_url || restaurant.imageUrl || 'https://placehold.co/600x400?text=No+Image' %>"
                    alt="<%= restaurant.name %>" class="restaurant-image" />
                </td>
                <td>
                  <%= restaurant.name %>
                </td>
                <td>
                  <%= restaurant.address %>
                </td>
                <td>
                  <%= restaurant.type %>
                </td>
                <td>
                  <span
                    class="status-badge <%= (restaurant.isActive || restaurant.is_active) ? 'status-active' : 'status-inactive' %>">
                    <i
                      class="fas fa-<%= (restaurant.isActive || restaurant.is_active) ? 'check-circle' : 'times-circle' %>"></i>
                    <%= (restaurant.isActive || restaurant.is_active) ? "Actif" : "Inactif" %>
                  </span>
                </td>
                <td>
                  <div class="action-buttons">
                    <a href="/admin/restaurants/<%= restaurant.id %>/details" class="action-btn view-btn"
                      title="Voir les détails">
                      <i class="fas fa-eye"></i>
                    </a>
                    <button class="action-btn edit-btn edit-restaurant-btn" data-restaurant-id="<%= restaurant.id %>"
                      title="Modifier">
                      <i class="fas fa-edit"></i>
                    </button>
                    <button class="action-btn delete-btn delete-restaurant-btn"
                      data-restaurant-id="<%= restaurant.id %>" data-restaurant-name="<%= restaurant.name %>"
                      title="Supprimer">
                      <i class="fas fa-trash"></i>
                    </button>
                  </div>
                </td>
              </tr>
              <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="6" class="text-center py-4 text-gray-500">
                      Aucun restaurant trouvé.
                    </td>
                  </tr>
                  <% } %>
        </tbody>
      </table>
      <div class="pagination-controls"
        style="margin-top: 1rem; display: flex; justify-content: space-between; align-items: center;">
        <div class="pagination-info">
          Affichage de <span id="startIndex">1</span> à <span id="endIndex">10</span> sur <span id="totalItems">0</span>
          restaurants
        </div>
        <div class="pagination-buttons">
          <button id="prevPage" class="modal-btn cancel-btn" style="padding: 0.5rem 1rem;">Précédent</button>
          <span id="currentPage" style="margin: 0 1rem;">Page 1</span>
          <button id="nextPage" class="modal-btn submit-btn" style="padding: 0.5rem 1rem;">Suivant</button>
        </div>
      </div>
    </div>

    <!-- Add/Edit Restaurant Modal -->
    <div id="restaurantModal" class="modal">
      <div class="modal-content">
        <button class="close-modal" id="closeModalBtn">&times;</button>
        <div class="modal-header">
          <h2 id="modalTitle">Ajouter un Restaurant</h2>
        </div>
        <form id="restaurantForm">
          <input type="hidden" id="restaurantId" name="restaurantId" />

          <div class="form-group">
            <label for="name">Nom</label>
            <input type="text" id="name" name="name" class="form-control" placeholder="Entrer le nom du restaurant"
              required />
          </div>

          <div class="form-group">
            <label for="description">Description</label>
            <textarea id="description" name="description" class="form-control"
              placeholder="Entrer la description du restaurant" rows="3" required></textarea>
          </div>

          <div class="form-group">
            <label for="address">Adresse</label>
            <input type="text" id="address" name="address" class="form-control"
              placeholder="Entrer l'adresse du restaurant" required />
          </div>

          <div class="form-group">
            <label for="latitude">Latitude</label>
            <input type="text" id="latitude" name="latitude" class="form-control" placeholder="Ex: 14.7167" required />
          </div>

          <div class="form-group">
            <label for="longitude">Longitude</label>
            <input type="text" id="longitude" name="longitude" class="form-control" placeholder="Ex: -17.4677"
              required />
          </div>

          <div class="form-group">
            <label for="type">Type</label>
            <select id="type" name="type" class="form-control" required>
              <option value="RESTAURANT">Restaurant</option>
              <option value="BOULANGERIE">Boulangerie</option>
              <option value="EXPRESS">Express</option>
            </select>
          </div>

          <div class="form-group">
            <label for="phoneNumber">Numéro de téléphone</label>
            <input type="text" id="phoneNumber" name="phoneNumber" class="form-control"
              placeholder="Entrer le numéro de téléphone" required />
          </div>

          <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" class="form-control" placeholder="Entrer l'adresse email"
              required />
          </div>

          <div class="form-group">
            <label for="image">Image</label>
            <input type="file" id="image" name="image" accept="image/*" class="form-control" required />
          </div>

          <div class="form-group">
            <label for="isActive">Statut</label>
            <select id="isActive" name="isActive" class="form-control" required>
              <option value="true">Actif</option>
              <option value="false">Inactif</option>
            </select>
          </div>

          <div class="form-group">
            <label>Heures d'ouverture</label>
            <div style="margin-bottom: 1rem;">
              <button type="button" id="setAllHoursBtn" class="modal-btn submit-btn" style="padding: 0.5rem 1rem;">
                <i class="fas fa-clock"></i> Définir les mêmes heures pour tous les jours
              </button>
            </div>
            <div class="opening-hours-grid">
              <% ['monday', 'tuesday' , 'wednesday' , 'thursday' , 'friday' , 'saturday' , 'sunday' ].forEach(day=> {
                const frenchDays = {
                monday: "Lundi",
                tuesday: "Mardi",
                wednesday: "Mercredi",
                thursday: "Jeudi",
                friday: "Vendredi",
                saturday: "Samedi",
                sunday: "Dimanche"
                };
                %>
                <div>
                  <label class="form-group-label">
                    <%= frenchDays[day] %>
                  </label>
                  <div class="time-inputs">
                    <input type="time" name="openingHours[<%= day %>][open]" class="form-control" required />
                    <input type="time" name="openingHours[<%= day %>][close]" class="form-control" required />
                  </div>
                </div>
                <% }); %>
            </div>
          </div>

          <div class="modal-buttons">
            <button type="button" id="submitButton" class="modal-btn submit-btn">
              Ajouter
            </button>
            <button type="button" id="cancelButton" class="modal-btn cancel-btn">
              Annuler
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script>
    let isEditMode = false;

    // Function to get CSRF token from cookie
    function getCSRFToken() {
      const name = '_csrf=';
      const decodedCookie = decodeURIComponent(document.cookie);
      const cookieArray = decodedCookie.split(';');
      for (let i = 0; i < cookieArray.length; i++) {
        let cookie = cookieArray[i];
        while (cookie.charAt(0) === ' ') {
          cookie = cookie.substring(1);
        }
        if (cookie.indexOf(name) === 0) {
          return cookie.substring(name.length, cookie.length);
        }
      }
      return '';
    }

    // Function to make GraphQL requests
    async function makeGraphQLRequest(query, variables = {}) {
      // We rely on the httpOnly cookie 'token' set by the server. 
      // The auth middleware checks cookies if the Authorization header is missing.

      const response = await fetch("/graphql", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "Accept": "application/json",
          "X-CSRF-Token": getCSRFToken()
        },
        body: JSON.stringify({ query, variables }),
      });

      if (!response.ok) {
        throw new Error(`HTTP error! Status: ${response.status}`);
      }

      const result = await response.json();
      if (result.errors) {
        throw new Error(result.errors[0].message);
      }

      return result.data;
    }

    // Function to set all hours at once
    function setAllHours() {
      const defaultOpen = prompt("Heure d'ouverture (format HH:MM):", "08:00");
      const defaultClose = prompt("Heure de fermeture (format HH:MM):", "22:00");

      if (defaultOpen && defaultClose) {
        const days = ['monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday'];
        days.forEach(day => {
          document.querySelector(`input[name="openingHours[${day}][open]"]`).value = defaultOpen;
          document.querySelector(`input[name="openingHours[${day}][close]"]`).value = defaultClose;
        });
      }
    }

    // Server-side pagination handling
    document.addEventListener('DOMContentLoaded', function () {
      const urlParams = new URLSearchParams(window.location.search);
      const currentPage = parseInt(urlParams.get('page')) || 1;
      const limit = parseInt(urlParams.get('limit')) || 10;
      const totalItems = parseInt('<%= pagination.totalCount %>');
      const totalPages = parseInt('<%= pagination.totalPages %>');

      // Update pagination UI
      const prevBtn = document.getElementById('prevPage');
      const nextBtn = document.getElementById('nextPage');
      const currentPageSpan = document.getElementById('currentPage');
      const startIndexSpan = document.getElementById('startIndex');
      const endIndexSpan = document.getElementById('endIndex');
      const totalItemsSpan = document.getElementById('totalItems');

      if (prevBtn) {
        prevBtn.disabled = currentPage <= 1;
        prevBtn.addEventListener('click', () => changePage(currentPage - 1));
      }
      if (nextBtn) {
        nextBtn.disabled = currentPage >= totalPages;
        nextBtn.addEventListener('click', () => changePage(currentPage + 1));
      }
      if (currentPageSpan) currentPageSpan.textContent = `Page ${currentPage} sur ${totalPages}`;

      const start = (currentPage - 1) * limit + 1;
      const end = Math.min(start + limit - 1, totalItems);

      if (startIndexSpan) startIndexSpan.textContent = totalItems > 0 ? start : 0;
      if (endIndexSpan) endIndexSpan.textContent = end;
      if (totalItemsSpan) totalItemsSpan.textContent = totalItems;

      // Search handling
      const searchInput = document.getElementById('searchInput');
      if (searchInput) {
        searchInput.value = urlParams.get('search') || '';
        let debounceTimer;
        searchInput.addEventListener('input', (e) => {
          clearTimeout(debounceTimer);
          debounceTimer = setTimeout(() => {
            const search = e.target.value;
            const newUrl = new URL(window.location);
            newUrl.searchParams.set('search', search);
            newUrl.searchParams.set('page', 1); // Reset to page 1 on search
            window.location.href = newUrl.toString();
          }, 500);
        });
      }
    });

    function changePage(newPage) {
      const newUrl = new URL(window.location);
      newUrl.searchParams.set('page', newPage);
      window.location.href = newUrl.toString();
    }

    // Open Modal for adding
    function openModal() {
      isEditMode = false;
      document.getElementById("modalTitle").textContent = "Ajouter un Restaurant";
      document.getElementById("submitButton").textContent = "Ajouter";
      document.getElementById("restaurantForm").reset();
      document.getElementById("restaurantId").value = "";
      document.getElementById("restaurantModal").classList.add("show");
    }

    // Modify editRestaurant function to use makeGraphQLRequest
    async function editRestaurant(id) {
      try {
        const query = `
          query {
            restaurant(id: "${id}") {
              id
              name
              description
              address
              latitude
              longitude
              type
              phoneNumber
              email
              imageUrl
              isActive
              openingHours {
                monday { open close }
                tuesday { open close }
                wednesday { open close }
                thursday { open close }
                friday { open close }
                saturday { open close }
                sunday { open close }
              }
            }
          }
        `;

        const result = await makeGraphQLRequest(query);
        openEditModal(result.restaurant);
      } catch (error) {
        console.error("Error fetching restaurant:", error);
        alert("Error loading restaurant data. Please try again.");
      }
    }

    // Open Modal for editing
    function openEditModal(restaurant) {
      try {
        isEditMode = true;
        console.log("Restaurant data:", restaurant);

        document.getElementById("modalTitle").textContent = "Modifier le Restaurant";
        document.getElementById("submitButton").textContent = "Mettre à jour";

        // Fill form with restaurant data
        document.getElementById("restaurantId").value = restaurant.id;
        document.getElementById("name").value = restaurant.name || "";
        document.getElementById("description").value = restaurant.description || "";
        document.getElementById("address").value = restaurant.address || "";
        document.getElementById("latitude").value = restaurant.latitude || "";
        document.getElementById("longitude").value = restaurant.longitude || "";
        document.getElementById("type").value = restaurant.type || "RESTAURANT";
        document.getElementById("phoneNumber").value = restaurant.phoneNumber || "";
        document.getElementById("email").value = restaurant.email || "";
        document.getElementById("isActive").value = (restaurant.isActive || false).toString();

        // Make image upload not required in edit mode
        document.getElementById("image").removeAttribute("required");

        // Fill opening hours if they exist
        if (restaurant.openingHours) {
          const days = ['monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday'];
          days.forEach(day => {
            if (restaurant.openingHours[day]) {
              document.querySelector(`input[name="openingHours[${day}][open]"]`).value = restaurant.openingHours[day].open || "";
              document.querySelector(`input[name="openingHours[${day}][close]"]`).value = restaurant.openingHours[day].close || "";
            }
          });
        }

        // Show the modal
        document.getElementById("restaurantModal").classList.add("show");
      } catch (error) {
        console.error("Error in openEditModal:", error);
        alert("Error opening edit modal. Please try again.");
      }
    }

    // Close Modal
    function closeModal() {
      document.getElementById("restaurantModal").classList.remove("show");
    }

    // Redirect to Restaurant Details
    function redirectToDetails(id) {
      window.location.href = `/admin/restaurants/${id}/details`;
    }

    // Modify submitRestaurant function to use makeGraphQLRequest
    async function submitRestaurant() {
      try {
        const form = document.getElementById("restaurantForm");
        const formData = new FormData(form);
        const restaurantId = formData.get("restaurantId");
        const latitudeValue = parseFloat(formData.get("latitude"));
        const longitudeValue = parseFloat(formData.get("longitude"));

        // NOTE: No need to check localStorage - admin uses httpOnly cookies
        // The cookies are automatically sent with fetch requests

        // Extract file input
        const imageFile = formData.get("image");

        // Upload the image to Supabase Storage if a new file was selected
        let imageUrl = "";
        if (imageFile && imageFile.size > 0) {
          try {
            const fileName = `restaurant-${Date.now()}-${imageFile.name}`;
            const storageUrl = "/storage/upload";

            const uploadResponse = await fetch(storageUrl, {
              method: "POST",
              headers: {
                'Accept': 'application/json',
                'X-CSRF-Token': getCSRFToken()
              },
              body: formData,
            });

            if (!uploadResponse.ok) {
              throw new Error(`HTTP error! Status: ${uploadResponse.status}`);
            }

            const uploadResult = await uploadResponse.json();
            if (uploadResult.publicUrl) {
              imageUrl = uploadResult.publicUrl;
            } else {
              throw new Error("Failed to upload image");
            }
          } catch (error) {
            console.error("Image upload failed:", error);
            alert("Image upload failed. Please try again.");
            return;
          }
        }

        const input = {
          name: formData.get("name") || "",
          description: formData.get("description") || "",
          address: formData.get("address") || "",
          latitude: Number.isNaN(latitudeValue) ? null : latitudeValue,
          longitude: Number.isNaN(longitudeValue) ? null : longitudeValue,
          type: (formData.get("type") || "RESTAURANT").toUpperCase(),
          phoneNumber: formData.get("phoneNumber") || "",
          email: formData.get("email") || "",
          isActive: formData.get("isActive") === "true",
          openingHours: {
            monday: {
              open: formData.get("openingHours[monday][open]") || "",
              close: formData.get("openingHours[monday][close]") || "",
            },
            tuesday: {
              open: formData.get("openingHours[tuesday][open]") || "",
              close: formData.get("openingHours[tuesday][close]") || "",
            },
            wednesday: {
              open: formData.get("openingHours[wednesday][open]") || "",
              close: formData.get("openingHours[wednesday][close]") || "",
            },
            thursday: {
              open: formData.get("openingHours[thursday][open]") || "",
              close: formData.get("openingHours[thursday][close]") || "",
            },
            friday: {
              open: formData.get("openingHours[friday][open]") || "",
              close: formData.get("openingHours[friday][close]") || "",
            },
            saturday: {
              open: formData.get("openingHours[saturday][open]") || "",
              close: formData.get("openingHours[saturday][close]") || "",
            },
            sunday: {
              open: formData.get("openingHours[sunday][open]") || "",
              close: formData.get("openingHours[sunday][close]") || "",
            },
          }
        };

        if (imageUrl) {
          input.imageUrl = imageUrl;
        }

        const latitudeField = input.latitude !== null ? `latitude: ${input.latitude},` : "";
        const longitudeField = input.longitude !== null ? `longitude: ${input.longitude},` : "";

        const query = isEditMode
          ? `
            mutation {
              updateRestaurant(id: "${restaurantId}", input: {
                name: "${input.name}",
                description: "${input.description}",
                address: "${input.address}",
                ${latitudeField}
                ${longitudeField}
                type: ${input.type},
                phoneNumber: "${input.phoneNumber}",
                email: "${input.email}",
                ${imageUrl ? `imageUrl: "${input.imageUrl}",` : ''}
                openingHours: {
                  monday: { open: "${input.openingHours.monday.open}", close: "${input.openingHours.monday.close}" }
                  tuesday: { open: "${input.openingHours.tuesday.open}", close: "${input.openingHours.tuesday.close}" }
                  wednesday: { open: "${input.openingHours.wednesday.open}", close: "${input.openingHours.wednesday.close}" }
                  thursday: { open: "${input.openingHours.thursday.open}", close: "${input.openingHours.thursday.close}" }
                  friday: { open: "${input.openingHours.friday.open}", close: "${input.openingHours.friday.close}" }
                  saturday: { open: "${input.openingHours.saturday.open}", close: "${input.openingHours.saturday.close}" }
                  sunday: { open: "${input.openingHours.sunday.open}", close: "${input.openingHours.sunday.close}" }
                }
              }) {
                id
                name
              }
            }
          `
          : `
            mutation {
              createRestaurant(input: {
                name: "${input.name}",
                description: "${input.description}",
                address: "${input.address}",
                ${latitudeField}
                ${longitudeField}
                type: ${input.type},
                phoneNumber: "${input.phoneNumber}",
                email: "${input.email}",
                imageUrl: "${input.imageUrl}",
                isActive: ${input.isActive},
                openingHours: {
                  monday: { open: "${input.openingHours.monday.open}", close: "${input.openingHours.monday.close}" }
                  tuesday: { open: "${input.openingHours.tuesday.open}", close: "${input.openingHours.tuesday.close}" }
                  wednesday: { open: "${input.openingHours.wednesday.open}", close: "${input.openingHours.wednesday.close}" }
                  thursday: { open: "${input.openingHours.thursday.open}", close: "${input.openingHours.thursday.close}" }
                  friday: { open: "${input.openingHours.friday.open}", close: "${input.openingHours.friday.close}" }
                  saturday: { open: "${input.openingHours.saturday.open}", close: "${input.openingHours.saturday.close}" }
                  sunday: { open: "${input.openingHours.sunday.open}", close: "${input.openingHours.sunday.close}" }
                }
              }) {
                id
                name
              }
            }
          `;

        await makeGraphQLRequest(query);
        alert(`Restaurant ${isEditMode ? "updated" : "added"} successfully!`);
        window.location.reload();
      } catch (error) {
        console.error("Error:", error);
        alert("An error occurred. Please try again.");
      }
    }

    // Confirm Delete
    function confirmDelete(id, name) {
      if (confirm(`Are you sure you want to delete restaurant "${name}"?`)) {
        deleteRestaurant(id);
      }
    }

    // Modify deleteRestaurant function to use makeGraphQLRequest
    async function deleteRestaurant(id) {
      try {
        const query = `
          mutation {
            deleteRestaurant(id: "${id}")
          }
        `;

        await makeGraphQLRequest(query);
        alert("Restaurant deleted successfully!");
        window.location.reload();
      } catch (error) {
        console.error("Error:", error);
        alert("An error occurred while deleting the restaurant. Please try again.");
      }
    }

    // Event Listeners
    document.addEventListener('DOMContentLoaded', function () {
      // Add restaurant button
      const addRestaurantBtn = document.getElementById('addRestaurantBtn');
      if (addRestaurantBtn) {
        addRestaurantBtn.addEventListener('click', openModal);
      }

      // Close modal button
      const closeModalBtn = document.getElementById('closeModalBtn');
      if (closeModalBtn) {
        closeModalBtn.addEventListener('click', closeModal);
      }

      // Cancel button
      const cancelButton = document.getElementById('cancelButton');
      if (cancelButton) {
        cancelButton.addEventListener('click', closeModal);
      }

      // Submit button
      const submitButton = document.getElementById('submitButton');
      if (submitButton) {
        submitButton.addEventListener('click', submitRestaurant);
      }

      // Set all hours button
      const setAllHoursBtn = document.getElementById('setAllHoursBtn');
      if (setAllHoursBtn) {
        setAllHoursBtn.addEventListener('click', setAllHours);
      }

      // Edit restaurant buttons
      const editButtons = document.querySelectorAll('.edit-restaurant-btn');
      editButtons.forEach(button => {
        button.addEventListener('click', function (e) {
          e.stopPropagation();
          const restaurantId = this.getAttribute('data-restaurant-id');
          editRestaurant(restaurantId);
        });
      });

      // Delete restaurant buttons
      const deleteButtons = document.querySelectorAll('.delete-restaurant-btn');
      deleteButtons.forEach(button => {
        button.addEventListener('click', function (e) {
          e.stopPropagation();
          const restaurantId = this.getAttribute('data-restaurant-id');
          const restaurantName = this.getAttribute('data-restaurant-name');
          confirmDelete(restaurantId, restaurantName);
        });
      });

      // Row click for details
      const tableRows = document.querySelectorAll('.restaurants-table tbody tr');
      tableRows.forEach(row => {
        row.addEventListener('click', function () {
          const restaurantId = this.getAttribute('data-restaurant-id');
          if (restaurantId) {
            redirectToDetails(restaurantId);
          }
        });
      });

      // Close modal when clicking outside
      const modal = document.getElementById('restaurantModal');
      if (modal) {
        modal.addEventListener('click', function (e) {
          if (e.target === modal) {
            closeModal();
          }
        });
      }
    });
  </script>
</body>

</html>