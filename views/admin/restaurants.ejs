<h2 class="text-2xl font-bold mb-6">Restaurants</h2>

<div class="bg-white p-6 rounded-lg shadow">
  <table class="min-w-full">
    <thead>
      <tr>
        <th
          class="px-6 py-3 border-b-2 border-gray-300 text-left text-xs leading-4 font-medium text-gray-500 uppercase tracking-wider"
        >
          Name
        </th>
        <th
          class="px-6 py-3 border-b-2 border-gray-300 text-left text-xs leading-4 font-medium text-gray-500 uppercase tracking-wider"
        >
          Address
        </th>
        <th
          class="px-6 py-3 border-b-2 border-gray-300 text-left text-xs leading-4 font-medium text-gray-500 uppercase tracking-wider"
        >
          Cuisine
        </th>
        <th
          class="px-6 py-3 border-b-2 border-gray-300 text-left text-xs leading-4 font-medium text-gray-500 uppercase tracking-wider"
        >
          Status
        </th>
        <th
          class="px-6 py-3 border-b-2 border-gray-300 text-left text-xs leading-4 font-medium text-gray-500 uppercase tracking-wider"
        >
          Actions
        </th>
      </tr>
    </thead>
    <tbody>
      <% restaurants.forEach(restaurant => { %>
      <tr>
        <td class="px-6 py-4 whitespace-no-wrap border-b border-gray-300">
          <div class="text-sm leading-5 font-medium text-gray-900">
            <%= restaurant.name %>
          </div>
        </td>
        <td class="px-6 py-4 whitespace-no-wrap border-b border-gray-300">
          <div class="text-sm leading-5 text-gray-500">
            <%= restaurant.address %>
          </div>
        </td>
        <td class="px-6 py-4 whitespace-no-wrap border-b border-gray-300">
          <div class="text-sm leading-5 text-gray-500">
            <%= restaurant.cuisine %>
          </div>
        </td>
        <td class="px-6 py-4 whitespace-no-wrap border-b border-gray-300">
          <span
            class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full <%= restaurant.isActive ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>"
          >
            <%= restaurant.isActive ? 'Active' : 'Inactive' %>
          </span>
        </td>
        <td
          class="px-6 py-4 whitespace-no-wrap border-b border-gray-300 text-sm leading-5 font-medium"
        >
          <a
            href="/admin/restaurants/<%= restaurant._id %>/edit"
            class="text-indigo-600 hover:text-indigo-900 mr-3"
            >Edit</a
          >
          <a
            href="/admin/restaurants/<%= restaurant._id %>/toggle"
            class="text-<%= restaurant.isActive ? 'red' : 'green' %>-600 hover:text-<%= restaurant.isActive ? 'red' : 'green' %>-900"
          >
            <%= restaurant.isActive ? 'Deactivate' : 'Activate' %>
          </a>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>
