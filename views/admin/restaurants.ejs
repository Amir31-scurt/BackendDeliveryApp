<!DOCTYPE html>
<html lang="fr">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Restaurants - Gourmet d'amour</title>
  <link
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Poppins:wght@300;400;600&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <style>
    :root {
      --primary-color: #DB607E;
      --secondary-color: #ABD27E;
      --accent-color: #b22222;
      --background-color: #f9f5f0;
      --dark-color: #2c2c2c;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Poppins', sans-serif;
      background-color: var(--background-color);
      min-height: 100vh;
      padding: 2rem;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
    }

    header {
      background: linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.7)), url('https://images.unsplash.com/photo-1601628828688-632f38a5a7d0?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1920&q=80');
      background-size: cover;
      background-position: center;
      padding: 2rem;
      text-align: center;
      color: white;
      margin-bottom: 2rem;
      border-radius: 15px;
    }

    header h1 {
      font-family: 'Playfair Display', serif;
      font-size: 2.5rem;
      margin-bottom: 0.5rem;
      color: var(--primary-color);
    }

    .nav-links {
      display: flex;
      justify-content: center;
      gap: 1rem;
      margin-top: 1rem;
    }

    .nav-link {
      color: white;
      text-decoration: none;
      padding: 0.5rem 1rem;
      border-radius: 5px;
      transition: background-color 0.3s ease;
    }

    .nav-link:hover {
      background-color: rgba(255, 255, 255, 0.1);
    }

    .add-restaurant-btn {
      background-color: var(--primary-color);
      color: white;
      padding: 0.75rem 1.5rem;
      border: none;
      border-radius: 8px;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;
      margin-bottom: 2rem;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }

    .add-restaurant-btn:hover {
      background-color: #c44d68;
      transform: translateY(-2px);
    }

    .restaurants-section {
      background: white;
      padding: 2rem;
      border-radius: 15px;
      box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
    }

    .restaurants-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 1rem;
    }

    .restaurants-table th {
      background-color: var(--background-color);
      padding: 1rem;
      text-align: left;
      font-weight: 600;
      color: var(--dark-color);
      border-bottom: 2px solid var(--primary-color);
    }

    .restaurants-table td {
      padding: 1rem;
      border-bottom: 1px solid #eee;
      color: var(--dark-color);
    }

    .restaurants-table tr:hover {
      background-color: var(--background-color);
      cursor: pointer;
    }

    .restaurant-image {
      width: 60px;
      height: 60px;
      object-fit: cover;
      border-radius: 5px;
    }

    .action-buttons {
      display: flex;
      gap: 1rem;
    }

    .action-btn {
      background: none;
      border: none;
      cursor: pointer;
      font-size: 1.1rem;
      transition: color 0.3s ease;
    }

    .view-btn {
      color: var(--primary-color);
    }

    .edit-btn {
      color: var(--secondary-color);
    }

    .delete-btn {
      color: var(--accent-color);
    }

    .action-btn:hover {
      opacity: 0.8;
    }

    /* Modal Styles */
    .modal {
      position: fixed;
      inset: 0;
      background-color: rgba(0, 0, 0, 0.5);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 1000;
    }

    .modal.show {
      display: flex;
    }

    .modal-content {
      background: white;
      padding: 2rem;
      border-radius: 15px;
      width: 90%;
      max-width: 800px;
      max-height: 90vh;
      overflow-y: auto;
      position: relative;
    }

    .modal-header {
      margin-bottom: 1.5rem;
    }

    .modal-header h2 {
      font-family: 'Playfair Display', serif;
      font-size: 1.8rem;
      color: var(--dark-color);
    }

    .form-group {
      margin-bottom: 1.5rem;
    }

    .form-group label {
      display: block;
      margin-bottom: 0.5rem;
      color: var(--dark-color);
      font-weight: 500;
    }

    .form-control {
      width: 100%;
      padding: 0.75rem;
      border: 2px solid #eee;
      border-radius: 8px;
      font-size: 1rem;
      transition: border-color 0.3s ease;
    }

    .form-control:focus {
      outline: none;
      border-color: var(--primary-color);
    }

    .opening-hours-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
      margin-top: 0.5rem;
    }

    .time-inputs {
      display: flex;
      gap: 0.5rem;
    }

    .time-inputs input {
      flex: 1;
    }

    .modal-buttons {
      display: flex;
      gap: 1rem;
      margin-top: 2rem;
    }

    .modal-btn {
      flex: 1;
      padding: 0.75rem;
      border: none;
      border-radius: 8px;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;
    }

    .submit-btn {
      background-color: var(--primary-color);
      color: white;
    }

    .cancel-btn {
      background-color: #eee;
      color: var(--dark-color);
    }

    .modal-btn:hover {
      transform: translateY(-2px);
    }

    .close-modal {
      position: absolute;
      top: 1rem;
      right: 1rem;
      background: none;
      border: none;
      font-size: 1.5rem;
      color: var(--dark-color);
      cursor: pointer;
      transition: color 0.3s ease;
    }

    .close-modal:hover {
      color: var(--primary-color);
    }

    @media (max-width: 768px) {
      body {
        padding: 1rem;
      }

      .restaurants-table {
        display: block;
        overflow-x: auto;
      }

      .opening-hours-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

<body>
  <div class="container">
    <header>
      <h1>Gourmet d'amour</h1>
      <p>Gestion des Restaurants</p>
      <div class="nav-links">
        <a href="/admin/dashboard" class="nav-link">Tableau de Bord</a>
        <a href="/admin/restaurants" class="nav-link">Restaurants</a>
        <a href="/" class="nav-link">Accueil</a>
      </div>
    </header>

    <button onclick="openModal()" class="add-restaurant-btn">
      <i class="fas fa-plus"></i> Ajouter un Restaurant
    </button>

    <div class="restaurants-section">
      <table class="restaurants-table">
        <thead>
          <tr>
            <th>Image</th>
            <th>Nom</th>
            <th>Adresse</th>
            <th>Type</th>
            <th>Statut</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (restaurants && restaurants.length> 0) { %>
            <% restaurants.forEach((restaurant)=> { %>
              <tr onclick="redirectToDetails('<%= restaurant.id %>')">
                <td>
                  <img src="<%= restaurant.imageUrl %>" alt="<%= restaurant.name %>" class="restaurant-image" />
                </td>
                <td>
                  <%= restaurant.name %>
                </td>
                <td>
                  <%= restaurant.address %>
                </td>
                <td>
                  <%= restaurant.type %>
                </td>
                <td>
                  <%= restaurant.isActive ? "Actif" : "Inactif" %>
                </td>
                <td>
                  <div class="action-buttons">
                    <a href="/admin/restaurants/<%= restaurant.id %>/details" onclick="event.stopPropagation();"
                      class="action-btn view-btn" title="Voir les détails">
                      <i class="fas fa-eye"></i>
                    </a>
                    <button class="action-btn edit-btn"
                      onclick="event.stopPropagation(); editRestaurant('<%= restaurant.id %>')" title="Modifier">
                      <i class="fas fa-edit"></i>
                    </button>
                    <button class="action-btn delete-btn"
                      onclick="event.stopPropagation(); confirmDelete('<%= restaurant.id %>', '<%= restaurant.name %>')"
                      title="Supprimer">
                      <i class="fas fa-trash"></i>
                    </button>
                  </div>
                </td>
              </tr>
              <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="6" class="text-center py-4 text-gray-500">
                      Aucun restaurant trouvé.
                    </td>
                  </tr>
                  <% } %>
        </tbody>
      </table>
    </div>

    <!-- Add/Edit Restaurant Modal -->
    <div id="restaurantModal" class="modal">
      <div class="modal-content">
        <button class="close-modal" onclick="closeModal()">&times;</button>
        <div class="modal-header">
          <h2 id="modalTitle">Ajouter un Restaurant</h2>
        </div>
        <form id="restaurantForm">
          <input type="hidden" id="restaurantId" name="restaurantId" />

          <div class="form-group">
            <label for="name">Nom</label>
            <input type="text" id="name" name="name" class="form-control" placeholder="Entrer le nom du restaurant"
              required />
          </div>

          <div class="form-group">
            <label for="description">Description</label>
            <textarea id="description" name="description" class="form-control"
              placeholder="Entrer la description du restaurant" rows="3" required></textarea>
          </div>

          <div class="form-group">
            <label for="address">Adresse</label>
            <input type="text" id="address" name="address" class="form-control"
              placeholder="Entrer l'adresse du restaurant" required />
          </div>

          <div class="form-group">
            <label for="type">Type</label>
            <select id="type" name="type" class="form-control" required>
              <option value="RESTAURANT">Restaurant</option>
              <option value="BOULANGERIE">Boulangerie</option>
              <option value="EXPRESS">Express</option>
            </select>
          </div>

          <div class="form-group">
            <label for="phoneNumber">Numéro de téléphone</label>
            <input type="text" id="phoneNumber" name="phoneNumber" class="form-control"
              placeholder="Entrer le numéro de téléphone" required />
          </div>

          <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" class="form-control" placeholder="Entrer l'adresse email"
              required />
          </div>

          <div class="form-group">
            <label for="image">Image</label>
            <input type="file" id="image" name="image" accept="image/*" class="form-control" required />
          </div>

          <div class="form-group">
            <label for="isActive">Statut</label>
            <select id="isActive" name="isActive" class="form-control" required>
              <option value="true">Actif</option>
              <option value="false">Inactif</option>
            </select>
          </div>

          <div class="form-group">
            <label>Heures d'ouverture</label>
            <div class="opening-hours-grid">
              <% ['monday', 'tuesday' , 'wednesday' , 'thursday' , 'friday' , 'saturday' , 'sunday' ].forEach(day=> {
                const frenchDays = {
                monday: "Lundi",
                tuesday: "Mardi",
                wednesday: "Mercredi",
                thursday: "Jeudi",
                friday: "Vendredi",
                saturday: "Samedi",
                sunday: "Dimanche"
                };
                %>
                <div>
                  <label class="form-group-label">
                    <%= frenchDays[day] %>
                  </label>
                  <div class="time-inputs">
                    <input type="time" name="openingHours[<%= day %>][open]" class="form-control" required />
                    <input type="time" name="openingHours[<%= day %>][close]" class="form-control" required />
                  </div>
                </div>
                <% }); %>
            </div>
          </div>

          <div class="modal-buttons">
            <button type="button" id="submitButton" onclick="submitRestaurant()" class="modal-btn submit-btn">
              Ajouter
            </button>
            <button type="button" onclick="closeModal()" class="modal-btn cancel-btn">
              Annuler
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script>
    let isEditMode = false;

    // Open Modal for adding
    function openModal() {
      isEditMode = false;
      document.getElementById("modalTitle").textContent = "Ajouter un Restaurant";
      document.getElementById("submitButton").textContent = "Ajouter";
      document.getElementById("restaurantForm").reset();
      document.getElementById("restaurantId").value = "";
      document.getElementById("restaurantModal").classList.add("show");
    }

    // Fetch restaurant data and open edit modal
    async function editRestaurant(id) {
      try {
        // Fetch restaurant data from server
        const query = `
          query {
            restaurant(id: "${id}") {
              id
              name
              description
              address
              type
              phoneNumber
              email
              imageUrl
              isActive
              openingHours {
                monday { open close }
                tuesday { open close }
                wednesday { open close }
                thursday { open close }
                friday { open close }
                saturday { open close }
                sunday { open close }
              }
            }
          }
        `;

        const response = await fetch("/graphql", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ query }),
        });

        const result = await response.json();

        if (result.errors) {
          throw new Error(result.errors[0].message);
        }

        const restaurant = result.data.restaurant;
        openEditModal(restaurant);
      } catch (error) {
        console.error("Error fetching restaurant:", error);
        alert("Error loading restaurant data. Please try again.");
      }
    }

    // Open Modal for editing
    function openEditModal(restaurant) {
      try {
        isEditMode = true;
        console.log("Restaurant data:", restaurant);

        document.getElementById("modalTitle").textContent = "Modifier le Restaurant";
        document.getElementById("submitButton").textContent = "Mettre à jour";

        // Fill form with restaurant data
        document.getElementById("restaurantId").value = restaurant.id;
        document.getElementById("name").value = restaurant.name || "";
        document.getElementById("description").value = restaurant.description || "";
        document.getElementById("address").value = restaurant.address || "";
        document.getElementById("type").value = (restaurant.type || "RESTAURANT").toLowerCase();
        document.getElementById("phoneNumber").value = restaurant.phoneNumber || "";
        document.getElementById("email").value = restaurant.email || "";
        document.getElementById("isActive").value = (restaurant.isActive || false).toString();

        // Make image upload not required in edit mode
        document.getElementById("image").removeAttribute("required");

        // Fill opening hours if they exist
        if (restaurant.openingHours) {
          const days = ['monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday'];
          days.forEach(day => {
            if (restaurant.openingHours[day]) {
              document.querySelector(`input[name="openingHours[${day}][open]"]`).value = restaurant.openingHours[day].open || "";
              document.querySelector(`input[name="openingHours[${day}][close]"]`).value = restaurant.openingHours[day].close || "";
            }
          });
        }

        // Show the modal
        document.getElementById("restaurantModal").classList.add("show");
      } catch (error) {
        console.error("Error in openEditModal:", error);
        alert("Error opening edit modal. Please try again.");
      }
    }

    // Close Modal
    function closeModal() {
      document.getElementById("restaurantModal").classList.remove("show");
    }

    // Redirect to Restaurant Details
    function redirectToDetails(id) {
      window.location.href = `/admin/restaurants/${id}/details`;
    }

    async function submitRestaurant() {
      const form = document.getElementById("restaurantForm");
      const formData = new FormData(form);
      const restaurantId = formData.get("restaurantId");

      // Extract file input
      const imageFile = formData.get("image");

      // Upload the image to Supabase Storage if a new file was selected
      let imageUrl = "";
      if (imageFile && imageFile.size > 0) {
        try {
          const fileName = `restaurant-${Date.now()}-${imageFile.name}`;
          const storageUrl = "/storage/upload"; // Replace with your API endpoint or direct Supabase call

          // Prepare the upload request
          const uploadResponse = await fetch(storageUrl, {
            method: "POST",
            body: formData, // Assuming the server-side logic extracts the 'image' field
          });

          const uploadResult = await uploadResponse.json();
          console.log(uploadResponse);
          console.log("uploadResult", uploadResult);

          if (uploadResponse.ok && uploadResult.publicUrl) {
            imageUrl = uploadResult.publicUrl;
            console.log("Image uploaded successfully:", imageUrl);
          } else {
            throw new Error("Failed to upload image");
          }
        } catch (error) {
          console.error("Image upload failed:", error);
          alert("Image upload failed. Please try again.");
          return;
        }
      }

      const input = {
        name: formData.get("name"),
        description: formData.get("description"),
        address: formData.get("address"),
        type: formData.get("type").toUpperCase(),
        phoneNumber: formData.get("phoneNumber"),
        email: formData.get("email"),
        isActive: formData.get("isActive"),
        openingHours: {
          monday: {
            open: formData.get("openingHours[monday][open]"),
            close: formData.get("openingHours[monday][close]"),
          },
          tuesday: {
            open: formData.get("openingHours[tuesday][open]"),
            close: formData.get("openingHours[tuesday][close]"),
          },
          wednesday: {
            open: formData.get("openingHours[wednesday][open]"),
            close: formData.get("openingHours[wednesday][close]"),
          },
          thursday: {
            open: formData.get("openingHours[thursday][open]"),
            close: formData.get("openingHours[thursday][close]"),
          },
          friday: {
            open: formData.get("openingHours[friday][open]"),
            close: formData.get("openingHours[friday][close]"),
          },
          saturday: {
            open: formData.get("openingHours[saturday][open]"),
            close: formData.get("openingHours[saturday][close]"),
          },
          sunday: {
            open: formData.get("openingHours[sunday][open]"),
            close: formData.get("openingHours[sunday][close]"),
          },
        },
      };

      // Add imageUrl only if a new image was uploaded
      if (imageUrl) {
        input.imageUrl = imageUrl;
      }

      let query;

      if (isEditMode) {
        // Update restaurant query with correct GraphQL schema field names
        query = `
        mutation {
          updateRestaurant(id: "${restaurantId}", input: {
            name: "${input.name}",
            description: "${input.description}",
            address: "${input.address}",
            type: ${input.type},
            phoneNumber: "${input.phoneNumber}",
            email: "${input.email}"
            ${imageUrl ? `, imageUrl: "${input.imageUrl}"` : ''}
          }) {
            id
            name
          }
        }
      `;
      } else {
        // Create restaurant query
        query = `
        mutation {
          createRestaurant(input: {
            name: "${input.name}",
            description: "${input.description}",
            address: "${input.address}",
            type: ${input.type},
            phoneNumber: "${input.phoneNumber}",
            email: "${input.email}",
            imageUrl: "${input.imageUrl}",
            isActive: ${input.isActive === "true" ? true : false},
            openingHours: {
              monday: { open: "${input.openingHours.monday.open}", close: "${input.openingHours.monday.close}" }
              tuesday: { open: "${input.openingHours.tuesday.open}", close: "${input.openingHours.tuesday.close}" }
              wednesday: { open: "${input.openingHours.wednesday.open}", close: "${input.openingHours.wednesday.close}" }
              thursday: { open: "${input.openingHours.thursday.open}", close: "${input.openingHours.thursday.close}" }
              friday: { open: "${input.openingHours.friday.open}", close: "${input.openingHours.friday.close}" }
              saturday: { open: "${input.openingHours.saturday.open}", close: "${input.openingHours.saturday.close}" }
              sunday: { open: "${input.openingHours.sunday.open}", close: "${input.openingHours.sunday.close}" }
            }
          }) {
            id
            name
          }
        }
      `;
      }

      try {
        const response = await fetch("/graphql", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ query }),
        });

        console.log(JSON.stringify({ query }));

        const result = await response.json();
        if (result.errors) {
          alert(`Error ${isEditMode ? "updating" : "creating"} restaurant: ` + result.errors[0].message);
          return;
        }

        alert(`Restaurant ${isEditMode ? "updated" : "added"} successfully!`);
        window.location.reload(); // Reload to refresh the restaurant list
      } catch (error) {
        console.error("Error:", error);
        alert("An error occurred. Please try again.");
      }
    }

    // Confirm Delete
    function confirmDelete(id, name) {
      if (confirm(`Are you sure you want to delete restaurant "${name}"?`)) {
        deleteRestaurant(id);
      }
    }

    // Delete Restaurant
    async function deleteRestaurant(id) {
      const query = `
        mutation {
          deleteRestaurant(id: "${id}")
        }
      `;

      try {
        const response = await fetch("/graphql", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ query }),
        });

        const result = await response.json();
        if (result.errors) {
          alert("Error deleting restaurant: " + result.errors[0].message);
          return;
        }

        alert("Restaurant deleted successfully!");
        window.location.reload();
      } catch (error) {
        console.error("Error:", error);
        alert("An error occurred while deleting the restaurant. Please try again.");
      }
    }
  </script>
</body>

</html>