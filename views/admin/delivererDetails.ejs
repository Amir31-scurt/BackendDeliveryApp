<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Détails du Livreur - Gourmet d'amour</title>
    <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Poppins:wght@300;400;600&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <style>
        :root {
            --primary-color: #DB607E;
            --secondary-color: #ABD27E;
            --accent-color: #b22222;
            --background-color: #f9f5f0;
            --dark-color: #2c2c2c;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: var(--background-color);
            min-height: 100vh;
            padding: 2rem;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        header {
            background: linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.7)), url('https://images.unsplash.com/photo-1601628828688-632f38a5a7d0?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1920&q=80');
            background-size: cover;
            background-position: center;
            padding: 2rem;
            text-align: center;
            color: white;
            margin-bottom: 2rem;
            border-radius: 15px;
        }

        header h1 {
            font-family: 'Playfair Display', serif;
            font-size: 2.5rem;
            margin-bottom: 0.5rem;
            color: var(--primary-color);
        }

        .nav-links {
            display: flex;
            justify-content: center;
            gap: 1rem;
            margin-top: 1rem;
        }

        .nav-link {
            color: white;
            text-decoration: none;
            padding: 0.5rem 1rem;
            border-radius: 5px;
            transition: background-color 0.3s ease;
        }

        .nav-link:hover {
            background-color: rgba(255, 255, 255, 0.1);
        }

        .deliverer-profile {
            background: white;
            padding: 2rem;
            border-radius: 15px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
            margin-bottom: 2rem;
        }

        .profile-header {
            display: flex;
            align-items: center;
            gap: 2rem;
            margin-bottom: 2rem;
        }

        .profile-image {
            width: 150px;
            height: 150px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid var(--primary-color);
        }

        .profile-info h2 {
            font-family: 'Playfair Display', serif;
            font-size: 2rem;
            color: var(--dark-color);
            margin-bottom: 0.5rem;
        }

        .status-badge {
            display: inline-block;
            padding: 0.5rem 1rem;
            border-radius: 20px;
            font-size: 0.875rem;
            font-weight: 500;
            margin-top: 0.5rem;
        }

        .status-active {
            background-color: var(--secondary-color);
            color: white;
        }

        .status-inactive {
            background-color: #e0e0e0;
            color: var(--dark-color);
        }

        .profile-details {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1.5rem;
            margin-top: 2rem;
        }

        .detail-card {
            background: var(--background-color);
            padding: 1.5rem;
            border-radius: 10px;
        }

        .detail-card h3 {
            color: var(--dark-color);
            font-size: 1.1rem;
            margin-bottom: 0.5rem;
        }

        .detail-card p {
            color: var(--primary-color);
            font-size: 1.2rem;
            font-weight: 600;
        }

        .action-buttons {
            display: flex;
            gap: 1rem;
            margin-top: 2rem;
        }

        .action-btn {
            padding: 0.75rem 1.5rem;
            border: none;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .edit-btn {
            background-color: var(--primary-color);
            color: white;
        }

        .delete-btn {
            background-color: var(--accent-color);
            color: white;
        }

        .action-btn:hover {
            transform: translateY(-2px);
            opacity: 0.9;
        }

        .delivery-history {
            background: white;
            padding: 2rem;
            border-radius: 15px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
        }

        .delivery-history h2 {
            font-family: 'Playfair Display', serif;
            font-size: 1.8rem;
            color: var(--dark-color);
            margin-bottom: 1.5rem;
        }

        .delivery-table {
            width: 100%;
            border-collapse: collapse;
        }

        .delivery-table th {
            background-color: var(--background-color);
            padding: 1rem;
            text-align: left;
            font-weight: 600;
            color: var(--dark-color);
            border-bottom: 2px solid var(--primary-color);
        }

        .delivery-table td {
            padding: 1rem;
            border-bottom: 1px solid #eee;
            color: var(--dark-color);
        }

        .delivery-table tr:hover {
            background-color: var(--background-color);
        }

        @media (max-width: 768px) {
            body {
                padding: 1rem;
            }

            .profile-header {
                flex-direction: column;
                text-align: center;
            }

            .profile-image {
                width: 120px;
                height: 120px;
            }

            .delivery-table {
                display: block;
                overflow-x: auto;
            }
        }
    </style>
</head>

<body>
    <div class="container">
        <header>
            <h1>Gourmet d'amour</h1>
            <p>Détails du Livreur</p>
            <div class="nav-links">
                <a href="/admin/dashboard" class="nav-link">Tableau de Bord</a>
                <a href="/admin/restaurants" class="nav-link">Restaurants</a>
                <a href="/admin/deliverers" class="nav-link">Livreurs</a>
                <a href="/" class="nav-link">Accueil</a>
            </div>
        </header>

        <div class="deliverer-profile">
            <div class="profile-header">
                <img src="<%= deliverer.profilePicture || deliverer.user.profile_picture || '/images/default-deliverer.png' %>"
                    alt="<%= deliverer.user.name %>" class="profile-image" />
                <div class="profile-info">
                    <h2>
                        <%= deliverer.user.name %>
                    </h2>
                    <p><i class="fas fa-phone"></i>
                        <%= deliverer.user.phone_number %>
                    </p>
                    <span class="status-badge status-<%= deliverer.isAvailable ? 'active' : 'inactive' %>">
                        <%= deliverer.isAvailable ? 'Disponible' : 'Occupé' %>
                    </span>
                </div>
            </div>

            <div class="profile-details">
                <div class="detail-card">
                    <h3>Zone de Livraison</h3>
                    <p>
                        <%= deliverer.zone || 'Non spécifiée' %>
                    </p>
                </div>
                <div class="detail-card">
                    <h3>Véhicule</h3>
                    <p>
                        <%= deliverer.vehicleId || 'Non spécifié' %>
                    </p>
                </div>
                <div class="detail-card">
                    <h3>Commandes Livrées</h3>
                    <p>
                        <%= deliverer.completedDeliveries || 0 %>
                    </p>
                </div>
                <div class="detail-card">
                    <h3>Statut du Compte</h3>
                    <p>
                        <%= deliverer.isActive ? 'Actif' : 'Inactif' %>
                    </p>
                </div>
            </div>

            <div class="action-buttons">
                <button onclick="editDeliverer('<%= deliverer.userId %>')" class="action-btn edit-btn">
                    <i class="fas fa-edit"></i> Modifier
                </button>
                <button onclick="confirmDelete('<%= deliverer.userId %>', '<%= deliverer.user.name %>')"
                    class="action-btn delete-btn">
                    <i class="fas fa-trash"></i> Supprimer
                </button>
            </div>
        </div>

        <div class="delivery-history">
            <h2>Historique des Livraisons</h2>
            <table class="delivery-table">
                <thead>
                    <tr>
                        <th>ID Commande</th>
                        <th>Date</th>
                        <th>Montant</th>
                        <th>Statut</th>
                        <th>Adresse</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (deliverer.orders && deliverer.orders.length> 0) { %>
                        <% deliverer.orders.forEach(order=> { %>
                            <tr>
                                <td>
                                    <%= order.id %>
                                </td>
                                <td>
                                    <%= new Date(order.created_at).toLocaleDateString('fr-FR') %>
                                </td>
                                <td>
                                    <%= order.total_amount.toFixed(2) %> €
                                </td>
                                <td>
                                    <%= order.status %>
                                </td>
                                <td>
                                    <%= order.delivery_address.address %>
                                </td>
                            </tr>
                            <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="5" style="text-align: center;">Aucune commande trouvée</td>
                                    </tr>
                                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <script>
        function editDeliverer(id) {
            window.location.href = `/admin/deliverers/${id}/edit`;
        }

        function confirmDelete(id, name) {
            if (confirm(`Êtes-vous sûr de vouloir supprimer le livreur "${name}"?`)) {
                deleteDeliverer(id);
            }
        }

        async function deleteDeliverer(id) {
            try {
                const token = localStorage.getItem('authToken');
                if (!token) {
                    alert("Vous devez être connecté pour supprimer un livreur");
                    window.location.href = '/admin/login';
                    return;
                }

                const response = await fetch(`/admin/deliverers/${id}/delete`, {
                    method: 'POST',
                    headers: {
                        'Authorization': `Bearer ${token}`,
                        'Accept': 'application/json'
                    }
                });

                if (!response.ok) {
                    const error = await response.json();
                    throw new Error(error.error || `HTTP error! status: ${response.status}`);
                }

                const result = await response.json();
                alert(result.message || "Livreur supprimé avec succès!");
                window.location.href = '/admin/deliverers';
            } catch (error) {
                console.error("Error:", error);
                alert(`Une erreur s'est produite: ${error.message}`);
            }
        }
    </script>
</body>

</html>