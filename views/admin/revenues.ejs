<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Revenus - Gourmet d'amour</title>
    <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Poppins:wght@300;400;600&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        :root {
            --primary-color: #DB607E;
            --secondary-color: #ABD27E;
            --accent-color: #b22222;
            --background-color: #f9f5f0;
            --dark-color: #2c2c2c;
            --card-shadow: 0 10px 20px rgba(0, 0, 0, 0.05);
            --transition-speed: 0.3s;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: var(--background-color);
            min-height: 100vh;
            padding: 2rem;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
        }

        header {
            background: linear-gradient(rgba(0, 0, 0, 0.8), rgba(0, 0, 0, 0.8)), url('https://images.unsplash.com/photo-1601628828688-632f38a5a7d0?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1920&q=80');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            padding: 3rem 2rem;
            text-align: center;
            color: white;
            margin-bottom: 2rem;
            border-radius: 20px;
            position: relative;
            overflow: hidden;
        }

        header::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(45deg, rgba(219, 96, 126, 0.2), rgba(171, 210, 126, 0.2));
            z-index: 1;
        }

        header h1 {
            font-family: 'Playfair Display', serif;
            font-size: 3rem;
            margin-bottom: 1rem;
            color: var(--primary-color);
            position: relative;
            z-index: 2;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
            animation: fadeInDown 1s ease-out;
        }

        header p {
            font-size: 1.2rem;
            margin-bottom: 2rem;
            position: relative;
            z-index: 2;
            animation: fadeInUp 1s ease-out;
        }

        .nav-links {
            display: flex;
            justify-content: center;
            gap: 1.5rem;
            margin-top: 2rem;
            position: relative;
            z-index: 2;
        }

        .nav-link {
            color: white;
            text-decoration: none;
            padding: 0.8rem 1.5rem;
            border-radius: 30px;
            transition: all var(--transition-speed) ease;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(5px);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .nav-link:hover {
            background: rgba(255, 255, 255, 0.2);
            transform: translateY(-2px);
        }

        .filter-link {
            text-decoration: none;
            padding: 0.8rem 1.7rem;
            border-radius: 30px;
            transition: all var(--transition-speed) ease;
            background: linear-gradient(45deg, var(--primary-color), #c44d68);
            color: white;
            border: none;
            cursor: pointer;
            font-weight: 600;
            font-size: 1rem;
            box-shadow: var(--card-shadow);
        }

        .filter-link:hover {
            transform: translateY(-2px);
            box-shadow: 0 15px 30px rgba(219, 96, 126, 0.2);
            color: white;
        }

        .reset-link {
            text-decoration: none;
            padding: 0.8rem 1.7rem;
            border-radius: 30px;
            transition: all var(--transition-speed) ease;
            background: white;
            color: var(--primary-color);
            border: 1px solid var(--primary-color);
            cursor: pointer;
            font-weight: 600;
            font-size: 1rem;
        }

        .reset-link:hover {
            background: var(--background-color);
            transform: translateY(-2px);
            border-color: #c44d68;
            color: #c44d68;
        }

        .revenue-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
            margin-bottom: 3rem;
        }

        .revenue-card {
            background: white;
            padding: 2.5rem;
            border-radius: 20px;
            box-shadow: var(--card-shadow);
            text-align: center;
            transition: all var(--transition-speed) ease;
            position: relative;
            overflow: hidden;
        }

        .revenue-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(45deg, rgba(219, 96, 126, 0.1), rgba(171, 210, 126, 0.1));
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .revenue-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.1);
        }

        .revenue-card:hover::before {
            opacity: 1;
        }

        .revenue-card h3 {
            font-size: 1.2rem;
            color: var(--dark-color);
            margin-bottom: 1rem;
            position: relative;
            z-index: 1;
        }

        .revenue-card .icon {
            font-size: 3rem;
            margin-bottom: 1rem;
            position: relative;
            z-index: 1;
        }

        .revenue-card.restaurant .icon {
            color: var(--primary-color);
        }

        .revenue-card.deliverer .icon {
            color: var(--secondary-color);
        }

        .revenue-card.gourmet .icon {
            color: var(--accent-color);
        }

        .revenue-card p {
            font-size: 2.5rem;
            font-weight: 600;
            color: var(--primary-color);
            position: relative;
            z-index: 1;
        }

        .revenue-breakdown-section {
            margin-top: 3rem;
        }

        .section-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.8rem;
            color: var(--dark-color);
            margin-bottom: 2rem;
            text-align: center;
        }

        .breakdown-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 2rem;
            margin-bottom: 3rem;
        }

        .breakdown-card {
            background: white;
            padding: 2.5rem;
            border-radius: 20px;
            box-shadow: var(--card-shadow);
        }

        .breakdown-card h4 {
            font-size: 1.3rem;
            color: var(--dark-color);
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .breakdown-card h4 i {
            color: var(--primary-color);
        }

        .breakdown-explanation p {
            margin-bottom: 1rem;
            font-size: 1.1rem;
            color: var(--dark-color);
        }

        .revenue-split {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            margin-top: 1.5rem;
        }

        .split-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1rem;
            background: var(--background-color);
            border-radius: 10px;
        }

        .split-label {
            font-weight: 600;
            color: var(--dark-color);
        }

        .split-value {
            font-size: 1.2rem;
            font-weight: 600;
            color: var(--primary-color);
        }

        .breakdown-tables {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
            gap: 2rem;
            margin-bottom: 3rem;
        }

        .breakdown-table-container {
            background: white;
            padding: 2.5rem;
            border-radius: 20px;
            box-shadow: var(--card-shadow);
        }

        .breakdown-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 1rem;
        }

        .breakdown-table th {
            background: var(--background-color);
            padding: 1rem;
            text-align: left;
            font-weight: 600;
            color: var(--dark-color);
            border-bottom: 2px solid var(--primary-color);
        }

        .breakdown-table td {
            padding: 1rem;
            border-bottom: 1px solid #eee;
            color: var(--dark-color);
        }

        .breakdown-table tr:hover {
            background: var(--background-color);
        }

        .chart-container {
            background: white;
            padding: 2.5rem;
            border-radius: 20px;
            box-shadow: var(--card-shadow);
            margin-top: 2rem;
            height: 400px;
        }

        .chart-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.8rem;
            color: var(--dark-color);
            margin-bottom: 2rem;
            text-align: center;
        }

        @keyframes fadeInDown {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @media (max-width: 768px) {
            .revenue-grid {
                grid-template-columns: 1fr;
            }

            .breakdown-tables {
                grid-template-columns: 1fr;
            }

            .breakdown-table-container {
                padding: 1.5rem;
            }

            .breakdown-table {
                font-size: 0.9rem;
            }

            .breakdown-table th,
            .breakdown-table td {
                padding: 0.8rem;
            }

            .chart-container {
                height: 300px;
                padding: 1.5rem;
            }
        }
    </style>
</head>

<body>
    <header>
        <h1>Gourmet d'amour</h1>
        <p>Gestion des Revenus</p>
        <div class="nav-links">
            <a href="/admin/dashboard" class="nav-link">
                <i class="fa-solid fa-chart-line"></i> Tableau de Bord
            </a>
            <a href="/admin/restaurants" class="nav-link">
                <i class="fa-solid fa-utensils"></i> Restaurants
            </a>
            <a href="/admin/deliverers" class="nav-link">
                <i class="fa-solid fa-truck"></i> Livreurs
            </a>
            <a href="/admin/orders" class="nav-link">
                <i class="fa-solid fa-cart-shopping"></i> Commandes
            </a>
            <a href="/" class="nav-link">
                <i class="fa-solid fa-house"></i> Accueil
            </a>
            <a href="/admin/logout" class="nav-link" style="background-color: var(--accent-color);">
                <i class="fas fa-sign-out-alt"></i> Déconnexion
            </a>
        </div>
    </header>

    <main class="container">
        <form method="get" action="/admin/revenues"
            style="margin-bottom: 1.5rem; display:flex; gap:1rem; flex-wrap:wrap; align-items:flex-end;">
            <div>
                <label for="from" style="display:block; margin-bottom:0.3rem; font-weight:600;">Du</label>
                <input type="date" id="from" name="from" value="<%= filters?.from || '' %>"
                    style="padding:0.6rem 0.9rem; border-radius:10px; border:1px solid #ddd;">
            </div>
            <div>
                <label for="to" style="display:block; margin-bottom:0.3rem; font-weight:600;">Au</label>
                <input type="date" id="to" name="to" value="<%= filters?.to || '' %>"
                    style="padding:0.6rem 0.9rem; border-radius:10px; border:1px solid #ddd;">
            </div>
            <button type="submit" class="filter-link">Filtrer</button>
            <a href="/admin/revenues" class="reset-link">Réinitialiser</a>
        </form>

        <div class="revenue-grid">
            <div class="revenue-card restaurant">
                <div class="icon">
                    <i class="fa-solid fa-store"></i>
                </div>
                <h3>Revenu Restaurants</h3>
                <p>
                    <%= (revenues.restaurants || 0).toLocaleString() %> F
                </p>
            </div>

            <div class="revenue-card deliverer">
                <div class="icon">
                    <i class="fa-solid fa-motorcycle"></i>
                </div>
                <h3>Revenu Livreurs</h3>
                <p>
                    <%= (revenues.deliverers || 0).toLocaleString() %> F
                </p>
            </div>

            <div class="revenue-card gourmet">
                <div class="icon">
                    <i class="fa-solid fa-heart"></i>
                </div>
                <h3>Revenu Gourmet</h3>
                <p>
                    <%= (revenues.gourmet || 0).toLocaleString() %> F
                </p>
            </div>
        </div>

        <div class="revenue-breakdown-section">
            <h3 class="section-title">Répartition des Revenus</h3>
            <div class="breakdown-grid">
                <div class="breakdown-card">
                    <h4><i class="fa-solid fa-info-circle"></i> Comment les revenus sont calculés</h4>
                    <div class="breakdown-explanation">
                        <p><strong>Valeur totale des commandes:</strong>
                            <%= (totalOrderValue || 0).toLocaleString() %> F
                        </p>
                        <div class="revenue-split">
                            <div class="split-item">
                                <span class="split-label">Restaurants:</span>
                                <span class="split-value">
                                    <%= (revenues.restaurants || 0).toLocaleString() %> F
                                </span>
                            </div>
                            <div class="split-item">
                                <span class="split-label">Livreurs:</span>
                                <span class="split-value">
                                    <%= (revenues.deliverers || 0).toLocaleString() %> F
                                </span>
                            </div>
                            <div class="split-item">
                                <span class="split-label">Gourmet (Commission):</span>
                                <span class="split-value">
                                    <%= (revenues.gourmet || 0).toLocaleString() %> F
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="breakdown-tables">
            <div class="breakdown-table-container">
                <h3 class="section-title">Top 10 Restaurants par Revenu</h3>
                <table class="breakdown-table">
                    <thead>
                        <tr>
                            <th>Restaurant</th>
                            <th>Commandes</th>
                            <th>Revenu</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (restaurantBreakdown && restaurantBreakdown.length> 0) { %>
                            <% restaurantBreakdown.forEach(resto=> { %>
                                <tr>
                                    <td>
                                        <%= resto.restaurantName %>
                                    </td>
                                    <td>
                                        <%= resto.orderCount %>
                                    </td>
                                    <td>
                                        <%= resto.revenue.toLocaleString() %> F
                                    </td>
                                </tr>
                                <% }); %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="3" style="text-align: center; padding: 2rem;">
                                                Aucun revenu de restaurant trouvé
                                            </td>
                                        </tr>
                                        <% } %>
                    </tbody>
                </table>
            </div>

            <div class="breakdown-table-container">
                <h3 class="section-title">Top 10 Livreurs par Revenu</h3>
                <table class="breakdown-table">
                    <thead>
                        <tr>
                            <th>Livreur</th>
                            <th>Livraisons</th>
                            <th>Revenu</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (delivererBreakdown && delivererBreakdown.length> 0) { %>
                            <% delivererBreakdown.forEach(deliverer=> { %>
                                <tr>
                                    <td>
                                        <%= deliverer.delivererName %>
                                    </td>
                                    <td>
                                        <%= deliverer.orderCount %>
                                    </td>
                                    <td>
                                        <%= deliverer.revenue.toLocaleString() %> F
                                    </td>
                                </tr>
                                <% }); %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="3" style="text-align: center; padding: 2rem;">
                                                Aucun revenu de livreur trouvé
                                            </td>
                                        </tr>
                                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="breakdown-table-container" style="margin-top:2rem;">
            <h3 class="section-title">Détails des Revenus par Commande</h3>
            <p style="margin-bottom:1rem; color:#555;">Chaque ligne montre l'origine des revenus pour une commande
                complétée.</p>
            <table class="breakdown-table">
                <thead>
                    <tr>
                        <th>Commande</th>
                        <th>Restaurant</th>
                        <th>Total</th>
                        <th>Part Restaurant</th>
                        <th>Part Livreur</th>
                        <th>Part Gourmet</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (revenueOrders && revenueOrders.length> 0) { %>
                        <% revenueOrders.forEach(o=> { %>
                            <tr>
                                <td>#<%= o.id.substring(0,8) %>
                                </td>
                                <td>
                                    <%= o.restaurantName %>
                                </td>
                                <td>
                                    <%= o.total.toLocaleString() %> F
                                </td>
                                <td>
                                    <%= o.restaurantShare.toLocaleString() %> F
                                </td>
                                <td>
                                    <%= o.delivererShare.toLocaleString() %> F
                                </td>
                                <td>
                                    <%= o.gourmetShare.toLocaleString() %> F
                                </td>
                                <td>
                                    <%= new Date(o.createdAt).toLocaleDateString('fr-FR') %>
                                        <br><small style="color:#888;">
                                            <%= new Date(o.createdAt).toLocaleTimeString('fr-FR') %>
                                        </small>
                                </td>
                            </tr>
                            <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="7" style="text-align:center; padding:1.5rem;">Aucune commande
                                            trouvée pour cette période.</td>
                                    </tr>
                                    <% } %>
                </tbody>
            </table>

            <div class="pagination-controls"
                style="margin-top: 1.5rem; display: flex; justify-content: space-between; align-items: center; padding-top: 1rem; border-top: 1px solid #eee;">
                <div class="pagination-info" style="font-size: 0.9rem; color: #666;">
                    Affichage <span id="startIndex">0</span> - <span id="endIndex">0</span> sur <span
                        id="totalItems">0</span>
                </div>
                <div class="pagination-buttons" style="display:flex; gap:10px; align-items: center;">
                    <button id="prevPage" class="reset-link"
                        style="padding: 0.5rem 1rem; font-size: 0.9rem;">Précédent</button>
                    <span id="currentPage" style="font-weight: 500;">Page 1</span>
                    <button id="nextPage" class="reset-link"
                        style="padding: 0.5rem 1rem; font-size: 0.9rem;">Suivant</button>
                </div>
            </div>
        </div>

        <div class="chart-container">
            <h3 class="chart-title">Évolution des Revenus Mensuels</h3>
            <div style="position: relative; height: 300px; width: 100%;">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Chart initialization (existing)
            const monthlyData = `${JSON.stringify(monthlyData || [])}`;

            // ... (keep chart logic implicitly or explicitly if needed, but the tool replaces blocks)
            // Wait, I am replacing the block. I need to keep the chart logic.

            const ctx = document.getElementById('revenueChart').getContext('2d');
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: monthlyData.map(item => item.month || ''),
                    datasets: [{
                        label: 'Revenus Mensuels',
                        data: monthlyData.map(item => item.orders || 0),
                        borderColor: '#DB607E',
                        backgroundColor: 'rgba(219, 96, 126, 0.1)',
                        borderWidth: 2,
                        tension: 0.4,
                        fill: true
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'top',
                            labels: {
                                font: {
                                    family: 'Poppins',
                                    size: 14
                                }
                            }
                        },
                        tooltip: {
                            backgroundColor: 'rgba(255, 255, 255, 0.9)',
                            titleColor: '#2c2c2c',
                            bodyColor: '#2c2c2c',
                            borderColor: '#DB607E',
                            borderWidth: 1,
                            padding: 12
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: {
                                color: 'rgba(0, 0, 0, 0.05)'
                            },
                            ticks: {
                                font: {
                                    family: 'Poppins'
                                }
                            }
                        },
                        x: {
                            grid: {
                                display: false
                            },
                            ticks: {
                                font: {
                                    family: 'Poppins'
                                }
                            }
                        }
                    }
                }
            });

            // Pagination Logic
            const urlParams = new URLSearchParams(window.location.search);
            const currentPage = parseInt(urlParams.get('page')) || 1;
            const limit = parseInt(urlParams.get('limit')) || 20;
            // Use EJS to inject values
            const totalItems = `${pagination ? pagination.totalCount : 0}`;
            const totalPages = `${pagination ? pagination.totalPages : 1}`;

            // Update UI
            const startIndex = (currentPage - 1) * limit + 1;
            const endIndex = Math.min(startIndex + limit - 1, totalItems);

            const startIndexSpan = document.getElementById('startIndex');
            const endIndexSpan = document.getElementById('endIndex');
            const totalItemsSpan = document.getElementById('totalItems');
            const currentPageSpan = document.getElementById('currentPage');

            if (startIndexSpan) startIndexSpan.textContent = totalItems > 0 ? startIndex : 0;
            if (endIndexSpan) endIndexSpan.textContent = endIndex;
            if (totalItemsSpan) totalItemsSpan.textContent = totalItems;
            if (currentPageSpan) currentPageSpan.textContent = `Page ${currentPage} sur ${totalPages}`;

            const prevBtn = document.getElementById('prevPage');
            const nextBtn = document.getElementById('nextPage');

            if (prevBtn) {
                prevBtn.disabled = currentPage <= 1;
                prevBtn.style.opacity = prevBtn.disabled ? '0.5' : '1';
                prevBtn.style.pointerEvents = prevBtn.disabled ? 'none' : 'auto';
                prevBtn.addEventListener('click', () => {
                    const newUrl = new URL(window.location);
                    newUrl.searchParams.set('page', currentPage - 1);
                    window.location.href = newUrl.toString();
                });
            }

            if (nextBtn) {
                nextBtn.disabled = currentPage >= totalPages;
                nextBtn.style.opacity = nextBtn.disabled ? '0.5' : '1';
                nextBtn.style.pointerEvents = nextBtn.disabled ? 'none' : 'auto';
                nextBtn.addEventListener('click', () => {
                    const newUrl = new URL(window.location);
                    newUrl.searchParams.set('page', currentPage + 1);
                    window.location.href = newUrl.toString();
                });
            }
        });

    </script>
</body>

</html>