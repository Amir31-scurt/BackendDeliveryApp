<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Panel - Restaurants</title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet" />
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
</head>

<body>
  <div class="container mx-auto p-6">
    <!-- Restaurant Details -->
    <div class="bg-white p-6 rounded-lg shadow mb-8">
      <img src="<%= restaurant.imageUrl %>" alt="" class="w-36" />
      <h2 class="text-2xl font-bold mb-6">
        <%= restaurant.name %>
      </h2>
      <p><strong>Description:</strong>
        <%= restaurant.description %>
      </p>
      <p><strong>Adresse:</strong>
        <%= restaurant.address %>
      </p>
      <p><strong>Type:</strong>
        <%= restaurant.type %>
      </p>
      <p><strong>Téléphone:</strong>
        <%= restaurant.phoneNumber %>
      </p>
      <p><strong>Email:</strong>
        <%= restaurant.email %>
      </p>
      <p>
        <strong>Statut:</strong>
        <%= restaurant.isActive ? "Actif" : "Inactif" %>
      </p>
      <p><strong>Heures d'ouverture:</strong></p>
      <ul class="list-disc pl-5">
        <% Object.entries(restaurant.openingHours).forEach(([day, hours])=> {
          const frenchDays = {
          monday: "Lundi",
          tuesday: "Mardi",
          wednesday: "Mercredi",
          thursday: "Jeudi",
          friday: "Vendredi",
          saturday: "Samedi",
          sunday: "Dimanche"
          };
          const frenchDay = frenchDays[day] || day.charAt(0).toUpperCase() + day.slice(1);
          %>
          <li>
            <%= frenchDay %>: <%= hours.open %> -
                <%= hours.close %>
          </li>
          <% }); %>
      </ul>
    </div>

    <button onclick="openModal()"
      class="m-4 inline-flex justify-center rounded-md border border-transparent bg-indigo-600 py-2 px-4 text-sm font-medium text-white shadow-sm hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
      Ajouter un Article
    </button>
    <!-- Menu Items Section -->
    <div class="bg-white p-6 rounded-lg shadow mb-8">
      <h2 class="text-xl font-bold mb-4">Articles du Menu</h2>
      <% if (menuItems.length> 0) { %>
        <table class="min-w-full border-collapse border border-gray-200">
          <thead>
            <tr class="bg-gray-100">
              <th class="border border-gray-200 px-4 py-2 text-left text-sm font-medium text-gray-700">
                Image
              </th>
              <th class="border border-gray-200 px-4 py-2 text-left text-sm font-medium text-gray-700">
                Nom
              </th>
              <th class="border border-gray-200 px-4 py-2 text-left text-sm font-medium text-gray-700">
                Description
              </th>
              <th class="border border-gray-200 px-4 py-2 text-left text-sm font-medium text-gray-700">
                Prix
              </th>
              <th class="border border-gray-200 px-4 py-2 text-left text-sm font-medium text-gray-700">
                Créé le
              </th>
              <th class="border border-gray-200 px-4 py-2 text-left text-sm font-medium text-gray-700">
                Actions
              </th>
            </tr>
          </thead>
          <tbody>
            <% menuItems.forEach((item)=> { %>
              <tr>
                <td class="border border-gray-200 px-4 py-2 text-sm text-gray-700">
                  <img src="<%= item.imageUrl %>" alt="<%= item.name %>" class="h-12" />
                </td>
                <td class="border border-gray-200 px-4 py-2 text-sm text-gray-700">
                  <%= item.name %>
                </td>
                <td class="border border-gray-200 px-4 py-2 text-sm text-gray-700">
                  <%= item.description %>
                </td>
                <td class="border border-gray-200 px-4 py-2 text-sm text-gray-700">
                  <%= item.price.toFixed(2) %> Fcfa
                </td>
                <td class="border border-gray-200 px-4 py-2 text-sm text-gray-700">
                  <%= item.createdAt %>
                </td>
                <td class="border border-gray-200 px-4 py-2 text-sm text-gray-700">
                  <div class="flex space-x-4">
                    <i class="fas fa-edit text-indigo-600 hover:text-indigo-900 cursor-pointer"
                      onclick="event.stopPropagation(); editMenuItem('<%= item.id %>')"></i>

                    <i class="fas fa-trash text-red-600 hover:text-red-900 cursor-pointer"
                      onclick="event.stopPropagation(); confirmDeleteMenuItem('<%= item.id %>', '<%= item.name %>')"></i>
                  </div>
                </td>
              </tr>
              <% }); %>
          </tbody>
        </table>
        <% } else { %>
          <p class="text-gray-500">Aucun article de menu disponible.</p>
          <% } %>
    </div>

    <!-- Add Menu Item Form -->
    <div id="menuItemModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 flex items-center justify-center hidden">
      <div class="bg-white p-6 rounded-lg shadow w-96">
        <h2 class="text-xl font-bold mb-4">Ajouter un Article</h2>
        <form action="/admin/restaurants/<%= restaurant.id %>/menu/add" method="POST" class="space-y-4"
          id="menuItemForm">
          <div>
            <label for="name" class="block text-sm font-medium text-gray-700">Nom</label>
            <input type="text" id="name" name="name"
              class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"
              placeholder="Entrer le nom de l'article" required />
          </div>
          <div>
            <label for="description" class="block text-sm font-medium text-gray-700">Description</label>
            <textarea id="description" name="description"
              class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"
              placeholder="Entrer la description de l'article" rows="3" required></textarea>
          </div>
          <div>
            <label for="price" class="block text-sm font-medium text-gray-700">Prix</label>
            <input type="number" id="price" name="price" step="0.01"
              class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"
              placeholder="Entrer le prix de l'article" required />
          </div>
          <div>
            <label for="isActive" class="block text-sm font-medium text-gray-700">Catégorie</label>
            <select id="category" name="category"
              class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"
              required>
              <!-- Categories will be populated based on restaurant type -->
            </select>
          </div>
          <div>
            <label for="image" class="block text-sm font-medium text-gray-700">Télécharger une Image</label>
            <input type="file" id="image" name="image" accept="image/*"
              class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"
              required />
          </div>
          <div class="flex space-x-4 mt-10">
            <button type="button" onclick="submitMenuItem()"
              class="flex-1 inline-flex justify-center rounded-md border border-transparent bg-indigo-600 py-2 px-4 text-sm font-medium text-white shadow-sm hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
              Ajouter
            </button>
            <button type="button" onclick="closeModal()"
              class="flex-1 inline-flex justify-center rounded-md border border-gray-300 bg-white py-2 px-4 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
              Annuler
            </button>
          </div>
        </form>
        <button onclick="closeModal()" class="absolute top-4 right-4 text-gray-600 hover:text-gray-800">
          &times;
        </button>
      </div>
    </div>
  </div>
  <script>
    const restaurantType = "<%= restaurant.type %>";

    function openModal() {
      document.getElementById("menuItemModal").classList.remove("hidden");
      populateCategoriesByType();
    }

    function populateCategoriesByType() {
      const categorySelect = document.getElementById("category");
      categorySelect.innerHTML = ""; // Clear existing options

      const categories = {
        "RESTAURANT": ["PLAT", "FASTFOOD", "GRILLADE"],
        "BOULANGERIE": ["PAINS", "VIENNOISERIES", "PATISSERIE"],
        "EXPRESS": ["EXPRESS", "GOURMET", "DESSERT"]
      };

      // Get the appropriate categories based on restaurant type
      const typeCategories = categories[restaurantType] || ["PLAT", "FASTFOOD", "GRILLADE"];

      // Add options to select dropdown
      typeCategories.forEach(category => {
        const option = document.createElement("option");
        option.value = category;
        option.textContent = category.charAt(0) + category.slice(1).toLowerCase();
        categorySelect.appendChild(option);
      });
    }

    // Close Modal
    function closeModal() {
      document.getElementById("menuItemModal").classList.add("hidden");
      document.getElementById("menuItemForm").reset();
      document.getElementById("menuItemForm").removeAttribute("data-mode");
      document.getElementById("menuItemForm").removeAttribute("data-id");
      const modalTitle = document.querySelector("#menuItemModal h2");
      modalTitle.textContent = "Ajouter un Article";
      const submitButton = document.querySelector("#menuItemModal button[onclick='submitMenuItem()']");
      submitButton.textContent = "Ajouter";
    }

    // Edit Menu Item
    async function editMenuItem(id) {
      try {
        console.log("Fetching menu item with ID:", id);

        // Fetch menu item data from server
        const query = `
          query {
            menuItem(id: "${id}") {
              id
              name
              description
              price
              category
              imageUrl
            }
          }
        `;

        console.log("Sending GraphQL query:", query);

        const response = await fetch("/graphql", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ query }),
        });

        const result = await response.json();
        console.log("GraphQL response:", result);

        if (result.errors) {
          console.error("GraphQL errors:", result.errors);
          throw new Error(result.errors[0].message);
        }

        if (!result.data || !result.data.menuItem) {
          console.error("No menu item data returned");
          throw new Error("No menu item data returned from server");
        }

        const menuItem = result.data.menuItem;
        console.log("Menu item data:", menuItem);

        openEditMenuItemModal(menuItem);
      } catch (error) {
        console.error("Error fetching menu item:", error);
        alert("Error loading menu item data. Please try again. Details: " + error.message);
      }
    }

    // Open Edit Menu Item Modal
    function openEditMenuItemModal(menuItem) {
      try {
        // Set form to edit mode
        document.getElementById("menuItemForm").setAttribute("data-mode", "edit");
        document.getElementById("menuItemForm").setAttribute("data-id", menuItem.id);

        // Update modal title and button text
        const modalTitle = document.querySelector("#menuItemModal h2");
        modalTitle.textContent = "Modifier l'Article";

        const submitButton = document.querySelector("#menuItemModal button[onclick='submitMenuItem()']");
        submitButton.textContent = "Mettre à jour";

        // Fill form with menu item data
        document.getElementById("name").value = menuItem.name || "";
        document.getElementById("description").value = menuItem.description || "";
        document.getElementById("price").value = menuItem.price || "";

        // Populate categories first
        populateCategoriesByType();

        // Then set the selected category
        if (menuItem.category) {
          const categorySelect = document.getElementById("category");
          for (let i = 0; i < categorySelect.options.length; i++) {
            if (categorySelect.options[i].value === menuItem.category) {
              categorySelect.selectedIndex = i;
              break;
            }
          }
        }

        // Make image upload not required in edit mode
        document.getElementById("image").removeAttribute("required");

        // Show the modal
        document.getElementById("menuItemModal").classList.remove("hidden");
      } catch (error) {
        console.error("Error in openEditMenuItemModal:", error);
        alert("Error opening edit modal. Please try again.");
      }
    }

    // Confirm Delete Menu Item
    function confirmDeleteMenuItem(id, name) {
      if (confirm(`Êtes-vous sûr de vouloir supprimer l'article "${name}"?`)) {
        deleteMenuItem(id);
      }
    }

    // Delete Menu Item
    async function deleteMenuItem(id) {
      const query = `
        mutation {
          deleteMenuItem(id: "${id}")
        }
      `;

      try {
        const response = await fetch("/graphql", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ query }),
        });

        const result = await response.json();
        if (result.errors) {
          alert("Erreur lors de la suppression de l'article: " + result.errors[0].message);
          return;
        }

        alert("Article supprimé avec succès!");
        window.location.reload();
      } catch (error) {
        console.error("Error:", error);
        alert("Une erreur s'est produite lors de la suppression de l'article. Veuillez réessayer.");
      }
    }

    async function submitMenuItem() {
      const restaurantId = "<%= restaurant.id %>";
      const form = document.getElementById("menuItemForm");
      const formData = new FormData(form);

      // Get form mode (add or edit)
      const mode = form.getAttribute("data-mode") || "add";
      const menuItemId = form.getAttribute("data-id") || "";

      // Extract file input
      const imageFile = formData.get("image");

      // Upload the image to Supabase Storage if a new file was selected
      let imageUrl = "";
      if (imageFile && imageFile.size > 0) {
        try {
          const fileName = `menu-${Date.now()}-${imageFile.name}`;
          const storageUrl = "/storage/upload"; // Replace with your API endpoint or direct Supabase call

          // Prepare the upload request
          const uploadResponse = await fetch(storageUrl, {
            method: "POST",
            body: formData, // Assuming the server-side logic extracts the 'image' field
          });

          const uploadResult = await uploadResponse.json();
          console.log(uploadResponse);
          console.log("uploadResult", uploadResult);

          if (uploadResponse.ok && uploadResult.publicUrl) {
            imageUrl = uploadResult.publicUrl;
            console.log("Image téléchargée avec succès:", imageUrl);
          } else {
            throw new Error("Échec du téléchargement de l'image");
          }
        } catch (error) {
          console.error("Échec du téléchargement de l'image:", error);
          alert("Échec du téléchargement de l'image. Veuillez réessayer.");
          return;
        }
      }

      const input = {
        name: formData.get("name"),
        description: formData.get("description"),
        price: parseFloat(formData.get("price")),
        category: formData.get("category")
      };

      // Add restaurant ID only for new items
      if (mode !== "edit") {
        input.restaurantId = restaurantId;
      }

      // Only include imageUrl if a new image was uploaded
      if (imageUrl) {
        input.imageUrl = imageUrl;
      }

      let query;

      if (mode === "edit") {
        // Update menu item query
        query = `
        mutation {
          updateMenuItem(id: "${menuItemId}", input: {
            name: "${input.name}",
            description: "${input.description}",
            price: ${input.price},
            category: "${input.category}"
            ${imageUrl ? `, imageUrl: "${input.imageUrl}"` : ''}
          }) {
            id
            name
          }
        }
        `;
      } else {
        // Create menu item query
        query = `
        mutation {
          addMenuItem(input: {
            name: "${input.name}",
            description: "${input.description}",
            price: ${input.price},
            restaurantId: "${input.restaurantId}",
            category: "${input.category}"
            ${imageUrl ? `, imageUrl: "${input.imageUrl}"` : ''}
          }) {
            id
            name
            description
            price
            category
            imageUrl
            createdAt
          }
        }
        `;
      }

      try {
        const response = await fetch("/graphql", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ query }),
        });

        console.log(JSON.stringify({ query }));

        const result = await response.json();
        if (result.errors) {
          alert(`Erreur lors de la ${mode === "edit" ? "modification" : "création"} de l'article: ` + result.errors[0].message);
          return;
        }

        alert(`Article ${mode === "edit" ? "modifié" : "ajouté"} avec succès!`);
        window.location.reload(); // Reload to refresh the menu items
      } catch (error) {
        console.error("Erreur:", error);
        alert("Une erreur s'est produite. Veuillez réessayer.");
      }
    }
  </script>
</body>