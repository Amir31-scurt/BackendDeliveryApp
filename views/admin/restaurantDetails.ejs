<!DOCTYPE html>
<html lang="fr">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Détails du Restaurant - Gourmet d'amour</title>
  <link
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Poppins:wght@300;400;600&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <style>
    :root {
      --primary-color: #DB607E;
      --secondary-color: #ABD27E;
      --accent-color: #b22222;
      --background-color: #f9f5f0;
      --dark-color: #2c2c2c;
      --card-shadow: 0 10px 20px rgba(0, 0, 0, 0.05);
      --transition-speed: 0.3s;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Poppins', sans-serif;
      background-color: var(--background-color);
      min-height: 100vh;
      padding: 2rem;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
    }

    header {
      background: linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.7)), url('https://images.unsplash.com/photo-1601628828688-632f38a5a7d0?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1920&q=80');
      background-size: cover;
      background-position: center;
      background-attachment: fixed;
      padding: 3rem 2rem;
      text-align: center;
      color: white;
      margin-bottom: 2rem;
      border-radius: 20px;
      position: relative;
      overflow: hidden;
    }

    header::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: linear-gradient(45deg, rgba(219, 96, 126, 0.2), rgba(171, 210, 126, 0.2));
      z-index: 1;
    }

    header h1 {
      font-family: 'Playfair Display', serif;
      font-size: 3rem;
      margin-bottom: 1rem;
      color: var(--primary-color);
      position: relative;
      z-index: 2;
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
      animation: fadeInDown 1s ease-out;
    }

    header p {
      font-size: 1.2rem;
      margin-bottom: 2rem;
      position: relative;
      z-index: 2;
      animation: fadeInUp 1s ease-out;
    }

    .nav-links {
      display: flex;
      justify-content: center;
      gap: 1.5rem;
      margin-top: 2rem;
      position: relative;
      z-index: 2;
    }

    .nav-link {
      color: white;
      text-decoration: none;
      padding: 0.8rem 1.5rem;
      border-radius: 30px;
      transition: all var(--transition-speed) ease;
      background: rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(5px);
      border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .nav-link:hover {
      background: rgba(255, 255, 255, 0.2);
      transform: translateY(-2px);
    }

    .restaurant-details {
      background: white;
      padding: 2.5rem;
      border-radius: 20px;
      box-shadow: var(--card-shadow);
      margin-bottom: 2rem;
      display: flex;
      gap: 2.5rem;
      transition: all var(--transition-speed) ease;
    }

    .restaurant-details:hover {
      box-shadow: 0 15px 30px rgba(0, 0, 0, 0.1);
      transform: translateY(-2px);
    }

    .restaurant-image {
      width: 300px;
      height: 300px;
      object-fit: cover;
      border-radius: 15px;
      box-shadow: var(--card-shadow);
      transition: all var(--transition-speed) ease;
    }

    .restaurant-details:hover .restaurant-image {
      transform: scale(1.02);
    }

    .restaurant-info {
      flex: 1;
    }

    .restaurant-info h2 {
      font-family: 'Playfair Display', serif;
      font-size: 2.5rem;
      color: var(--dark-color);
      margin-bottom: 1.5rem;
      position: relative;
    }

    .restaurant-info h2::after {
      content: '';
      position: absolute;
      bottom: -10px;
      left: 0;
      width: 60px;
      height: 3px;
      background: linear-gradient(to right, var(--primary-color), var(--secondary-color));
      border-radius: 2px;
    }

    .info-item {
      margin-bottom: 1rem;
      color: var(--dark-color);
      transition: all var(--transition-speed) ease;
    }

    .info-item:hover {
      transform: translateX(5px);
    }

    .info-item strong {
      color: var(--primary-color);
      font-weight: 600;
      display: inline-block;
      margin-bottom: 0.3rem;
    }

    .info-item p {
      line-height: 1.6;
    }

    .opening-hours {
      margin-top: 1.5rem;
      background: var(--background-color);
      padding: 1.5rem;
      border-radius: 15px;
      transition: all var(--transition-speed) ease;
    }

    .opening-hours:hover {
      transform: translateY(-2px);
      box-shadow: var(--card-shadow);
    }

    .opening-hours strong {
      display: block;
      margin-bottom: 1rem;
      color: var(--primary-color);
      font-size: 1.1rem;
    }

    .opening-hours ul {
      list-style: none;
      margin-top: 0.5rem;
    }

    .opening-hours li {
      margin-bottom: 0.5rem;
      color: var(--dark-color);
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .opening-hours li::before {
      content: '•';
      color: var(--primary-color);
      font-size: 1.2rem;
    }

    .add-item-btn {
      background: linear-gradient(45deg, var(--primary-color), #c44d68);
      color: white;
      padding: 1rem 2rem;
      border: none;
      border-radius: 30px;
      font-size: 1.1rem;
      font-weight: 600;
      cursor: pointer;
      transition: all var(--transition-speed) ease;
      margin-bottom: 2rem;
      display: inline-flex;
      align-items: center;
      gap: 0.8rem;
      box-shadow: var(--card-shadow);
    }

    .add-item-btn:hover {
      transform: translateY(-3px);
      box-shadow: 0 15px 30px rgba(219, 96, 126, 0.2);
    }

    .menu-section {
      background: white;
      padding: 2.5rem;
      border-radius: 20px;
      box-shadow: var(--card-shadow);
      transition: all var(--transition-speed) ease;
    }

    .menu-section:hover {
      box-shadow: 0 15px 30px rgba(0, 0, 0, 0.1);
    }

    .menu-section h2 {
      font-family: 'Playfair Display', serif;
      font-size: 2rem;
      color: var(--dark-color);
      margin-bottom: 2rem;
      position: relative;
    }

    .menu-section h2::after {
      content: '';
      position: absolute;
      bottom: -10px;
      left: 0;
      width: 60px;
      height: 3px;
      background: linear-gradient(to right, var(--primary-color), var(--secondary-color));
      border-radius: 2px;
    }

    .menu-table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      margin-top: 1rem;
    }

    .menu-table th {
      background-color: var(--background-color);
      padding: 1.2rem;
      text-align: left;
      font-weight: 600;
      color: var(--dark-color);
      border-bottom: 2px solid var(--primary-color);
    }

    .menu-table td {
      padding: 1.2rem;
      border-bottom: 1px solid #eee;
      color: var(--dark-color);
      transition: all var(--transition-speed) ease;
    }

    .menu-table tr {
      transition: all var(--transition-speed) ease;
    }

    .menu-table tr:hover {
      background-color: var(--background-color);
      transform: translateY(-2px);
      box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
    }

    .menu-item-image {
      width: 80px;
      height: 80px;
      border-radius: 10px;
      object-fit: cover;
      transition: all var(--transition-speed) ease;
      box-shadow: var(--card-shadow);
    }

    .menu-table tr:hover .menu-item-image {
      transform: scale(1.1);
    }

    .action-buttons {
      display: flex;
      gap: 1rem;
      opacity: 0.7;
      transition: opacity var(--transition-speed) ease;
    }

    .menu-table tr:hover .action-buttons {
      opacity: 1;
    }

    .action-btn {
      background: none;
      border: none;
      cursor: pointer;
      font-size: 1.2rem;
      transition: all var(--transition-speed) ease;
      padding: 0.8rem;
      border-radius: 50%;
      position: relative;
      overflow: hidden;
    }

    .action-btn::before {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      width: 0;
      height: 0;
      background: rgba(0, 0, 0, 0.1);
      border-radius: 50%;
      transform: translate(-50%, -50%);
      transition: width 0.3s ease, height 0.3s ease;
    }

    .action-btn:hover::before {
      width: 100%;
      height: 100%;
    }

    .edit-btn {
      color: var(--primary-color);
    }

    .delete-btn {
      color: var(--accent-color);
    }

    .action-btn:hover {
      transform: translateY(-2px) scale(1.1);
    }

    /* Modal Styles */
    .modal {
      position: fixed;
      inset: 0;
      background-color: rgba(0, 0, 0, 0.7);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 1000;
      backdrop-filter: blur(5px);
      transition: all var(--transition-speed) ease;
      opacity: 0;
    }

    .modal.show {
      display: flex;
      opacity: 1;
      animation: fadeIn 0.3s ease-out;
    }

    .modal-content {
      background: white;
      padding: 2.5rem;
      border-radius: 20px;
      width: 95%;
      max-width: 600px;
      position: relative;
      max-height: 90vh;
      overflow-y: auto;
      box-shadow: var(--card-shadow);
      transform: translateY(20px);
      transition: all var(--transition-speed) ease;
      opacity: 0;
    }

    .modal.show .modal-content {
      transform: translateY(0);
      opacity: 1;
    }

    .modal-header {
      margin-bottom: 2rem;
    }

    .modal-header h2 {
      font-family: 'Playfair Display', serif;
      font-size: 2rem;
      color: var(--dark-color);
      position: relative;
    }

    .modal-header h2::after {
      content: '';
      position: absolute;
      bottom: -10px;
      left: 0;
      width: 60px;
      height: 3px;
      background: linear-gradient(to right, var(--primary-color), var(--secondary-color));
      border-radius: 2px;
    }

    .form-group {
      margin-bottom: 1.5rem;
    }

    .form-group label {
      display: block;
      margin-bottom: 0.8rem;
      color: var(--dark-color);
      font-weight: 500;
      font-size: 1.1rem;
    }

    .form-control {
      width: 100%;
      padding: 1rem 1.2rem;
      border: 2px solid #eee;
      border-radius: 12px;
      font-size: 1rem;
      transition: all var(--transition-speed) ease;
      background: var(--background-color);
    }

    .form-control:focus {
      outline: none;
      border-color: var(--primary-color);
      box-shadow: 0 0 0 3px rgba(219, 96, 126, 0.1);
      transform: translateY(-1px);
    }

    .modal-buttons {
      display: flex;
      gap: 1.5rem;
      margin-top: 2.5rem;
    }

    .modal-btn {
      flex: 1;
      padding: 1rem 2rem;
      border: none;
      border-radius: 30px;
      font-size: 1.1rem;
      font-weight: 600;
      cursor: pointer;
      transition: all var(--transition-speed) ease;
      position: relative;
      overflow: hidden;
    }

    .modal-btn::before {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      width: 0;
      height: 0;
      background: rgba(255, 255, 255, 0.2);
      border-radius: 50%;
      transform: translate(-50%, -50%);
      transition: width 0.3s ease, height 0.3s ease;
    }

    .modal-btn:hover::before {
      width: 300%;
      height: 300%;
    }

    .submit-btn {
      background: linear-gradient(45deg, var(--primary-color), #c44d68);
      color: white;
      box-shadow: var(--card-shadow);
    }

    .cancel-btn {
      background: var(--background-color);
      color: var(--dark-color);
    }

    .modal-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
    }

    .close-modal {
      position: absolute;
      top: 1.5rem;
      right: 1.5rem;
      background: none;
      border: none;
      font-size: 1.8rem;
      color: var(--dark-color);
      cursor: pointer;
      transition: all var(--transition-speed) ease;
      width: 40px;
      height: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      z-index: 2;
    }

    .close-modal:hover {
      background: var(--background-color);
      color: var(--primary-color);
      transform: rotate(90deg);
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
      }

      to {
        opacity: 1;
      }
    }

    @keyframes fadeInDown {
      from {
        opacity: 0;
        transform: translateY(-20px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @media (max-width: 768px) {
      body {
        padding: 1rem;
      }

      header {
        padding: 2rem 1rem;
      }

      header h1 {
        font-size: 2.5rem;
      }

      .restaurant-details {
        flex-direction: column;
        padding: 1.5rem;
      }

      .restaurant-image {
        width: 100%;
        height: 250px;
      }

      .menu-table {
        display: block;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
      }

      .menu-table td,
      .menu-table th {
        padding: 1rem;
        white-space: nowrap;
      }

      .menu-table td:first-child,
      .menu-table th:first-child {
        position: sticky;
        left: 0;
        background: white;
        z-index: 1;
      }

      .modal-content {
        padding: 2rem 1.5rem;
        margin: 1rem;
      }

      .modal-buttons {
        flex-direction: column;
      }

      .modal-btn {
        width: 100%;
      }

      .action-buttons {
        opacity: 1;
      }
    }
  </style>
</head>

<body>
  <div class="container">
    <header>
      <h1>Gourmet d'amour</h1>
      <p>Gestion des Restaurants</p>
      <div class="nav-links">
        <a href="/admin/dashboard" class="nav-link">Tableau de Bord</a>
        <a href="/admin/restaurants" class="nav-link">Restaurants</a>
        <a href="/" class="nav-link">Accueil</a>
      </div>
    </header>

    <!-- Restaurant Details -->
    <div class="restaurant-details">
      <img src="<%= restaurant.imageUrl %>" alt="<%= restaurant.name %>" class="restaurant-image" />
      <div class="restaurant-info">
        <h2>
          <%= restaurant.name %>
        </h2>
        <div class="info-item">
          <strong>Description:</strong>
          <p>
            <%= restaurant.description %>
          </p>
        </div>
        <div class="info-item">
          <strong>Adresse:</strong>
          <p>
            <%= restaurant.address %>
          </p>
        </div>
        <div class="info-item">
          <strong>Type:</strong>
          <p>
            <%= restaurant.type %>
          </p>
        </div>
        <div class="info-item">
          <strong>Téléphone:</strong>
          <p>
            <%= restaurant.phoneNumber %>
          </p>
        </div>
        <div class="info-item">
          <strong>Email:</strong>
          <p>
            <%= restaurant.email %>
          </p>
        </div>
        <div class="info-item">
          <strong>Statut:</strong>
          <p>
            <%= restaurant.isActive ? "Actif" : "Inactif" %>
          </p>
        </div>
        <div class="opening-hours">
          <strong>Heures d'ouverture:</strong>
          <ul>
            <% Object.entries(restaurant.openingHours).forEach(([day, hours])=> {
              const frenchDays = {
              monday: "Lundi",
              tuesday: "Mardi",
              wednesday: "Mercredi",
              thursday: "Jeudi",
              friday: "Vendredi",
              saturday: "Samedi",
              sunday: "Dimanche"
              };
              const frenchDay = frenchDays[day] || day.charAt(0).toUpperCase() + day.slice(1);
              %>
              <li>
                <%= frenchDay %>: <%= hours.open %> - <%= hours.close %>
              </li>
              <% }); %>
          </ul>
        </div>
      </div>
    </div>

    <button onclick="openModal()" class="add-item-btn">
      <i class="fas fa-plus"></i> Ajouter un Article
    </button>

    <!-- Menu Items Section -->
    <div class="menu-section">
      <h2>Articles du Menu</h2>
      <% if (menuItems.length> 0) { %>
        <table class="menu-table">
          <thead>
            <tr>
              <th>Image</th>
              <th>Nom</th>
              <th>Description</th>
              <th>Prix</th>
              <th>Créé le</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% menuItems.forEach((item)=> { %>
              <tr>
                <td>
                  <img src="<%= item.imageUrl %>" alt="<%= item.name %>" class="menu-item-image" />
                </td>
                <td>
                  <%= item.name %>
                </td>
                <td>
                  <%= item.description %>
                </td>
                <td>
                  <%= item.price.toFixed(2) %> Fcfa
                </td>
                <td>
                  <%= item.createdAt %>
                </td>
                <td>
                  <div class="action-buttons">
                    <button class="action-btn edit-btn" onclick="editMenuItem('<%= item.id %>')">
                      <i class="fas fa-edit"></i>
                    </button>
                    <button class="action-btn delete-btn"
                      onclick="confirmDeleteMenuItem('<%= item.id %>', '<%= item.name %>')">
                      <i class="fas fa-trash"></i>
                    </button>
                  </div>
                </td>
              </tr>
              <% }); %>
          </tbody>
        </table>
        <% } else { %>
          <p class="text-gray-500">Aucun article de menu disponible.</p>
          <% } %>
    </div>

    <!-- Add/Edit Menu Item Modal -->
    <div id="menuItemModal" class="modal">
      <div class="modal-content">
        <button class="close-modal" onclick="closeModal()">&times;</button>
        <div class="modal-header">
          <h2>Ajouter un Article</h2>
        </div>
        <form id="menuItemForm" class="space-y-4">
          <div class="form-group">
            <label for="name">Nom</label>
            <input type="text" id="name" name="name" class="form-control" placeholder="Entrer le nom de l'article"
              required />
          </div>
          <div class="form-group">
            <label for="description">Description</label>
            <textarea id="description" name="description" class="form-control"
              placeholder="Entrer la description de l'article" rows="3" required></textarea>
          </div>
          <div class="form-group">
            <label for="price">Prix</label>
            <input type="number" id="price" name="price" step="0.01" class="form-control"
              placeholder="Entrer le prix de l'article" required />
          </div>
          <div class="form-group">
            <label for="category">Catégorie</label>
            <select id="category" name="category" class="form-control" required>
              <!-- Categories will be populated based on restaurant type -->
            </select>
          </div>
          <div class="form-group">
            <label for="image">Image</label>
            <input type="file" id="image" name="image" accept="image/*" class="form-control" required />
          </div>
          <div class="modal-buttons">
            <button type="button" onclick="submitMenuItem()" class="modal-btn submit-btn">
              Ajouter
            </button>
            <button type="button" onclick="closeModal()" class="modal-btn cancel-btn">
              Annuler
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script>
    const restaurantType = "<%= restaurant.type %>";

    function openModal() {
      document.getElementById("menuItemModal").classList.add("show");
      populateCategoriesByType();
    }

    function populateCategoriesByType() {
      const categorySelect = document.getElementById("category");
      categorySelect.innerHTML = ""; // Clear existing options

      const categories = {
        "RESTAURANT": ["PLAT", "FASTFOOD", "GRILLADE"],
        "BOULANGERIE": ["PAINS", "VIENNOISERIES", "PATISSERIE"],
        "EXPRESS": ["EXPRESS", "GOURMET", "DESSERT"]
      };

      // Get the appropriate categories based on restaurant type
      const typeCategories = categories[restaurantType] || ["PLAT", "FASTFOOD", "GRILLADE"];

      // Add options to select dropdown
      typeCategories.forEach(category => {
        const option = document.createElement("option");
        option.value = category;
        option.textContent = category.charAt(0) + category.slice(1).toLowerCase();
        categorySelect.appendChild(option);
      });
    }

    // Close Modal
    function closeModal() {
      document.getElementById("menuItemModal").classList.remove("show");
      document.getElementById("menuItemForm").reset();
      document.getElementById("menuItemForm").removeAttribute("data-mode");
      document.getElementById("menuItemForm").removeAttribute("data-id");
      const modalTitle = document.querySelector("#menuItemModal h2");
      modalTitle.textContent = "Ajouter un Article";
      const submitButton = document.querySelector("#menuItemModal button[onclick='submitMenuItem()']");
      submitButton.textContent = "Ajouter";
    }

    // Edit Menu Item
    async function editMenuItem(id) {
      try {
        console.log("Fetching menu item with ID:", id);

        // Fetch menu item data from server
        const query = `
          query {
            menuItem(id: "${id}") {
              id
              name
              description
              price
              category
              imageUrl
            }
          }
        `;

        console.log("Sending GraphQL query:", query);

        const response = await fetch("/graphql", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ query }),
        });

        const result = await response.json();
        console.log("GraphQL response:", result);

        if (result.errors) {
          console.error("GraphQL errors:", result.errors);
          throw new Error(result.errors[0].message);
        }

        if (!result.data || !result.data.menuItem) {
          console.error("No menu item data returned");
          throw new Error("No menu item data returned from server");
        }

        const menuItem = result.data.menuItem;
        console.log("Menu item data:", menuItem);

        openEditMenuItemModal(menuItem);
      } catch (error) {
        console.error("Error fetching menu item:", error);
        alert("Error loading menu item data. Please try again. Details: " + error.message);
      }
    }

    // Open Edit Menu Item Modal
    function openEditMenuItemModal(menuItem) {
      try {
        // Set form to edit mode
        document.getElementById("menuItemForm").setAttribute("data-mode", "edit");
        document.getElementById("menuItemForm").setAttribute("data-id", menuItem.id);

        // Update modal title and button text
        const modalTitle = document.querySelector("#menuItemModal h2");
        modalTitle.textContent = "Modifier l'Article";

        const submitButton = document.querySelector("#menuItemModal button[onclick='submitMenuItem()']");
        submitButton.textContent = "Mettre à jour";

        // Fill form with menu item data
        document.getElementById("name").value = menuItem.name || "";
        document.getElementById("description").value = menuItem.description || "";
        document.getElementById("price").value = menuItem.price || "";

        // Populate categories first
        populateCategoriesByType();

        // Then set the selected category
        if (menuItem.category) {
          const categorySelect = document.getElementById("category");
          for (let i = 0; i < categorySelect.options.length; i++) {
            if (categorySelect.options[i].value === menuItem.category) {
              categorySelect.selectedIndex = i;
              break;
            }
          }
        }

        // Make image upload not required in edit mode
        document.getElementById("image").removeAttribute("required");

        // Show the modal
        document.getElementById("menuItemModal").classList.add("show");
      } catch (error) {
        console.error("Error in openEditMenuItemModal:", error);
        alert("Error opening edit modal. Please try again.");
      }
    }

    // Confirm Delete Menu Item
    function confirmDeleteMenuItem(id, name) {
      if (confirm(`Êtes-vous sûr de vouloir supprimer l'article "${name}"?`)) {
        deleteMenuItem(id);
      }
    }

    // Delete Menu Item
    async function deleteMenuItem(id) {
      const query = `
        mutation {
          deleteMenuItem(id: "${id}")
        }
      `;

      try {
        const response = await fetch("/graphql", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ query }),
        });

        const result = await response.json();
        if (result.errors) {
          alert("Erreur lors de la suppression de l'article: " + result.errors[0].message);
          return;
        }

        alert("Article supprimé avec succès!");
        window.location.reload();
      } catch (error) {
        console.error("Error:", error);
        alert("Une erreur s'est produite lors de la suppression de l'article. Veuillez réessayer.");
      }
    }

    async function submitMenuItem() {
      const restaurantId = "<%= restaurant.id %>";
      const form = document.getElementById("menuItemForm");
      const formData = new FormData(form);

      // Get form mode (add or edit)
      const mode = form.getAttribute("data-mode") || "add";
      const menuItemId = form.getAttribute("data-id") || "";

      // Extract file input
      const imageFile = formData.get("image");

      // Upload the image to Supabase Storage if a new file was selected
      let imageUrl = "";
      if (imageFile && imageFile.size > 0) {
        try {
          const fileName = `menu-${Date.now()}-${imageFile.name}`;
          const storageUrl = "/storage/upload"; // Replace with your API endpoint or direct Supabase call

          // Prepare the upload request
          const uploadResponse = await fetch(storageUrl, {
            method: "POST",
            body: formData, // Assuming the server-side logic extracts the 'image' field
          });

          const uploadResult = await uploadResponse.json();
          console.log(uploadResponse);
          console.log("uploadResult", uploadResult);

          if (uploadResponse.ok && uploadResult.publicUrl) {
            imageUrl = uploadResult.publicUrl;
            console.log("Image téléchargée avec succès:", imageUrl);
          } else {
            throw new Error("Échec du téléchargement de l'image");
          }
        } catch (error) {
          console.error("Échec du téléchargement de l'image:", error);
          alert("Échec du téléchargement de l'image. Veuillez réessayer.");
          return;
        }
      }

      const input = {
        name: formData.get("name"),
        description: formData.get("description"),
        price: parseFloat(formData.get("price")),
        category: formData.get("category")
      };

      // Add restaurant ID only for new items
      if (mode !== "edit") {
        input.restaurantId = restaurantId;
      }

      // Only include imageUrl if a new image was uploaded
      if (imageUrl) {
        input.imageUrl = imageUrl;
      }

      let query;

      if (mode === "edit") {
        // Update menu item query
        query = `
        mutation {
          updateMenuItem(id: "${menuItemId}", input: {
            name: "${input.name}",
            description: "${input.description}",
            price: ${input.price},
            category: "${input.category}"
                            ${imageUrl ? `, imageUrl: "${imageUrl}"` : ''}
          }) {
            id
            name
          }
        }
        `;
      } else {
        // Create menu item query
        query = `
        mutation {
          addMenuItem(input: {
            name: "${input.name}",
            description: "${input.description}",
            price: ${input.price},
            restaurantId: "${input.restaurantId}",
            category: "${input.category}"
                            ${imageUrl ? `, imageUrl: "${imageUrl}"` : ''}
          }) {
            id
            name
            description
            price
            category
            imageUrl
            createdAt
          }
        }
        `;
      }

      try {
        const response = await fetch("/graphql", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ query }),
        });

        console.log(JSON.stringify({ query }));

        const result = await response.json();
        if (result.errors) {
          alert(`Erreur lors de la ${mode === "edit" ? "modification" : "création"} de l'article: ` + result.errors[0].message);
          return;
        }

        alert(`Article ${mode === "edit" ? "modifié" : "ajouté"} avec succès!`);
        window.location.reload(); // Reload to refresh the menu items
      } catch (error) {
        console.error("Erreur:", error);
        alert("Une erreur s'est produite. Veuillez réessayer.");
      }
    }
  </script>
</body>

</html>