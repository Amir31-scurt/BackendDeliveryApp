<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Politique de Confidentialité & CGU | Gourmet d'amour</title>
    <meta name="description"
        content="Politique de confidentialité et conditions générales d'utilisation de l'application Gourmet d'amour – livraison de repas à Dakar.">
    <link rel="icon" href="/images/logo.png" type="image/png">
    <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Poppins:wght@300;400;500;600&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <style>
        :root {
            --primary:   #DB607E;
            --secondary: #ABD27E;
            --dark:      #2c2c2c;
            --bg:        #f9f5f0;
            --card:      #ffffff;
            --muted:     #888;
            --border:    rgba(219,96,126,0.13);
            --text:      #444;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        html { scroll-behavior: smooth; }

        body {
            font-family: 'Poppins', sans-serif;
            background: var(--bg);
            color: var(--dark);
            line-height: 1.7;
        }

        /* Subtle grid pattern */
        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background-image:
                linear-gradient(rgba(219,96,126,0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(219,96,126,0.03) 1px, transparent 1px);
            background-size: 44px 44px;
            pointer-events: none;
            z-index: 0;
        }

        /* ── Accent bar ── */
        .accent-bar {
            height: 4px;
            background: linear-gradient(to right, var(--primary), var(--secondary), var(--primary));
            background-size: 200% auto;
            animation: barShimmer 4s linear infinite;
            position: fixed;
            top: 0; left: 0; right: 0;
            z-index: 200;
        }
        @keyframes barShimmer {
            from { background-position: 0% center; }
            to   { background-position: 200% center; }
        }

        /* ── Nav ── */
        nav {
            position: fixed;
            top: 4px; left: 0; right: 0;
            z-index: 100;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 16px 48px;
            background: rgba(255,255,255,0.88);
            backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--border);
            box-shadow: 0 2px 20px rgba(0,0,0,0.05);
            transition: padding 0.3s ease;
        }

        .nav-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            font-family: 'Playfair Display', serif;
            font-size: 20px;
            font-weight: 700;
            color: var(--primary);
            transition: transform 0.25s ease;
        }
        .nav-logo:hover { transform: scale(1.04); }
        .nav-logo img { height: 40px; }

        .nav-links {
            display: flex;
            list-style: none;
            gap: 8px;
        }
        .nav-links a {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 8px 16px;
            border-radius: 50px;
            font-size: 0.87rem;
            font-weight: 500;
            color: var(--dark);
            text-decoration: none;
            transition: all 0.25s ease;
            border: 1.5px solid transparent;
        }
        .nav-links a:hover {
            border-color: var(--primary);
            color: var(--primary);
            background: rgba(219,96,126,0.06);
        }
        .nav-links a.active {
            background: linear-gradient(135deg, var(--primary), #e85a7f);
            color: white;
            box-shadow: 0 4px 14px rgba(219,96,126,0.3);
        }

        /* ── Hero banner ── */
        .hero {
            position: relative;
            z-index: 1;
            background: linear-gradient(135deg, var(--dark) 0%, #1a1a1a 100%);
            color: white;
            padding: 140px 48px 80px;
            text-align: center;
            overflow: hidden;
        }
        .hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background:
                radial-gradient(circle at 20% 50%, rgba(219,96,126,0.18) 0%, transparent 50%),
                radial-gradient(circle at 80% 50%, rgba(171,210,126,0.12) 0%, transparent 50%);
        }
        .hero::after {
            content: '';
            position: absolute;
            bottom: 0; left: 0; right: 0;
            height: 60px;
            background: var(--bg);
            clip-path: ellipse(55% 100% at 50% 100%);
        }
        .hero-inner { position: relative; z-index: 1; }

        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(219,96,126,0.18);
            border: 1px solid rgba(219,96,126,0.35);
            color: #f0a0b5;
            padding: 6px 18px;
            border-radius: 50px;
            font-size: 0.8rem;
            font-weight: 600;
            letter-spacing: 0.8px;
            text-transform: uppercase;
            margin-bottom: 22px;
        }

        .hero h1 {
            font-family: 'Playfair Display', serif;
            font-size: 3rem;
            font-weight: 700;
            margin-bottom: 14px;
            background: linear-gradient(135deg, #fff, rgba(255,255,255,0.7));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .hero-meta {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 24px;
            flex-wrap: wrap;
            font-size: 0.85rem;
            color: rgba(255,255,255,0.5);
            margin-top: 16px;
        }
        .hero-meta span { display: flex; align-items: center; gap: 6px; }
        .hero-meta i { color: var(--primary); }

        /* ── Layout ── */
        .layout {
            position: relative;
            z-index: 1;
            max-width: 1100px;
            margin: 0 auto;
            padding: 48px 24px 80px;
            display: grid;
            grid-template-columns: 260px 1fr;
            gap: 36px;
            align-items: start;
        }

        /* ── Sidebar / Table of Contents ── */
        .toc {
            position: sticky;
            top: 90px;
            background: var(--card);
            border-radius: 20px;
            border: 1px solid var(--border);
            box-shadow: 0 4px 20px rgba(0,0,0,0.05);
            padding: 28px 24px;
        }

        .toc-title {
            font-size: 0.72rem;
            font-weight: 700;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 18px;
            padding-bottom: 10px;
            border-bottom: 1px solid var(--border);
        }

        .toc ul { list-style: none; }
        .toc li { margin-bottom: 4px; }

        .toc a {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 12px;
            border-radius: 10px;
            font-size: 0.83rem;
            font-weight: 500;
            color: var(--text);
            text-decoration: none;
            transition: all 0.2s ease;
            border-left: 2px solid transparent;
        }
        .toc a:hover, .toc a.active {
            background: rgba(219,96,126,0.07);
            color: var(--primary);
            border-left-color: var(--primary);
        }
        .toc a i { font-size: 0.75rem; width: 16px; color: var(--primary); opacity: 0.7; }

        .toc-divider {
            height: 1px;
            background: var(--border);
            margin: 14px 0;
        }

        .toc-label {
            font-size: 0.7rem;
            font-weight: 700;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 0.8px;
            padding: 0 12px;
            margin-bottom: 6px;
        }

        .toc-cta {
            margin-top: 20px;
            padding-top: 16px;
            border-top: 1px solid var(--border);
        }

        .toc-cta a {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 11px 16px;
            border-radius: 50px;
            background: linear-gradient(135deg, var(--primary), #e85a7f);
            color: white;
            font-size: 0.83rem;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.25s ease;
            box-shadow: 0 4px 14px rgba(219,96,126,0.3);
        }
        .toc-cta a:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 22px rgba(219,96,126,0.4);
        }

        /* ── Main content ── */
        .content { min-width: 0; }

        /* Section blocks */
        .policy-section {
            background: var(--card);
            border-radius: 24px;
            border: 1px solid var(--border);
            box-shadow: 0 4px 20px rgba(0,0,0,0.04);
            padding: 36px 40px;
            margin-bottom: 24px;
            animation: fadeUp 0.5s ease both;
            scroll-margin-top: 100px;
            transition: box-shadow 0.3s ease;
        }
        .policy-section:hover {
            box-shadow: 0 8px 36px rgba(219,96,126,0.09);
        }
        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(18px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        .policy-section:nth-child(1)  { animation-delay: 0.04s; }
        .policy-section:nth-child(2)  { animation-delay: 0.08s; }
        .policy-section:nth-child(3)  { animation-delay: 0.12s; }
        .policy-section:nth-child(4)  { animation-delay: 0.16s; }
        .policy-section:nth-child(5)  { animation-delay: 0.20s; }
        .policy-section:nth-child(6)  { animation-delay: 0.24s; }
        .policy-section:nth-child(7)  { animation-delay: 0.28s; }
        .policy-section:nth-child(8)  { animation-delay: 0.32s; }
        .policy-section:nth-child(9)  { animation-delay: 0.36s; }
        .policy-section:nth-child(10) { animation-delay: 0.40s; }
        .policy-section:nth-child(11) { animation-delay: 0.44s; }
        .policy-section:nth-child(12) { animation-delay: 0.48s; }
        .policy-section:nth-child(13) { animation-delay: 0.52s; }

        /* Section header row */
        .section-header {
            display: flex;
            align-items: flex-start;
            gap: 16px;
            margin-bottom: 22px;
        }

        .section-icon {
            width: 46px;
            height: 46px;
            flex-shrink: 0;
            border-radius: 14px;
            background: linear-gradient(135deg, rgba(219,96,126,0.12), rgba(171,210,126,0.12));
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            color: var(--primary);
            margin-top: 2px;
        }

        .section-header-text { flex: 1; }

        .section-num {
            font-size: 0.72rem;
            font-weight: 700;
            color: var(--primary);
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 4px;
        }

        h2.section-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.45rem;
            font-weight: 700;
            color: var(--dark);
            border: none;
            display: block;
            margin: 0;
            padding: 0;
        }

        /* Sub-headings */
        h3 {
            font-family: 'Poppins', sans-serif;
            font-size: 0.95rem;
            font-weight: 600;
            color: var(--primary);
            margin: 20px 0 8px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        h3::before {
            content: '';
            display: inline-block;
            width: 4px;
            height: 16px;
            background: linear-gradient(to bottom, var(--primary), var(--secondary));
            border-radius: 2px;
            flex-shrink: 0;
        }

        /* Body text */
        p {
            font-size: 0.93rem;
            color: var(--text);
            line-height: 1.8;
            margin-bottom: 14px;
        }
        p:last-child { margin-bottom: 0; }

        /* Lists */
        ul.fancy-list {
            list-style: none;
            padding: 0;
            margin-bottom: 14px;
        }
        ul.fancy-list li {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            font-size: 0.9rem;
            color: var(--text);
            padding: 7px 0;
            border-bottom: 1px solid rgba(0,0,0,0.04);
        }
        ul.fancy-list li:last-child { border-bottom: none; }
        ul.fancy-list li::before {
            content: '';
            display: block;
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            flex-shrink: 0;
            margin-top: 7px;
        }

        /* Highlight box */
        .highlight-box {
            display: flex;
            align-items: flex-start;
            gap: 14px;
            background: linear-gradient(135deg, rgba(219,96,126,0.06), rgba(171,210,126,0.06));
            border: 1px solid rgba(219,96,126,0.18);
            border-radius: 16px;
            padding: 18px 20px;
            margin: 20px 0;
        }
        .highlight-box i {
            color: var(--primary);
            font-size: 1.1rem;
            margin-top: 2px;
            flex-shrink: 0;
        }
        .highlight-box p {
            margin: 0;
            font-size: 0.9rem;
            font-weight: 500;
            color: var(--dark);
        }

        /* Delete account CTA card */
        .delete-cta {
            background: linear-gradient(135deg, rgba(239,68,68,0.05), rgba(219,96,126,0.07));
            border: 1px solid rgba(239,68,68,0.2);
            border-radius: 16px;
            padding: 22px 24px;
            margin-top: 16px;
            display: flex;
            align-items: center;
            gap: 18px;
            flex-wrap: wrap;
        }
        .delete-cta-icon {
            width: 50px;
            height: 50px;
            border-radius: 14px;
            background: rgba(239,68,68,0.1);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            color: #dc2626;
            flex-shrink: 0;
        }
        .delete-cta-text { flex: 1; min-width: 200px; }
        .delete-cta-text strong { display: block; font-size: 0.95rem; color: var(--dark); margin-bottom: 3px; }
        .delete-cta-text span { font-size: 0.83rem; color: var(--muted); }
        .delete-cta-btn {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 11px 22px;
            border-radius: 50px;
            background: #dc2626;
            color: white;
            font-size: 0.85rem;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.25s ease;
            box-shadow: 0 4px 14px rgba(220,38,38,0.3);
            white-space: nowrap;
        }
        .delete-cta-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 22px rgba(220,38,38,0.4); }

        /* CGU divider banner */
        .cgu-divider {
            background: linear-gradient(135deg, var(--dark), #1a1a1a);
            border-radius: 24px;
            padding: 36px 40px;
            margin-bottom: 24px;
            position: relative;
            overflow: hidden;
            color: white;
        }
        .cgu-divider::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 30% 50%, rgba(219,96,126,0.15), transparent 60%);
        }
        .cgu-divider-inner { position: relative; z-index: 1; }
        .cgu-divider h2 {
            font-family: 'Playfair Display', serif;
            font-size: 1.6rem;
            font-weight: 700;
            color: white;
            margin-bottom: 8px;
            border: none;
            display: block;
        }
        .cgu-divider p { color: rgba(255,255,255,0.55); font-size: 0.88rem; margin: 0; }
        .cgu-divider-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(219,96,126,0.2);
            border: 1px solid rgba(219,96,126,0.3);
            color: #f0a0b5;
            padding: 5px 14px;
            border-radius: 50px;
            font-size: 0.75rem;
            font-weight: 600;
            letter-spacing: 0.6px;
            text-transform: uppercase;
            margin-bottom: 14px;
        }

        /* Contact email link */
        a.email-link {
            color: var(--primary);
            font-weight: 600;
            text-decoration: none;
            border-bottom: 1px dashed rgba(219,96,126,0.4);
            transition: border-color 0.2s ease;
        }
        a.email-link:hover { border-bottom-color: var(--primary); }

        /* ── Footer ── */
        footer {
            position: relative;
            z-index: 1;
            background: var(--dark);
            color: white;
            padding: 60px 48px 32px;
        }

        .footer-content {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 40px;
            max-width: 1100px;
            margin: 0 auto 40px;
        }

        .footer-logo {
            font-family: 'Playfair Display', serif;
            font-size: 1.3rem;
            font-weight: 700;
            color: var(--primary);
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .footer-logo img { height: 36px; }

        .footer-col h4 {
            font-family: 'Playfair Display', serif;
            font-size: 1.05rem;
            color: var(--primary);
            margin-bottom: 18px;
            position: relative;
            padding-bottom: 10px;
        }
        .footer-col h4::after {
            content: '';
            position: absolute;
            bottom: 0; left: 0;
            width: 30px; height: 2px;
            background: var(--primary);
            border-radius: 2px;
        }

        .footer-col p { font-size: 0.85rem; color: rgba(255,255,255,0.5); line-height: 1.7; }

        .footer-col ul { list-style: none; }
        .footer-col ul li { margin-bottom: 10px; }
        .footer-col ul li a {
            font-size: 0.85rem;
            color: rgba(255,255,255,0.55);
            text-decoration: none;
            transition: color 0.2s ease;
            display: inline-flex;
            align-items: center;
            gap: 7px;
        }
        .footer-col ul li a:hover { color: var(--primary); }
        .footer-col ul li span { font-size: 0.85rem; color: rgba(255,255,255,0.55); display: flex; align-items: center; gap: 8px; }
        .footer-col ul li span i { color: var(--primary); }

        .social-row {
            display: flex;
            gap: 10px;
            margin-top: 18px;
        }
        .social-row a {
            width: 38px; height: 38px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.95rem;
            color: white;
            transition: all 0.25s ease;
        }
        .social-row a:hover { transform: translateY(-3px); filter: brightness(1.15); }
        .social-row a.fb  { background: #1877F2; }
        .social-row a.tw  { background: #000; }
        .social-row a.ig  { background: linear-gradient(45deg,#f09433,#e6683c 25%,#dc2743 50%,#cc2366 75%,#bc1888); }
        .social-row a.wa  { background: #25D366; }

        .footer-bottom {
            max-width: 1100px;
            margin: 0 auto;
            padding-top: 24px;
            border-top: 1px solid rgba(255,255,255,0.08);
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
            font-size: 0.8rem;
            color: rgba(255,255,255,0.35);
        }
        .footer-bottom a { color: var(--primary); text-decoration: none; }

        /* ── Back-to-top ── */
        #backToTop {
            position: fixed;
            bottom: 32px;
            right: 28px;
            z-index: 99;
            width: 44px; height: 44px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--primary), #e85a7f);
            color: white;
            border: none;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 6px 20px rgba(219,96,126,0.4);
            transition: all 0.3s ease;
            opacity: 0;
            transform: translateY(20px);
        }
        #backToTop.show { opacity: 1; transform: translateY(0); }
        #backToTop:hover { transform: translateY(-4px); box-shadow: 0 10px 28px rgba(219,96,126,0.5); }

        /* ── Responsive ── */
        @media (max-width: 860px) {
            .layout { grid-template-columns: 1fr; }
            .toc { position: static; display: none; }
        }
        @media (max-width: 600px) {
            nav { padding: 12px 18px; }
            .hero { padding: 120px 20px 70px; }
            .hero h1 { font-size: 2.1rem; }
            .policy-section { padding: 26px 22px; }
            footer { padding: 50px 20px 28px; }
        }
    </style>
</head>

<body>
    <!-- Accent bar -->
    <div class="accent-bar"></div>

    <!-- Nav -->
    <nav id="navbar">
        <a href="/" class="nav-logo">
            <img src="/images/logo.png" alt="Gourmet d'amour">
            Gourmet d'amour
        </a>
        <ul class="nav-links">
            <li><a href="/"><i class="fas fa-home"></i> Accueil</a></li>
            <li><a href="/#app"><i class="fab fa-google-play"></i> Application</a></li>
            <li><a href="/privacy" class="active"><i class="fas fa-shield-alt"></i> Confidentialité</a></li>
            <li><a href="/health"><i class="fas fa-heartbeat"></i> État du service</a></li>
        </ul>
    </nav>

    <!-- Hero -->
    <div class="hero">
        <div class="hero-inner">
            <div class="hero-badge"><i class="fas fa-shield-alt"></i> Document légal</div>
            <h1>Politique de Confidentialité & CGU</h1>
            <div class="hero-meta">
                <span><i class="fas fa-calendar-alt"></i> Dernière mise à jour : Mars 2026</span>
                <span><i class="fas fa-map-marker-alt"></i> Liberté 6, Dakar, Sénégal</span>
                <span><i class="fas fa-language"></i> Français</span>
            </div>
        </div>
    </div>

    <!-- Layout -->
    <div class="layout">

        <!-- Sidebar TOC -->
        <aside class="toc">
            <div class="toc-title"><i class="fas fa-list"></i> Sommaire</div>
            <div class="toc-label">Politique de confidentialité</div>
            <ul>
                <li><a href="#intro"><i class="fas fa-info-circle"></i> Introduction</a></li>
                <li><a href="#data"><i class="fas fa-database"></i> Données collectées</a></li>
                <li><a href="#purposes"><i class="fas fa-bullseye"></i> Finalités</a></li>
                <li><a href="#geo"><i class="fas fa-map-marker-alt"></i> Géolocalisation</a></li>
                <li><a href="#sharing"><i class="fas fa-share-alt"></i> Partage des données</a></li>
